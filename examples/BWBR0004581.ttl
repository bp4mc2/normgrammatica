<jci1.3:c:BWBR0004581&hoofdstuk=VIII&artikel=30&lid=2&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0004581&hoofdstuk=VIII&artikel=28a&z=2026-09-01&g=2026-09-01>;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=VIII&artikel=30&lid=2>;
        schema:position  "2";
        cnt:chars        " De termijn, bedoeld in artikel 28a, vangt aan op het tijdstip waarop de inlevering van het rijbewijs heeft plaatsgevonden. " .

<jci1.3:c:BWBR0004581&hoofdstuk=I&artikel=1&z=2026-09-01&g=2026-09-01>
