        eli:cites        <jci1.3:c:BWBR0001903&titeldeel=IV>;
        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=V&artikel=12a>;
        dct:title        "Artikel 12a.";
        schema:position  "5";
        cnt:chars        "Titel IV van het Vierde Boek van het Wetboek van Strafvordering is van overeenkomstige toepassing." .

