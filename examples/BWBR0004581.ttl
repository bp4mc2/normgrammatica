<jci1.3:c:BWBR0004581&hoofdstuk=V&artikel=10&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=V&artikel=10>;
        dct:title        "Artikel 10.";
        schema:position  "2";
        cnt:chars        "De officier van justitie brengt het beroepschrift en de op de zaak betrekking hebbende stukken ter kennis van de rechtbank van het arrondissement waarin de gedraging is verricht, dan wel bij de rechtbank van het arrondissement waarin de woonplaats van de betrokkene is gelegen." .

<jci1.3:c:BWBR0004581&hoofdstuk=III&artikel=3&lid=3>
        rdf:type              eli:WorkSubdivision;
