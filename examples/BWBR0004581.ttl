        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=VI&artikel=18&lid=2>;
        schema:position  "2";
        cnt:chars        "De officier van justitie verstrekt de advocaat-generaal bij het ressortsparket de nodige inlichtingen." .

