<jci1.3:c:BWBR0004581&hoofdstuk=VI&artikel=15>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Artikel>;
        dct:isPartOf          <jci1.3:c:BWBR0004581&hoofdstuk=VI> .

<jci1.3:c:BWBR0004581&hoofdstuk=III&artikel=3&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0004581&hoofdstuk=II&artikel=2&z=2026-09-01&g=2026-09-01>;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=III&artikel=3&lid=1>;
        schema:position  "1";
        cnt:chars        "Met het toezicht op de naleving van de in artikel 2, eerste lid, bedoelde voorschriften zijn belast de bij algemene maatregel van bestuur aangewezen ambtenaren. " .

<jci1.3:c:BWBR0004581&hoofdstuk=VIII&artikel=28&lid=5&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "5";
        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=VIII&artikel=28&lid=5>;
        schema:position  "5";
        cnt:chars        " Bij algemene maatregel van bestuur worden regels gesteld omtrent de tenuitvoerlegging van de gijzeling als bedoeld in het eerste lid. " .

<jci1.3:c:BWBR0004581&hoofdstuk=X&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=X>;
        dct:title        "Hoofdstuk X. Overige bepalingen ";
        schema:position  "10" .

<jci1.3:c:BWBR0004581&hoofdstuk=VIII&artikel=27&lid=7>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
        dct:isPartOf          <jci1.3:c:BWBR0004581&hoofdstuk=VIII&artikel=27> .

<jci1.3:c:BWBR0004581&hoofdstuk=VI&artikel=14&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=VI&artikel=14&lid=1>;
        schema:position  "1";
        cnt:chars        "Degene die bij de rechtbank beroep heeft ingesteld, alsmede de officier van justitie, kunnen tegen de beslissing van de kantonrechter hoger beroep instellen bij het gerechtshof Arnhem-Leeuwarden, tenzij de opgelegde administratieve sanctie bij die beslissing niet meer bedraagt dan € 110." .

<jci1.3:c:BWBR0004581&hoofdstuk=XI&artikel=43>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Artikel>;
        dct:isPartOf          <jci1.3:c:BWBR0004581&hoofdstuk=XI> .

<jci1.3:c:BWBR0004581&hoofdstuk=X&artikel=34&lid=1&o=a&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0004581&hoofdstuk=III&artikel=3&z=2026-09-01&g=2026-09-01>;
        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=X&artikel=34&lid=1&o=a>;
        schema:position  "1";
        cnt:chars        "hij die niet voldoet aan vordering van een krachtens artikel 3, eerste lid, aangewezen toezichthouder; " .

<jci1.3:c:BWBR0004581&hoofdstuk=IX&artikel=33&lid=3&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=IX&artikel=33&lid=3>;
        schema:position  "3";
        cnt:chars        "Het beroepschrift wordt ingediend bij de officier van justitie in het arrondissement waar de inbewaringstelling is geschied. De officier van justitie brengt het beroepschrift en de op de zaak betrekking hebbende stukken ter kennis van de rechtbank van het arrondissement waar de inbewaringstelling is geschied." .

<jci1.3:c:BWBR0004581&hoofdstuk=VIII&artikel=26&lid=6&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0004581&hoofdstuk=V&artikel=13b&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0004581&hoofdstuk=V&artikel=13a&z=2026-09-01&g=2026-09-01>;
        eli:number       "6";
        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=VIII&artikel=26&lid=6>;
        schema:position  "6";
        cnt:chars        "De griffier brengt het verzetschrift en de daarop betrekking hebbende stukken ter kennis van Onze Minister, ten einde hem in de gelegenheid te stellen daarover de nodige opmerkingen te maken. Onze Minister stelt de betrokken gerechtsdeurwaarder ervan in kennis dat verzet is gedaan. De kantonrechter geeft zo spoedig mogelijk na afloop van deze termijn, na zo nodig degene aan wie de administratieve sanctie is opgelegd te hebben gehoord, althans opgeroepen om te verschijnen, zijn met redenen omklede beschikking, welke onverwijld aan degene die het verzet heeft gedaan en aan Onze Minister wordt medegedeeld. De artikelen 13a en 13b zijn van overeenkomstige toepassing, met uitzondering van artikel 13a, tweede tot en met vierde lid, en de laatste volzin van artikel 13b, eerste lid, en met dien verstande dat hetgeen in die artikelen met betrekking tot de officier van justitie is bepaald, geldt voor Onze Minister." .

<jci1.3:c:BWBR0004581&hoofdstuk=VIII&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=VIII>;
        dct:title        "Hoofdstuk VIII. De inning van de administratieve sanctie ";
        schema:position  "8" .

<jci1.3:c:BWBR0004581&hoofdstuk=V&artikel=12&lid=3>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
        dct:isPartOf          <jci1.3:c:BWBR0004581&hoofdstuk=V&artikel=12> .

<jci1.3:c:BWBR0004581&hoofdstuk=VIII&artikel=30&lid=4>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
        dct:isPartOf          <jci1.3:c:BWBR0004581&hoofdstuk=VIII&artikel=30> .

<jci1.3:c:BWBR0004581&hoofdstuk=V&artikel=11&lid=5&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0028899>;
        eli:number       "5";
        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=V&artikel=11&lid=5>;
        schema:position  "5";
        cnt:chars        " Alle op een beroepschrift betrekking hebbende stukken worden, indien zekerheidstelling heeft plaatsgevonden, nedergelegd ter griffie van de rechtbank. Hiervan wordt door de griffier mededeling gedaan aan degene die het beroep heeft ingesteld. De betrokkene of zijn gemachtigde kan binnen een door de kantonrechter bepaalde en aan hem door de griffier medegedeelde termijn, deze stukken inzien en daarvan afschriften of uittreksels vragen. Op de voor de verstrekking van afschriften en uittreksels aan de betrokkene of zijn gemachtigde in rekening te brengen vergoedingen is het ter zake bepaalde bij of krachtens de Wet griffierechten burgerlijke zaken van overeenkomstige toepassing. " .

<jci1.3:c:BWBR0004581&hoofdstuk=XI>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Hoofdstuk>;
        dct:isPartOf          <jci1.3:c:BWBR0004581> .

<jci1.3:c:BWBR0004581&hoofdstuk=X&artikel=34&lid=1&o=a>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Onderdeel>;
        dct:isPartOf          <jci1.3:c:BWBR0004581&hoofdstuk=X&artikel=34&lid=1> .

<jci1.3:c:BWBR0004581&hoofdstuk=V&artikel=13&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=V&artikel=13&lid=1>;
        schema:position  "1";
        cnt:chars        "Indien de kantonrechter bevindt dat het beroep ontvankelijk is en dat de beslissing van de officier van justitie niet of niet ten volle gehandhaafd kan worden, verklaart de kantonrechter het beroep geheel of gedeeltelijk gegrond en vernietigt of wijzigt het daarbij de bestreden beslissing. " .

<jci1.3:c:BWBR0004581&hoofdstuk=IV&artikel=7&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0005537&artikel=7:26> , <jci1.3:c:BWBR0005537&artikel=7:24> , <jci1.3:c:BWBR0005537&artikel=7:16> , <jci1.3:c:BWBR0005537&artikel=6:14>;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=IV&artikel=7&lid=1>;
        schema:position  "1";
        cnt:chars        "De artikelen 6:14, tweede lid, 7:16, tweede lid, 7:24, tweede en vijfde lid, en 7:26, vierde lid, van de Algemene wet bestuursrecht zijn niet van toepassing." .

<jci1.3:c:BWBR0004581&hoofdstuk=II&artikel=2&lid=6&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "6";
        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=II&artikel=2&lid=6>;
        schema:position  "6";
        cnt:chars        " Een algemene maatregel van bestuur, als bedoeld in het vijfde lid, wordt vastgesteld op voordracht van Onze Minister en Onze Minister van Infrastructuur en Milieu. " .

<jci1.3:c:BWBR0004581&hoofdstuk=I&artikel=1&lid=2>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
        dct:isPartOf          <jci1.3:c:BWBR0004581&hoofdstuk=I&artikel=1> .

<jci1.3:c:BWBR0004581&hoofdstuk=VI&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=VI>;
        dct:title        "Hoofdstuk VI. Hoger beroep bij het gerechtshof Arnhem-Leeuwarden";
        schema:position  "6" .

<jci1.3:c:BWBR0004581&hoofdstuk=VIII&artikel=23&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=VIII&artikel=23&lid=1>;
        schema:position  "1";
        cnt:chars        "Uiterlijk binnen twee weken nadat een beschikking waarbij een administratieve sanctie is opgelegd, onherroepelijk is geworden, moeten de administratieve sanctie en de administratiekosten zijn voldaan. " .

<jci1.3:c:BWBR0004581&hoofdstuk=III>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Hoofdstuk>;
        dct:isPartOf          <jci1.3:c:BWBR0004581> .

