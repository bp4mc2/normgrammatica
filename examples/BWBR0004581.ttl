        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=V&artikel=9&lid=3>;
        schema:position  "3";
        cnt:chars        " Artikel 6, tweede lid, is van overeenkomstige toepassing. " .

<jci1.3:c:BWBR0004581&hoofdstuk=VI&artikel=20c&lid=6&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "6";
        eli:realizes     <jci1.3:c:BWBR0004581&hoofdstuk=VI&artikel=20c&lid=6>;
        schema:position  "6";
        cnt:chars        "Van het verhandelde ter zitting wordt proces-verbaal opgemaakt, hetwelk door de voorzitter en de griffier wordt vastgesteld en ondertekend." .

