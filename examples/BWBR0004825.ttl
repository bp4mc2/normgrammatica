        schema:position  "2";
        cnt:chars        "op het vervoer van personen in de laadruimte van motorvoertuigen ten dienste van politie en brandweer en van andere door Onze Minister aangewezen hulpverleningsdiensten;" .

<jci1.3:c:BWBR0004825&hoofdstuk=I&artikel=1&o=_21&z=2026-07-01&g=2026-07-01>
