        eli:realizes     <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=27&artikel=59&lid=4>;
        schema:position  "4";
        cnt:chars        "Het eerste lid geldt niet voor passagiers die gebruik maken van een rolstoel. Deze passagiers worden vervoerd in een rolstoel die in het voertuig wordt vastgezet op een wijze die de stabiliteit van de rolstoel en de veiligheid van de rolstoelgebruiker waarborgt. Deze passagiers maken gebruik van:" .

<jci1.3:c:BWBR0004825&hoofdstuk=VA&artikel=86a>
        rdf:type              eli:WorkSubdivision;
