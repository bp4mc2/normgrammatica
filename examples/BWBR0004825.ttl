        schema:position  "4";
        cnt:chars        "Voor zover niet ingevolge andere artikelen van dit besluit een lagere maximumsnelheid geldt, gelden voor de volgende voertuigen de volgende bijzondere maximumsnelheden:" .

<jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=10&artikel=24&lid=3&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
