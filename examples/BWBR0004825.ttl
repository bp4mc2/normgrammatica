        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=29>;
        dct:title        "§ 29. Zitplaats kinderen op fietsen en bromfietsen";
        schema:position  "31" .

<jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=31&artikel=61b&lid=2&o=e&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:number       "e.";
        eli:realizes     <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=31&artikel=61b&lid=2&o=e>;
        schema:position  "5";
        cnt:chars        "op het vervoer van personen met een motorrijtuig met een door de constructie bepaalde maximumsnelheid van niet meer dan 45 km per uur, met niet meer dan acht zitplaatsen, de bestuurderszitplaats niet meegerekend, niet zijnde een bromfiets, dat een combinatie vormt met één of meer aanhangwagens die zijn ingericht voor het vervoer van personen indien voor dit vervoer een vergunning door het bevoegd gezag is afgegeven." .

<jci1.3:c:BWBR0004825&hoofdstuk=III&paragraaf=1&artikel=63&z=2026-07-01&g=2026-07-01>
