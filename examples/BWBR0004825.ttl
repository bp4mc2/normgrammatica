        eli:realizes     <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=27&artikel=59a&lid=2>;
        schema:position  "2";
        cnt:chars        "Passagiers van een autobus die in beweging is, wordt meegedeeld dat het verplicht is gebruik te maken van het in het eerste lid genoemde beveiligingsysteem wanneer zij zich op hun zitplaats bevinden en het voertuig deelneemt aan het verkeer. Deze mededeling gebeurt op één of meer van de volgende manieren:" .

<jci1.3:c:BWBR0004825&hoofdstuk=XI&artikel=103>
        rdf:type              eli:WorkSubdivision;
