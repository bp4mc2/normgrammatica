<jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=1&artikel=4&lid=4&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:number       "4";
        eli:realizes     <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=1&artikel=4&lid=4>;
        schema:position  "4";
        cnt:chars        "In afwijking van het eerste en het tweede lid gebruiken personen die zich verplaatsen met behulp van voorwerpen, niet zijnde voertuigen, het fietspad, het fiets/bromfietspad, het trottoir of het voetpad. Zij gebruiken de rijbaan indien een fietspad, een fiets/bromfietspad, een trottoir of een voetpad ontbreekt." .

<jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=9&artikel=23&lid=1&o=e&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
