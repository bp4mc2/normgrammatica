        cnt:chars        "personenauto’s, bedrijfsauto’s en motorfietsen:" .

<jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=15&artikel=41a&lid=2&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
