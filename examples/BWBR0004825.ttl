<jci1.3:c:BWBR0004825&hoofdstuk=V&paragraaf=1&artikel=85&lid=1&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=17&artikel=46&z=2026-07-01&g=2026-07-01> , <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=10&artikel=24&z=2026-07-01&g=2026-07-01> , <jci1.3:c:BWBR0004825&bijlage=1&z=2026-07-01&g=2026-07-01> , <jci1.3:c:BWBR0004825&hoofdstuk=III&paragraaf=1&artikel=62&z=2026-07-01&g=2026-07-01> , <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=10&artikel=25&z=2026-07-01&g=2026-07-01>;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0004825&hoofdstuk=V&paragraaf=1&artikel=85&lid=1>;
        schema:position  "1";
        cnt:chars        "Op bestuurders van een motorvoertuig op meer dan twee wielen waarin op de door Onze Minister voorgeschreven wijze een geldige en behoorlijk leesbare gehandicaptenparkeerkaart is aangebracht, zijn artikel 25 en, indien niet langer wordt geparkeerd dan drie uren, de artikelen 24, eerste lid, onderdeel e, 46 en 62, voor zover het betreft bord E1 van bijlage 1, niet van toepassing." .

