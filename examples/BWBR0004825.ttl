<jci1.3:c:BWBR0004825&hoofdstuk=VIII&artikel=97&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0004825&bijlage=1&z=2026-07-01&g=2026-07-01>;
        eli:realizes     <jci1.3:c:BWBR0004825&hoofdstuk=VIII&artikel=97>;
        dct:title        "Artikel 97.";
        schema:position  "7";
        cnt:chars        "Bewegwijzeringsborden, geplaatst voor 1 november 1991, blijven van kracht totdat zij door in bijlage I vastgestelde borden zijn vervangen." .

<jci1.3:c:BWBR0004825&hoofdstuk=III&paragraaf=3&artikel=73&o=b&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
