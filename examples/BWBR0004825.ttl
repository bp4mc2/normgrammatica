<jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=19&artikel=49&lid=4&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0004825&hoofdstuk=III&paragraaf=3&artikel=74&z=2026-07-01&g=2026-07-01>;
        eli:number       "4";
        eli:realizes     <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=19&artikel=49&lid=4>;
        schema:position  "4";
        cnt:chars        " Het tweede lid geldt evenmin, indien voor de voetgangers en de bestuurders van een gehandicaptenvoertuig een rood voetgangerslicht of een geel knipperlicht als bedoeld in artikel 74, tweede lid, van toepassing is." .

<jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=16&artikel=43&lid=4&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:number       "4";
        eli:realizes     <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=16&artikel=43&lid=4>;
        schema:position  "4";
        cnt:chars        " Op een autosnelweg is het bestuurders van een samenstel van voertuigen met een totale lengte van meer dan 7 meter en van een vrachtauto verboden op een rijbaan met drie of meer rijstroken enig andere dan de twee meest rechts gelegen rijstroken te gebruiken. Het verbod geldt niet voor het geval zij moeten voorsorteren." .

<jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=24&artikel=55>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Artikel>;
        dct:isPartOf          <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=24> .

<jci1.3:c:BWBR0004825&hoofdstuk=VI&paragraaf=2&artikel=88&lid=3&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:cites        <https://data.europe.eu/eli/dir/1991/671/oj>;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0004825&hoofdstuk=VI&paragraaf=2&artikel=88&lid=3>;
        schema:position  "3";
        cnt:chars        "Op de ontheffing wordt het symbool zoals aangeduid in artikel 5 van de richtlijn nr 91/671/EEG van de Raad van de Europese Gemeenschappen van 16 december 1991 inzake de onderlinge aanpassing van de wetgevingen van de Lid-Staten betreffende het verplichte gebruik van veiligheidsgordels in voertuigen van minder dan 3,5 ton (PbEG L 373) aangebracht." .

<jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=26&artikel=58&lid=1&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
