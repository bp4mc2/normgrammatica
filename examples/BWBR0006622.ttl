        eli:number       "d.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=XIII&artikel=186&lid=1&o=d>;
        schema:position  "4";
        cnt:chars        "de eisen ten aanzien van de vakbekwaamheid van bestuurders goederen- en personenvervoer over de weg." .

<jci1.3:c:BWBR0006622&hoofdstuk=1&artikel=1&lid=1&o=e&o=b&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
