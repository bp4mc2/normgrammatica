        schema:position  "2";
        cnt:chars        "Bij ministeriele regeling kunnen ter uitvoering van de richtlijn aanvullende regels worden gesteld." .

<jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=5&artikel=4aq&lid=3&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
