        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VIIA&paragraaf=2&artikel=151h&o=f>;
        schema:position  "6";
        cnt:chars        "de mate waarin en de wijze waarop het CBR in verband met de haar in dit hoofdstuk opgedragen taken toegang heeft tot het in artikel 126 bedoelde register." .

<jci1.3:c:BWBR0006622&hoofdstuk=IA&paragraaf=6&artikel=4q&lid=2&o=d&z=2026-09-01&g=2026-09-01>
