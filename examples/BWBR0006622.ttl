        schema:position  "3";
        cnt:chars        " Het eerste lid geldt bij berechting niet, indien de eigenaar of houder: " .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=3&artikel=111a&lid=1&o=c&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
