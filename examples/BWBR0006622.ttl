        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=X&paragraaf=1&artikel=171&lid=1&o=b>;
        schema:position  "2";
        cnt:chars        "indien het voertuig binnen achtenveertig uur na de inbewaringstelling niet is afgehaald, zo mogelijk binnen een week:" .

