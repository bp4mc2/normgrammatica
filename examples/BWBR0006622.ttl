<jci1.3:c:BWBR0006622&hoofdstuk=IA&paragraaf=2&artikel=4b&lid=1&o=q&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0006622&hoofdstuk=IA&paragraaf=6&artikel=4q&z=2026-09-01&g=2026-09-01>;
        eli:number       "q.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IA&paragraaf=2&artikel=4b&lid=1&o=q>;
        schema:position  "27";
        cnt:chars        "het vaststellen en heffen van een tarief, met inachtneming van artikel 4q, voor overige verstrekkingen of dienstverleningen die voortvloeien uit de vervulling van de aan de Dienst Wegverkeer opgedragen wettelijke taken," .

<jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=4&artikel=4al&o=b&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
