        rdf:type         eli:Expression;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=1&artikel=4&lid=1&o=b>;
        schema:position  "2";
        cnt:chars        "voor militairen te voet, voor zover zij zich ter uitoefening van de dienst op de weg bevinden. " .

<jci1.3:c:BWBR0006622&hoofdstuk=II&paragraaf=1&artikel=12&lid=3&o=c>
