        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IA&paragraaf=6&artikel=4t&lid=1>;
        schema:position  "1";
        cnt:chars        "De directie dient het financiële meerjarenbeleidsplan, waarmee de raad van toezicht heeft ingestemd, voor 1 oktober voorafgaand aan het boekjaar, in bij Onze Minister." .

<jci1.3:c:BWBR0006622&hoofdstuk=IBA&artikel=4aua&lid=2&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
