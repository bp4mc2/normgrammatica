        dct:title        "Afdeling 8a. Registratie van gegevens in verband met de oplegging van een alcoholslotprogramma ";
        schema:position  "9" .

<jci1.3:c:BWBR0006622&hoofdstuk=XI&artikel=182&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=XI&artikel=182&lid=1>;
        schema:position  "1";
        cnt:chars        "Indien een bij of krachtens deze wet als overtreding strafbaar gesteld feit wordt begaan door een bij de ontdekking van het feit onbekend gebleven bestuurder van een motorrijtuig waarmee een aanhangwagen, waarvoor een kenteken is vereist, wordt voortbewogen, kunnen de op het feit gestelde straffen worden opgelegd aan de eigenaar of houder van die aanhangwagen. " .

<jci1.3:c:BWBR0006622&hoofdstuk=IA&paragraaf=3&artikel=4l&lid=6>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
        dct:isPartOf          <jci1.3:c:BWBR0006622&hoofdstuk=IA&paragraaf=3&artikel=4l> .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=7&artikel=125&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=7&artikel=125>;
        dct:title        "Artikel 125.";
        schema:position  "6" .

<jci1.3:c:BWBR0006622&hoofdstuk=X&paragraaf=1&artikel=172&lid=5&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "5";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=X&paragraaf=1&artikel=172&lid=5>;
        schema:position  "5";
        cnt:chars        "Indien de kosten, verbonden aan de oplegging van een last onder bestuursdwang, die door de rechthebbende zijn betaald, te hoog zijn berekend, betalen burgemeester en wethouders het te veel betaalde terug." .

<jci1.3:c:BWBR0006622&hoofdstuk=XI&artikel=179&lid=6>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
