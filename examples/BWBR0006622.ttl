        eli:number       "h.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=2&artikel=4aa&lid=1&o=h>;
        schema:position  "8";
        cnt:chars        "het verlenen van ontheffingen als bedoeld in artikel 149, tweede lid;" .

