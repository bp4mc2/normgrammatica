        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=XI&artikel=178&lid=1>;
        schema:position  "1";
        cnt:chars        "De in de artikelen 175 en 176 strafbaar gestelde feiten zijn misdrijven. " .

