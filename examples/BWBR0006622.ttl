<jci1.3:c:BWBR0006622&hoofdstuk=V&paragraaf=3&artikel=80&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       " 1";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=V&paragraaf=3&artikel=80&lid=1>;
        schema:position  "1";
        cnt:chars        " De Dienst Wegverkeer of de erkenninghouder geeft voor keuringsbewijzen die versleten of geheel of ten dele onleesbaar zijn, dan wel verloren zijn geraakt of teniet zijn gegaan, op aanvraag en tegen betaling, op de door deze dienst vastgestelde wijze, van het daarvoor door deze dienst vastgestelde tarief vervangende keuringsbewijzen af." .

