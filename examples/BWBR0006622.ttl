        schema:position  "1";
        cnt:chars        " De Dienst Wegverkeer is belast met de volgende taken:" .

<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=4b&artikel=53&o=a&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
