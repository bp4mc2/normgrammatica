<jci1.3:c:BWBR0006622&hoofdstuk=1&artikel=2&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=1&artikel=2&lid=1>;
        schema:position  "1";
        cnt:chars        "De krachtens deze wet vastgestelde regels kunnen strekken tot: " .

<jci1.3:c:BWBR0006622&hoofdstuk=VII&artikel=151&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0006622&hoofdstuk=VII&artikel=149a&z=2026-09-01&g=2026-09-01>;
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VII&artikel=151>;
        dct:title        "Artikel 151.";
        schema:position  "11";
        cnt:chars        "Onverminderd artikel 149a kunnen bij algemene maatregel van bestuur regels worden vastgesteld omtrent het ten laste van de aanvrager van een ontheffing brengen van de aan de behandeling van de aanvraag verbonden kosten." .

<jci1.3:c:BWBR0006622&hoofdstuk=II&paragraaf=1&artikel=9&lid=9>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
        dct:isPartOf          <jci1.3:c:BWBR0006622&hoofdstuk=II&paragraaf=1&artikel=9> .

<jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=1&artikel=26&lid=2&o=b&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=1&artikel=26&lid=2&o=b>;
        schema:position  "2";
        cnt:chars        "het voertuig of systeem, onderdeel, technische eenheid, voertuigdeel, uitrustingsstuk of voorziening voor een voertuig of aanhangwagen daarvan of de voorzieningen ter bescherming van inzittenden of kwetsbare weggebruikers waarvoor de goedkeuring is verleend, desalniettemin een ernstig gevaar vormt voor de gezondheid, de veiligheid, het milieu of andere aspecten van de bescherming van het openbaar belang;" .

<jci1.3:c:BWBR0006622&hoofdstuk=IX&artikel=160&lid=1&o=b&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IX&artikel=160&lid=1&o=b>;
        schema:position  "2";
        cnt:chars        "het rijbewijs dan wel het hem door het daartoe bevoegde gezag buiten Nederland afgegeven rijbewijs en, indien hem buiten Nederland een internationaal rijbewijs is afgegeven, dat bewijs; " .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=7&artikel=124&lid=2&o=d&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "d.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=7&artikel=124&lid=2&o=d>;
        schema:position  "4";
        cnt:chars        "in het in het eerste lid, onderdeel c, bedoelde geval" .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=3&artikel=111a&lid=4&o=c&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "c.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=3&artikel=111a&lid=4&o=c>;
        schema:position  "3";
        cnt:chars        "door wijziging van de geslachtsnaam, de voornamen of de plaats of datum van geboorte van één van de daarop vermelde personen;" .

<jci1.3:c:BWBR0006622&hoofdstuk=VIIA&paragraaf=3&artikel=151id&lid=1>
        rdf:type              eli:WorkSubdivision;
