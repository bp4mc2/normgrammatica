<jci1.3:c:BWBR0006622&hoofdstuk=XI&artikel=180&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0001903&artikel=6:1:16>;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=XI&artikel=180&lid=1>;
        schema:position  "1";
        cnt:chars        "Voor wat betreft de bijkomende straf van ontzegging van de bevoegdheid tot het besturen van motorrijtuigen is artikel 6:1:16, derde lid, van het Wetboek van Strafvordering op rechterlijke uitspraken niet van toepassing. Een strafbeschikking houdende deze bijkomende straf is in zoverre eerst voor tenuitvoerlegging vatbaar als geen verzet meer kan worden gedaan." .

