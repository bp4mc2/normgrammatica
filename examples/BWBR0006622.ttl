        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=3&artikel=111a&lid=7>;
        schema:position  "7";
        cnt:chars        "De begeleiderspas dient:" .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=8&artikel=126&lid=3&o=g&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=9&paragraaf=1&artikel=130&z=2026-09-01&g=2026-09-01>;
        eli:number       "g.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=8&artikel=126&lid=3&o=g>;
        schema:position  "7";
        cnt:chars        "besluiten, genomen in het kader van de procedure op grond van de artikelen 130 tot en met 134;" .

<jci1.3:c:BWBR0006622&hoofdstuk=VII&artikel=149aa&lid=3&o=b&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VII&artikel=149aa&lid=3&o=b>;
        schema:position  "2";
        cnt:chars        "overige wetten voor zover het bepalingen betreft die betrekking hebben op door de bestuurder of kentekenhouder van het motorrijtuig uit te voeren taken," .

<jci1.3:c:BWBR0006622&hoofdstuk=IBA&artikel=4auh&lid=1>
