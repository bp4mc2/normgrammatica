        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=V&paragraaf=2&artikel=73&lid=2&o=b>;
        schema:position  "2";
        cnt:chars        "artikel 72 niet geldt voor nader aangewezen groepen van motorrijtuigen of aanhangwagens. Hieronder vallen in ieder geval aanhangwagens met een toegestane maximum massa van niet meer dan 3500 kg; " .

<jci1.3:c:BWBR0006622&hoofdstuk=1&artikel=2&lid=3&z=2026-09-01&g=2026-09-01>
