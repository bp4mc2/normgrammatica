<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=5&artikel=120&lid=3&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=5&artikel=120&lid=3>;
        schema:position  "3";
        cnt:chars        "Indien de houder van een verloren geraakt rijbewijs waarvoor een vervangend rijbewijs is afgegeven, na de afgifte van het vervangende rijbewijs weer in het bezit komt van dat verloren geraakte rijbewijs, dient hij dat rijbewijs in te leveren bij degene die het vervangende rijbewijs heeft afgegeven." .

