        schema:position  "3";
        cnt:chars        "De Dienst Wegverkeer kan verlangen dat een kentekenbewijs dat zijn geldigheid heeft verloren binnen een daarbij bepaalde termijn bij deze dienst wordt ingeleverd." .

<jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=5&artikel=4ar&lid=2&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
