        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=2&artikel=30a&z=2026-09-01&g=2026-09-01> , <https://data.europe.eu/eli/reg/2920/2019/oj> , <jci1.3:c:BWBR0006622&hoofdstuk=IIIA&artikel=35&z=2026-09-01&g=2026-09-01> , <https://data.europe.eu/eli/reg/2640/2020/oj> , <jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=1&artikel=27&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=1&artikel=25&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=IIIA&artikel=34&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=IX&artikel=158&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=2&artikel=30&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=2&artikel=29a&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=IIIA&artikel=34a&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=2&artikel=29&z=2026-09-01&g=2026-09-01>;
