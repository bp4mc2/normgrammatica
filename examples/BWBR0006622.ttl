        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=2&artikel=4aa&lid=1&o=s>;
        schema:position  "19";
        cnt:chars        "het informeren van rijscholen over relevante ontwikkelingen voor hun taakuitvoering." .

<jci1.3:c:BWBR0006622&hoofdstuk=V&paragraaf=5&artikel=86a&lid=2&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0006622&hoofdstuk=V&paragraaf=2&artikel=72&z=2026-09-01&g=2026-09-01>;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=V&paragraaf=5&artikel=86a&lid=2>;
        schema:position  "2";
        cnt:chars        "Bij ministeriële regeling kunnen regels worden vastgesteld betreffende de wijze waarop de keuring wordt uitgevoerd. Deze regels kunnen inhouden dat verscherpt toezicht wordt gehouden indien blijkt dat er door een natuurlijke persoon die daartoe niet bevoegd is motorrijtuigen en aanhangwagens, waarvoor artikel 72 geldt, met uitzondering van bussen als bedoeld in de Wet personenvervoer, aan een keuring worden onderworpen." .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=9&paragraaf=6&artikel=134&lid=8>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
        dct:isPartOf          <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=9&paragraaf=6&artikel=134> .

<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=4a&artikel=48&lid=1&o=b>
