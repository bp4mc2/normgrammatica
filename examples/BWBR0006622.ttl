        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=3&artikel=4ae&lid=2>;
        schema:position  "2";
        cnt:chars        "Alle bevoegdheden van het CBR die niet bij of krachtens deze wet aan de raad van toezicht zijn opgedragen, komen toe aan de directie." .

