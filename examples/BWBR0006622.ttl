        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=3&artikel=46&lid=2>;
        schema:position  "2";
        cnt:chars        " Bij ministeriële regeling worden nadere regels vastgesteld ter uitvoering van het eerste lid. " .

<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=4b&artikel=55&lid=1&o=b&z=2026-09-01&g=2026-09-01>
