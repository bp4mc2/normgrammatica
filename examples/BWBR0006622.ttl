<jci1.3:c:BWBR0006622&hoofdstuk=IA&paragraaf=3&artikel=4k&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IA&paragraaf=3&artikel=4k&lid=1>;
        schema:position  "1";
        cnt:chars        "De voorzitter en de overige leden van de raad van toezicht worden benoemd voor een tijdvak van vier jaren en zijn aansluitend éénmalig voor een tijdvak van vier jaren herbenoembaar." .

<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=2&artikel=41&lid=2&o=b>
