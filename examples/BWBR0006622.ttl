<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=7&artikel=124&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=9&paragraaf=6&artikel=134&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=9&paragraaf=1&artikel=132&z=2026-09-01&g=2026-09-01>;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=7&artikel=124&lid=1>;
        schema:position  "1";
        cnt:chars        "Onverminderd de artikelen 132, tweede lid, en 134, vierde lid, wordt een rijbewijs overeenkomstig bij algemene maatregel van bestuur vastgestelde regels voor een of meer categorieën van motorrijtuigen of voor een deel van de geldigheidsduur ongeldig verklaard indien: " .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=1&artikel=108&lid=1&o=h&o=2>
        rdf:type              eli:WorkSubdivision;
