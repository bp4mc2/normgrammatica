        eli:cites        <jci1.3:c:BWBR0005537&artikel=5:20> , <jci1.3:c:BWBR0006622&hoofdstuk=IBA&artikel=4aui&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=IBA&artikel=4aue&z=2026-09-01&g=2026-09-01>;
