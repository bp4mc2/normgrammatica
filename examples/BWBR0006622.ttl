        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IA&paragraaf=6&artikel=4q&lid=1>;
        schema:position  "1";
        cnt:chars        "De hoogte van de tarieven, bedoeld in artikel 4b, eerste lid, onderdeel n, dient te worden gerelateerd aan de met de uitoefening van de taak gemoeide kosten. " .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=7&artikel=123>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Artikel>;
