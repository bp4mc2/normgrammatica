        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=4&artikel=4ap&lid=1>;
        schema:position  "1";
        cnt:chars        "De directie dient het financiële meerjarenbeleidsplan, waarmee de raad van toezicht heeft ingestemd, voor 1 oktober voorafgaande aan het boekjaar, in bij Onze Minister." .

<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=6&artikel=67&lid=4&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
