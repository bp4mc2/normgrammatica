<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=5&artikel=118a&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=5&artikel=118a>;
        dct:title        "Artikel 118a.";
        schema:position  "4";
        cnt:chars        "Als datum van afgifte wordt in het rijbewijs en in het rijbewijzenregister vermeld de datum waarop het besluit tot afgifte is genomen." .

<jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=3&artikel=4ah&lid=5&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "5";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=3&artikel=4ah&lid=5>;
        schema:position  "5";
        cnt:chars        "De raad van toezicht verschaft Onze Minister alle verlangde inlichtingen, met inachtneming van het door Onze Minister vastgestelde informatiestatuut." .

<jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=3&artikel=4aj&lid=2&o=b&z=2026-09-01&g=2026-09-01>
