        schema:position  "1";
        cnt:chars        "het alcoholgehalte in zijn adem bij een onderzoek hoger blijkt te zijn dan 220 microgram alcohol per liter uitgeademde lucht, dan wel " .

<jci1.3:c:BWBR0006622&hoofdstuk=IA&paragraaf=6&artikel=4q&lid=2&o=k&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
