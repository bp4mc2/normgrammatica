        schema:position  "3";
        cnt:chars        "de opleiding van verkeersbrigadiers;" .

<jci1.3:c:BWBR0006622&hoofdstuk=XI&artikel=175&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=XI&artikel=175>;
