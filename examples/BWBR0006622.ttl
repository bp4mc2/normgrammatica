<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=5&artikel=119&lid=4&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "4";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=5&artikel=119&lid=4>;
        schema:position  "4";
        cnt:chars        "Indien de houder van een verloren geraakt rijbewijs waarvoor een nieuw rijbewijs is afgegeven, na de afgifte van het nieuwe rijbewijs weer in het bezit komt van dat verloren geraakte rijbewijs, dient hij dat rijbewijs in te leveren bij degene die het nieuwe rijbewijs heeft afgegeven." .

<jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=1&artikel=21&lid=3&o=a&z=2026-09-01&g=2026-09-01>
