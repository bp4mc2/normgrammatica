<jci1.3:c:BWBR0006622&hoofdstuk=IVB&artikel=70n&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IVB&artikel=70n&lid=1>;
        schema:position  "1";
        cnt:chars        "Door de Dienst Wegverkeer erkende bedrijven verstrekken in bij algemene maatregel van bestuur te bepalen gevallen aan de Dienst Wegverkeer de tellerstand van een motorrijtuig dat dient te zijn ingeschreven en tenaamgesteld." .

