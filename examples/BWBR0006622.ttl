<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=7&artikel=125&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=7&artikel=125&lid=1>;
        schema:position  "1";
        cnt:chars        "Indien het rijbewijs niet voor alle categorieën waarvoor het is afgegeven, ongeldig is verklaard dan wel indien de ongeldigverklaring betrekking heeft op een deel van de geldigheidsduur, wordt door degene die is belast met de afgifte van rijbewijzen een nieuw rijbewijs afgegeven dat geldig is voor de categorie of categorieën of voor dat deel van de geldigheidsduur waarop de ongeldigverklaring geen betrekking heeft. " .

<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=4a&artikel=51a&lid=3&o=e&z=2026-09-01&g=2026-09-01>
