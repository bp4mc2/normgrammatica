        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IX&artikel=162&lid=2>;
        schema:position  "2";
        cnt:chars        " De opsporingsambtenaar die een rijverbod oplegt, legt dit vast in een beschikking die het tijdstip van ingang en de duur van het verbod bevat. " .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=8a&z=2026-09-01&g=2026-09-01>
