        schema:position  "11";
        cnt:chars        "het uitvoeren van de op grond van artikel 4b, eerste lid, onderdeel r, opgedragen taken," .

<jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=3&artikel=4ag&lid=2&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
