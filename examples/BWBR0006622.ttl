        eli:cites        <jci1.3:c:BWBR0047082> , <jci1.3:c:BWBR0037517> , <jci1.3:c:BWBR0045586> , <jci1.3:c:BWBR0002415> , <jci1.3:c:BWBR0005806> , <jci1.3:c:BWBR0006324>;
