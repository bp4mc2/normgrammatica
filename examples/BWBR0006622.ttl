        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=9&paragraaf=6&artikel=133&lid=6>;
        schema:position  "6";
        cnt:chars        "Het onderzoek vangt zo spoedig mogelijk aan." .

