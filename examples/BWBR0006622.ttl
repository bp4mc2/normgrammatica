<jci1.3:c:BWBR0006622&hoofdstuk=V&paragraaf=6&artikel=90&lid=6&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0006622&hoofdstuk=V&paragraaf=3&artikel=75&z=2026-09-01&g=2026-09-01>;
        eli:number       " 6";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=V&paragraaf=6&artikel=90&lid=6>;
        schema:position  "6";
        cnt:chars        " Indien het voertuig volgens het oordeel van de deskundige voldoet aan de in artikel 75 bedoelde eisen, geeft de Dienst Wegverkeer alsnog het aangevraagde keuringsbewijs af en wordt het in het vierde lid bedoelde bedrag terugbetaald aan de indiener van het bezwaar- of beroepschrift. Is in dit geval de beschikking tot weigering van de afgifte van een keuringsbewijs gegeven door een erkende natuurlijke persoon of rechtspersoon, dan is deze vorenbedoeld bedrag verschuldigd aan de Dienst Wegverkeer en gehouden dit te betalen op de door deze dienst vastgestelde wijze." .

