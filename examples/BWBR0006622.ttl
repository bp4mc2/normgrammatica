<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=3&artikel=111&lid=7&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0048156&artikel=27>;
        eli:number       "7";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=3&artikel=111&lid=7>;
        schema:position  "7";
        cnt:chars        "Aan de houder van een publiek identificatiemiddel op een rijbewijs dat is uitgegeven voor inwerkingtreding van artikel 27 van de Wet digitale overheid en dat geactiveerd wordt na inwerkingtreding daarvan, wordt een bij ministeriële regeling te bepalen tarief in rekening gebracht." .

