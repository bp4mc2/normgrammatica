<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=3&artikel=43&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0040940&paragraaf=3.2>;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=3&artikel=43&lid=1>;
        schema:position  "1";
        cnt:chars        "Aan overheidsorganen worden door de Dienst Wegverkeer uit het kentekenregister gegevens, waaronder mede begrepen persoonsgegevens en persoonsgegevens van strafrechtelijke aard als bedoeld in paragraaf 3.2 van de Uitvoeringswet Algemene verordening gegevensbescherming, verstrekt voor zover zij aangeven die gegevens nodig te hebben voor de uitoefening van hun publieke taak." .

<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=4b&artikel=54&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=4b&artikel=54>;
        dct:title        "Artikel 54.";
        schema:position  "6";
        cnt:chars        "Onze Minister kan aan besturen van verenigingen met volledige rechtsbevoegdheid, die behartiging van verkeersbelangen ten doel hebben, de bevoegdheid verlenen tot het afgeven van internationale bewijzen voor motorrijtuigen en aanhangwagens, bedoeld in internationale overeenkomsten, ten behoeve van het verkeer met motorrijtuigen en aanhangwagens in het buitenland. " .

<jci1.3:c:BWBR0006622&hoofdstuk=VIIA&paragraaf=3&artikel=151ic&lid=2&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VIIA&paragraaf=3&artikel=151ic&lid=2>;
        schema:position  "2";
        cnt:chars        "De nieuwe kwalificatiekaart bestuurder wordt niet afgegeven dan nadat de eerder afgegeven kwalificatiekaart bestuurder is ingeleverd bij de Dienst Wegverkeer." .

<jci1.3:c:BWBR0006622&hoofdstuk=1&artikel=1&lid=1&o=h&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=1&artikel=37&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=1&artikel=36&z=2026-09-01&g=2026-09-01>;
        eli:number       "h.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=1&artikel=1&lid=1&o=h>;
        schema:position  "19";
        cnt:chars        "kentekenbewijs: kentekenbewijs als bedoeld in artikel 36 dan wel een kentekenbewijs, afgegeven ter zake van de opgave van een kenteken als bedoeld in artikel 37, derde lid;" .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=9&paragraaf=6&artikel=134&lid=4>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
        dct:isPartOf          <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=9&paragraaf=6&artikel=134> .

