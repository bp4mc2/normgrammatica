<jci1.3:c:BWBR0006622&hoofdstuk=V&paragraaf=6&artikel=90&lid=4&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0005537&artikel=7:28> , <jci1.3:c:BWBR0005537&artikel=7:15>;
        eli:number       "4";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=V&paragraaf=6&artikel=90&lid=4>;
        schema:position  "4";
        cnt:chars        " In afwijking van de artikelen 7:15 en 7:28 van de Algemene wet bestuursrecht dient bij de indiening van het bezwaar- of beroepschrift een bedrag ter vergoeding van de aan de herkeuring verbonden kosten te worden betaald. De hoogte van het bedrag en de wijze van betaling worden vastgesteld door de Dienst Wegverkeer." .

