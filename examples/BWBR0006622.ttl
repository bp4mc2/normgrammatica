<jci1.3:c:BWBR0006622&hoofdstuk=VIIA&paragraaf=3&artikel=151ii&lid=1&o=b&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "b.";
