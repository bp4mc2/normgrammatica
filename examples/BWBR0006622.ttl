        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=3&artikel=4ag&lid=2>;
        schema:position  "2";
        cnt:chars        "De directe legt jaarlijks, en voorts tussentijds indien hiertoe naar het oordeel van de raad van toezicht aanleiding bestaat, aan de raad van toezicht verantwoording af over het door haar gevoerde beleid." .

<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=4a&artikel=48&lid=4&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=2&artikel=38&z=2026-09-01&g=2026-09-01>;
