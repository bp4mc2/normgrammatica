        eli:number       "3°.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=7&artikel=123b&lid=1&o=a&o=3>;
        schema:position  "3";
        cnt:chars        "artikel 8, vijfde lid, dan wel voor zover de schuldige na het feit niet heeft voldaan aan een bevel, gegeven krachtens artikel 163, zesde of zevende lid;" .

