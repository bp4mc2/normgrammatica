<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=7&artikel=70j&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=7&artikel=70i&z=2026-09-01&g=2026-09-01>;
