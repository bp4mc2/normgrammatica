        rdf:type         eli:Expression;
        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=3&artikel=42a&lid=1&o=a>;
        schema:position  "1";
        cnt:chars        "authentieke en niet-authentieke gegevens;" .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=7&artikel=123&lid=1&o=a&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=7&artikel=123&lid=1&o=a>;
        schema:position  "1";
        cnt:chars        "door uitreiking van een nieuw of vervangend rijbewijs;" .

<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=7&artikel=70i&lid=3&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=7&artikel=70i&lid=3>;
        schema:position  "3";
        cnt:chars        "In geval van uitvoer naar het buitenland anders dan door een erkenninghouder als bedoeld in het eerste lid, onderdeel a of b, is de eigenaar of houder van het motorrijtuig of de aanhangwagen verplicht tot inlevering van de betrokken kentekenplaten bij de Dienst Wegverkeer tegelijk met de uitvoer." .

<jci1.3:c:BWBR0006622&hoofdstuk=XI&artikel=179&lid=9&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "9";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=XI&artikel=179&lid=9>;
        schema:position  "9";
        cnt:chars        "Voor de toepassing van dit artikel wordt een strafbeschikking met een veroordeling gelijkgesteld." .

<jci1.3:c:BWBR0006622&hoofdstuk=II&paragraaf=3&artikel=20a&lid=2&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=II&paragraaf=3&artikel=20a&lid=2>;
        schema:position  "2";
        cnt:chars        " Bij algemene maatregel van bestuur worden nadere regels inzake de vaststelling van bebouwde kommen vastgesteld. " .

<jci1.3:c:BWBR0006622&hoofdstuk=II>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Hoofdstuk>;
