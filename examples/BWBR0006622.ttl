        eli:number       "e.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IBA&artikel=4auh&lid=1&o=e>;
        schema:position  "5";
        cnt:chars        "indien de erkenninghouder geen erkenning voor specifieke handelingen meer heeft." .

<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=1&artikel=36&lid=3&o=a&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
