<jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=2&artikel=30&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=2&artikel=30&lid=1>;
        schema:position  "1";
        cnt:chars        "Het is marktdeelnemers verboden voertuigen en systemen, onderdelen, technische eenheden, voertuigdelen, uitrustingsstukken en voorzieningen voor dergelijke voertuigen en aanhangwagens daarvan waarvoor een nationale typegoedkeuring, -individuele goedkeuring of VN/ECE-goedkeuring is vereist, of voorzieningen ter bescherming van inzittenden van voertuigen en kwetsbare weggebruikers waarvoor een VN/ECE-goedkeuring is vereist op de markt aan te bieden of in de handel te brengen:" .

<jci1.3:c:BWBR0006622&hoofdstuk=IA&paragraaf=7&artikel=4u&lid=2>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
