        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VIIA&paragraaf=2&artikel=151g&lid=8>;
        schema:position  "8";
        cnt:chars        "Een in het vierde lid bedoeld getuigschrift wordt afgegeven en geregistreerd in het in artikel 126 bedoelde register door het CBR en uitgereikt door de Dienst Wegverkeer." .

<jci1.3:c:BWBR0006622&hoofdstuk=II&paragraaf=1&artikel=8&lid=3&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=II&paragraaf=1&artikel=8&lid=3>;
        schema:position  "3";
        cnt:chars        "In afwijking van het tweede lid is het de bestuurder van een motorrijtuig voor het besturen waarvan een rijbewijs is vereist, verboden dat motorrijtuig te besturen of als bestuurder te doen besturen na zodanig gebruik van alcoholhoudende drank, dat:" .

<jci1.3:c:BWBR0006622&hoofdstuk=IIA&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IIA>;
        dct:title        "Hoofdstuk IIA. Aanwijzing bromfietsen waarvoor geen Europese typegoedkeuring vereist is";
        schema:position  "8" .

