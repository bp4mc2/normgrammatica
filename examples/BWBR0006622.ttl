<jci1.3:c:BWBR0006622&hoofdstuk=XIII&artikel=186&lid=2&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=XIII&artikel=186&lid=2>;
        schema:position  "2";
        cnt:chars        "In de in het eerste lid bedoelde algemene maatregel van bestuur wordt in elk geval bepaald:" .

<jci1.3:c:BWBR0006622&hoofdstuk=aIA&artikel=a4c&lid=2&o=d&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "d.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=aIA&artikel=a4c&lid=2&o=d>;
        schema:position  "4";
        cnt:chars        "het door een beheerder van een weg op te stellen verslag na elk dodelijk ongeval op een in onderdeel a bedoelde in gebruik zijnde weg." .

