<jci1.3:c:BWBR0006622&hoofdstuk=II&paragraaf=1&artikel=7&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=II&paragraaf=1&artikel=7&lid=1>;
        schema:position  "1";
        cnt:chars        "Het is degene die bij een verkeersongeval is betrokken of door wiens gedraging een verkeersongeval is veroorzaakt, verboden de plaats van het ongeval te verlaten indien: " .

