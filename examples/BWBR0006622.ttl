        dct:isPartOf          <jci1.3:c:BWBR0006622&hoofdstuk=II&paragraaf=1&artikel=10> .

<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=4b&artikel=55&lid=3&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=4b&artikel=55&lid=3>;
        schema:position  "3";
        cnt:chars        "Op aanvraag en tegen betaling, op de door de Dienst Wegverkeer vastgestelde wijze, van het daarvoor door deze dienst vastgestelde tarief, verstrekt deze dienst overeenkomstig bij algemene maatregel van bestuur vastgestelde regels een vervangende tenaamstellingscode ten behoeve van een wijziging van de tenaamstelling." .

<jci1.3:c:BWBR0006622&hoofdstuk=IBA&artikel=4aud&lid=1>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
        dct:isPartOf          <jci1.3:c:BWBR0006622&hoofdstuk=IBA&artikel=4aud> .

