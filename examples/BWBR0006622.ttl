        schema:position  "2";
        cnt:chars        "kentekenbewijzen in geval van vermissing van de bijbehorende kentekenplaten." .

<jci1.3:c:BWBR0006622&hoofdstuk=II&paragraaf=1&artikel=12&lid=3&o=a&z=2026-09-01&g=2026-09-01>
