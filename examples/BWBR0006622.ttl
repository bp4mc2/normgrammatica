<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=4b&artikel=55&lid=2&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=4b&artikel=55&lid=2>;
        schema:position  "2";
        cnt:chars        " Het vervangende bewijs treedt in de plaats van het eerder afgegeven kentekenbewijs en wordt niet afgegeven dan nadat het versleten of geheel of ten dele onleesbaar geworden kentekenbewijs, waarvoor het wordt afgegeven, is ingeleverd bij de Dienst Wegverkeer. " .

