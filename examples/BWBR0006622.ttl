<jci1.3:c:BWBR0006622&hoofdstuk=XII&artikel=185&lid=4&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "4";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=XII&artikel=185&lid=4>;
        schema:position  "4";
        cnt:chars        " Dit artikel laat onverkort de uit andere wettelijke bepalingen voortvloeiende aansprakelijkheid. " .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=7&artikel=125&lid=3&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=7&artikel=125&lid=3>;
        schema:position  "3";
        cnt:chars        "Voor de toepassing van het eerste en het tweede lid wordt onder rijbewijs mede verstaan een rijbewijs, afgegeven door het daartoe bevoegde gezag in een andere lidstaat van de Europese Unie of in een andere staat die partij is bij de Overeenkomst betreffende de Europese Economische Ruimte of Zwitserland, waarvan de houder in Nederland woonachtig is. " .

<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=7&artikel=70i&lid=1&o=c>
        rdf:type              eli:WorkSubdivision;
