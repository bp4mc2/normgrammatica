        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=II&paragraaf=2&artikel=16b&lid=2&o=b>;
        schema:position  "2";
        cnt:chars        "inzake de uitvoering van die ontwerpen, zoals gerealiseerd." .

<jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=2&artikel=4aa&lid=1&o=s&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
