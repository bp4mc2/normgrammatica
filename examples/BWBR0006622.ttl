        rdf:type         eli:Expression;
        eli:number       "4";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VII&artikel=149aa&lid=4>;
        schema:position  "4";
        cnt:chars        "Een vergunning met een ontheffing als bedoeld in het derde lid wordt verleend in overeenstemming met Onze Minister die het aangaat." .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=7&artikel=123&lid=1&o=b>
        rdf:type              eli:WorkSubdivision;
