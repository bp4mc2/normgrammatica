        dct:isPartOf          <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=7&artikel=124a&lid=1> .

<jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=1&artikel=21&lid=4&o=c&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "c.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=1&artikel=21&lid=4&o=c>;
        schema:position  "3";
        cnt:chars        "indien het betreft een VN/ECE-goedkeuring zolang wordt voldaan aan de daaraan gestelde voorwaarden in de desbetreffende geharmoniseerde technische reglement als bedoeld in de Overeenkomst van 1958." .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=5&artikel=120&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=5&artikel=120&lid=1>;
        schema:position  "1";
        cnt:chars        "Degene die is belast met de afgifte van rijbewijzen geeft in de bij algemene maatregel van bestuur aangegeven gevallen overeenkomstig bij algemene maatregel van bestuur vastgestelde regels een vervangend rijbewijs af." .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=8&artikel=126&lid=3&o=d&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "d.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=8&artikel=126&lid=3&o=d>;
        schema:position  "4";
        cnt:chars        "de op het rijbewijs te vermelden getuigschriften van vakbekwaamheid en getuigschriften van nascholing;" .

<jci1.3:c:BWBR0006622&hoofdstuk=1&artikel=1&lid=1&o=e&o=b&o=3>
