<jci1.3:c:BWBR0006622&hoofdstuk=XIII&artikel=186c&lid=2&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0006622&hoofdstuk=V&paragraaf=5&artikel=83&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=V&paragraaf=9a&artikel=106a&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=7&artikel=70a&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=V&paragraaf=6a&artikel=92&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=4c&artikel=61a&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=V&paragraaf=8&artikel=100&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=5&artikel=62&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=5a&artikel=66a&z=2026-09-01&g=2026-09-01>;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=XIII&artikel=186c&lid=2>;
        schema:position  "2";
        cnt:chars        "Erkenningen die op het tijdstip direct voorafgaand aan de inwerkingtreding van de Wet van 10 mei 2023 tot wijziging van de Wegenverkeerswet 1994 in verband met de modernisering van het erkenningenstelsel, het verbeteren van de handhaafbaarheid en enkele andere wijzigingen (Stb. 2023, 195) waren verleend op grond van de artikelen 61a, 62, 66a, 70a, 83, 92, 100 en 106a van deze wet zoals die luidden voor de inwerkingtreding van de genoemde wet, berusten op artikel 4aud, eerste lid. De eerste zin is van overeenkomstige toepassing op de bevoegdheden bedoeld in artikel 62, tweede lid, van deze wet zoals die luidden voor de inwerkingtreding van de genoemde wet, die na de inwerkingtreding worden aangemerkt als erkenningen voor specifieke handelingen." .

