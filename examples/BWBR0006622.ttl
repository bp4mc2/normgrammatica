<jci1.3:c:BWBR0006622&hoofdstuk=X&paragraaf=2&artikel=174b&lid=3&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=2&artikel=30&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0001854&artikel=23> , <jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=1&artikel=25&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=2&artikel=29&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=1&artikel=21&z=2026-09-01&g=2026-09-01> , <jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=1&artikel=27&z=2026-09-01&g=2026-09-01>;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=X&paragraaf=2&artikel=174b&lid=3>;
        schema:position  "3";
        cnt:chars        "De bestuurlijke boete die voor een overtreding van de bij of krachtens artikel 29, derde lid, genoemde artikelen van een EU-verordening of -richtlijn in verband met de goedkeuring van motorvoertuigen, artikel 21, derde lid, onderdeel b, 25, 27 of 30, derde lid, kan worden opgelegd, komt overeen met ten hoogste een boete van de vijfde categorie, bedoeld in artikel 23, vierde lid, van het Wetboek van Strafrecht." .

<jci1.3:c:BWBR0006622&hoofdstuk=III&paragraaf=1&artikel=21&lid=2&o=c&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
