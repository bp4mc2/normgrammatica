<jci1.3:c:BWBR0006622&hoofdstuk=IBA&artikel=4auh&lid=5&o=b&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IBA&artikel=4auh&lid=5&o=b>;
        schema:position  "2";
        cnt:chars        "de gegevens die met het oog op de verkrijging van de bevoegdheid zijn verstrekt, zodanig onjuist of onvolledig blijken, dat op de aanvraag een andere beslissing zou zijn genomen als bij de beoordeling daarvan de juiste omstandigheden volledig bekend waren geweest." .

