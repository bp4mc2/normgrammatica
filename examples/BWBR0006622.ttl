<jci1.3:c:BWBR0006622&hoofdstuk=1&artikel=1&lid=1&o=fb&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <https://data.europe.eu/eli/dir/2007/46/oj>;
        eli:number       "fb.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=1&artikel=1&lid=1&o=fb>;
        schema:position  "9";
        cnt:chars        "verordening (EU) 2018/858: Verordening (EU) nr. 2018/858 van het Europees Parlement en de Raad van 30 mei 2018 betreffende de goedkeuring van en het markttoezicht op motorvoertuigen en aanhangwagens daarvan en systemen, onderdelen en technische eenheden die voor dergelijke voertuigen zijn bestemd, tot wijziging van Verordeningen (EG) nr. 715/2007 en (EG) nr. 595/2009 en tot intrekking van Richtlijn 2007/46/EG (PbEU 2018, L 151) en de op die verordening gebaseerde uitvoeringshandelingen en gedelegeerde handelingen;" .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=7&artikel=123b&lid=1&o=a&o=3&z=2026-09-01&g=2026-09-01>
