<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=3&artikel=43a&lid=3&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=3&artikel=43&z=2026-09-01&g=2026-09-01>;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=3&artikel=43a&lid=3>;
        schema:position  "3";
        cnt:chars        "Onverminderd het tweede lid is degene die op grond van artikel 43 een aanvraag indient tot geautomatiseerde verstrekking uit het kentekenregister van gegevens in door de Dienst Wegverkeer te bepalen gevallen een door deze dienst te bepalen aansluittarief verschuldigd." .

