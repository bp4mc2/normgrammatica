<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=6&artikel=67&lid=2&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=6&artikel=68&z=2026-09-01&g=2026-09-01>;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=6&artikel=67&lid=2>;
        schema:position  "2";
        cnt:chars        " De hoogte van het in het eerste lid bedoelde tarief kan voor verschillende groepen voertuigen dan wel eigenaren of houders van voertuigen verschillend worden vastgesteld. Voor aanvragen die worden ingediend binnen een jaar na de aanvraag van een schorsing welke ingevolge artikel 68, eerste lid, onderdelen a en d, is geëindigd, kan het tarief hoger worden vastgesteld dan het tarief voor laatstgenoemde aanvraag. " .

