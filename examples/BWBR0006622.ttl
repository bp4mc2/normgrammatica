        cnt:chars        " Bij ministeriële regeling kunnen nadere regels worden vastgesteld met betrekking tot de in het tweede lid bedoelde voorwaarden en groepen van motorrijtuigen. " .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=8a&artikel=129b>
        rdf:type              eli:WorkSubdivision;
