        schema:position  "36";
        cnt:chars        "erkenninghouder: natuurlijke persoon of rechtspersoon waaraan een basiserkenning in combinatie met één of meer erkenningen voor specifieke handelingen is verleend;" .

<jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=4&artikel=4ap&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
