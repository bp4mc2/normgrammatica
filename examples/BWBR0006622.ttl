        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=5&artikel=4ar&lid=2>;
        schema:position  "2";
        cnt:chars        "Met goedkeuring wordt gelijkgesteld het verstrijken van de in het eerste lid bedoelde termijn zonder dat de goedkeuring is verleend of onthouden." .

<jci1.3:c:BWBR0006622&hoofdstuk=VIIA&paragraaf=2&artikel=151h&o=b&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VIIA&paragraaf=2&artikel=151h&o=b>;
        schema:position  "2";
        cnt:chars        "het in overeenstemming met de richtlijn vakbekwaamheid bestuurders vastgestelde tijdschema dat een bestuurder moet volgen bij de nascholing;" .

<jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=2&artikel=4aa&lid=1&o=b>
        rdf:type              eli:WorkSubdivision;
