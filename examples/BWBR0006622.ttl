        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IA&paragraaf=6&artikel=4q&lid=2&o=j>;
        schema:position  "10";
        cnt:chars        "het uitvoeren van experimenten op grond van artikel 186, eerste en tweede lid, en het opstellen van het verslag over de doeltreffendheid en de effecten van experimenten op grond van artikel 186, derde lid," .

