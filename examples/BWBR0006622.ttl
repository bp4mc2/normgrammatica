        dct:isPartOf          <jci1.3:c:BWBR0006622&hoofdstuk=VIIA&paragraaf=3&artikel=151ic&lid=1> .

<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=4a&artikel=51a&lid=2&o=a&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=4a&artikel=51a&lid=2&o=a>;
        schema:position  "1";
        cnt:chars        "indien de tenaamstelling heeft plaatsgevonden op grond van bij de inschrijving of tenaamstelling verschafte onjuiste gegevens en dat inschrijving zou zijn geweigerd indien de onjuistheid van die gegevens ten tijde van de aanvraag bekend zou zijn geweest, dan wel" .

<jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=5&artikel=4aq&lid=1>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
        dct:isPartOf          <jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=5&artikel=4aq> .

<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=4a&artikel=48&lid=2b&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "2b";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=4a&artikel=48&lid=2b>;
        schema:position  "3";
        cnt:chars        "In afwijking van het tweede lid, kan de Dienst Wegverkeer inschrijving in het kentekenregister weigeren of aan de inschrijving voorschriften verbinden indien het goedgekeurde voertuig een zodanige afmeting of massa heeft, dat het gelet op de infrastructuur van de wegen, een ernstig gevaar kan vormen voor de gezondheid, veiligheid, het milieu of andere aspecten van de bescherming van het openbaar belang." .

