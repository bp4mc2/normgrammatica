<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=3&artikel=43d&lid=1&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=3&artikel=43d&lid=1>;
        schema:position  "1";
        cnt:chars        "Indien de Dienst Wegverkeer constateert dat een door deze dienst in het kentekenregister geplaatst gegeven onjuist of ten onrechte in het kentekenregister is opgenomen, wijzigt of verwijdert deze dienst dat gegeven." .

