        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=XI&artikel=175&lid=1>;
        schema:position  "1";
        cnt:chars        "Overtreding van artikel 6 wordt gestraft met:" .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=3&artikel=111a&lid=7&o=c&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
