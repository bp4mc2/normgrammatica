<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=9&paragraaf=1&artikel=131&lid=4&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "4";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=9&paragraaf=1&artikel=131&lid=4>;
        schema:position  "4";
        cnt:chars        "Voor de toepassing van het tweede lid wordt onder rijbewijs mede verstaan een rijbewijs afgegeven door het daartoe bevoegde gezag buiten Nederland, waarvan de houder in Nederland woonachtig is." .

