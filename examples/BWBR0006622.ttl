<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=4a&artikel=50&lid=2&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=2&artikel=38&z=2026-09-01&g=2026-09-01>;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=4a&artikel=50&lid=2>;
        schema:position  "2";
        cnt:chars        "Bij algemene maatregel van bestuur kan worden bepaald dat de verplichting om persoonlijk te verschijnen niet geldt ten aanzien van de inschrijving en tenaamstelling ter zake van de opgave van een kenteken als bedoeld in artikel 38." .

<jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=3&artikel=112&lid=1>
        rdf:type              eli:WorkSubdivision;
