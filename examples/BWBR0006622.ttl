<jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=2&artikel=40&lid=4&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "4";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IV&paragraaf=2&artikel=40&lid=4>;
        schema:position  "4";
        cnt:chars        " Voor overtreding van het eerste lid dan wel het bepaalde krachtens het tweede of derde lid zijn aansprakelijk: " .

<jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=3&artikel=4ah&lid=2&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=IB&paragraaf=3&artikel=4ah&lid=2>;
        schema:position  "2";
        cnt:chars        "Onze Minister benoemt, schorst en ontslaat de leden van de raad van toezicht." .

<jci1.3:c:BWBR0006622&hoofdstuk=X&paragraaf=1&artikel=172&lid=2&z=2026-09-01&g=2026-09-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0006622&hoofdstuk=X&paragraaf=1&artikel=171&z=2026-09-01&g=2026-09-01>;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=X&paragraaf=1&artikel=172&lid=2>;
        schema:position  "2";
        cnt:chars        "Verkoop, eigendomsoverdracht om niet of vernietiging vindt niet plaats binnen twee weken na de bekendmaking van de beschikking tot oplegging van een last onder bestuursdwang krachtens artikel 171, eerste lid, onderdeel b. De opbrengst van verkoop of de geschatte sloopwaarde bij vernietiging wordt in mindering gebracht op de kosten, verbonden aan de oplegging van een last onder bestuursdwang." .

<jci1.3:c:BWBR0006622&hoofdstuk=IBA&artikel=4aug&lid=1>
        rdf:type              eli:WorkSubdivision;
