        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=9&paragraaf=1&artikel=130&z=2026-09-01&g=2026-09-01>;
        eli:number       "c.";
        eli:realizes     <jci1.3:c:BWBR0006622&hoofdstuk=VI&afdeling=9&paragraaf=1&artikel=131&lid=2&o=c>;
        schema:position  "3";
        cnt:chars        "indien de geldigheid van het rijbewijs van betrokkene niet overeenkomstig onderdeel a, wordt geschorst, doch diens rijbewijs wel overeenkomstig artikel 130, tweede lid, is ingevorderd, bepaald dat het rijbewijs onverwijld aan betrokkene wordt teruggegeven." .

