        eli:number       "5°";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=1&artikel=69&lid=2&o=a&o=5>;
        schema:position  "5";
        cnt:chars        "buiten behandeling is gesteld op grond van artikel 30c, eerste lid, onderdeel a, en het beroep zich richt tot het daarmee samenhangende terugkeerbesluit." .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=1&artikel=9&lid=8&o=d&o=3>
