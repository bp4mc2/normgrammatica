        rdf:type         eli:Expression;
        eli:cites        <file:///Users/marcobrattinga/GITREPO/normgrammatica/examples/32008R0767>;
        eli:number       "2°";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=1&artikel=1&o=2>;
        schema:position  "2";
        cnt:chars        "Verordening (EG) nr. 767/2008 van het Europees Parlement en de Raad van 9 juli 2008 betreffende het visuminformatiesysteem (VIS) en de uitwisseling tussen de lidstaten van gegevens op het gebied van visa voor kort verblijf (VIS-verordening);" .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=1&artikel=16&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
