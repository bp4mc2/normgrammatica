        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=30c&lid=1&o=a>;
        schema:position  "1";
        cnt:chars        "expliciet ingetrokken overeenkomstig artikel 40 van de Procedureverordening; of" .

<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=3&paragraaf=2&artikel=83.0a&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=3&paragraaf=2&artikel=83.0a>;
        dct:title        "Artikel 83.0a.";
        schema:position  "4";
        cnt:chars        "Indien beroep is ingesteld tegen een besluit dat een gelijke strekking heeft als een besluit dat eerder ten aanzien van de indiener van het beroepschrift is genomen, zal dit besluit, ook bij het ontbreken van nieuw gebleken feiten of veranderde omstandigheden of een relevante wijziging van het recht, worden beoordeeld als ware het een eerste afwijzing indien hier wegens bijzondere, op de individuele zaak betrekking hebbende, feiten en omstandigheden, de noodzaak toe bestaat." .

<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=3&paragraaf=2&artikel=83&lid=2&o=a>
        rdf:type              eli:WorkSubdivision;
