<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=4&artikel=83c&lid=2&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0005537&artikel=8:108>;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=4&artikel=83c&lid=2>;
        schema:position  "2";
        cnt:chars        "Artikel 8:108, eerste en derde lid, van de Algemene wet bestuursrecht is niet van toepassing." .

<jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=2&paragraaf=3&artikel=2u&lid=3&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=2&paragraaf=3&artikel=2u&lid=3>;
        schema:position  "3";
        cnt:chars        "In afwijking van het eerste lid maakt Onze Minister de beslissing op een aanvraag om verlening van een machtiging tot voorlopig verblijf onder een beperking verband houdend met wetenschappelijk onderzoek, studie, lerend werken, of uitwisseling in het kader van Europees vrijwilligerswerk bekend binnen 60 dagen en kan die termijn niet worden verlengd." .

<jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=1a&artikel=107&lid=5&o=f&o=5&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "5°.";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=1a&artikel=107&lid=5&o=f&o=5>;
        schema:position  "5";
        cnt:chars        "de Screeningsverordening." .

<jci1.3:c:BWBR0011823&hoofdstuk=6&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=6>;
        dct:title        "Hoofdstuk 6. Vertrek, uitzetting en overdracht, inreisverbod en ongewenstverklaring";
        schema:position  "9" .

