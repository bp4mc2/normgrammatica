<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=1&artikel=14&lid=3&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=1&artikel=14&lid=3>;
        schema:position  "3";
        cnt:chars        "Een verblijfsvergunning voor bepaalde tijd wordt verleend onder beperkingen, verband houdende met het doel waarvoor het verblijf is toegestaan. Aan de vergunning kunnen voorschriften worden verbonden. Bij of krachtens algemene maatregel van bestuur kunnen regels worden gesteld over de ambtshalve verlening, wijziging en verlenging, de beperkingen en de voorschriften." .

<jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=3&artikel=2aa&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=3&artikel=2aa>;
        dct:title        "Artikel 2aa.";
        schema:position  "5";
        cnt:chars        "Onze Minister beslist binnen twee weken na ontvangst van een aanvraag om verlening van een terugkeervisum. Onze Minister kan deze termijn verlengen met ten hoogste twee weken." .

<jci1.3:c:BWBR0011823&hoofdstuk=6&afdeling=2&artikel=63&lid=3>
        rdf:type              eli:WorkSubdivision;
