        dct:title        "Artikel 2p.";
        schema:position  "1" .

<jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=59&lid=7&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=58&z=2026-10-16&g=2026-10-16> , <jci1.3:c:BWBR0011823&hoofdstuk=2&artikel=6&z=2026-10-16&g=2026-10-16>;
        eli:number       "7";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=59&lid=7>;
        schema:position  "7";
        cnt:chars        "Het vijfde en zesde lid zijn van overeenkomstige toepassing op de vreemdeling aan wie de verplichting of maatregel, bedoeld in artikel 6, eerste of tweede lid, dan wel artikel 58 is opgelegd." .

