        schema:position  "1";
        cnt:chars        "De rechtbank houdt bij de beoordeling van het beroep rekening met:" .

<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=4&artikel=84>
        rdf:type              eli:WorkSubdivision;
