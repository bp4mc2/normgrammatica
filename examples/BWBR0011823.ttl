        schema:position  "1";
        cnt:chars        "de houder daarvan zijn hoofdverblijf buiten Nederland heeft gevestigd;" .

<jci1.3:c:BWBR0011823&hoofdstuk=6&afdeling=1&artikel=62&lid=2&o=a&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
