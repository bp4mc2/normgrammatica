        eli:cites        <jci1.3:c:BWBR0001903&artikel=36b> , <jci1.3:c:BWBR0001903&artikel=36h> , <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=94&z=2026-10-16&g=2026-10-16> , <jci1.3:c:BWBR0001903&artikel=36g> , <jci1.3:c:BWBR0001903&artikel=36n>;
