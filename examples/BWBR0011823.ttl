        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=6&afdeling=3&artikel=66a&lid=1>;
        schema:position  "1";
        cnt:chars        "Onze Minister vaardigt een inreisverbod uit tegen de vreemdeling, die geen gemeenschapsonderdaan is, op wie artikel 64 niet van toepassing is en die Nederland:" .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=1&artikel=17&lid=1&o=c&z=2026-10-16&g=2026-10-16>
