<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=31&lid=2&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=31&lid=2>;
        schema:position  "2";
        cnt:chars        "Onze Minister kan een aanvraag tot het verlenen van een verblijfsvergunning asiel als bedoeld in artikel 29c of 29d afwijzen, indien niet wordt voldaan aan de daarin gestelde voorwaarden." .

<jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=3&artikel=109&lid=1>
        rdf:type              eli:WorkSubdivision;
