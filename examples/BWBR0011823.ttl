        eli:cites        <file:///Users/marcobrattinga/GITREPO/normgrammatica/examples/32013R0603> , <file:///Users/marcobrattinga/GITREPO/normgrammatica/examples/32024R1351> , <file:///Users/marcobrattinga/GITREPO/normgrammatica/examples/32001L0055> , <file:///Users/marcobrattinga/GITREPO/normgrammatica/examples/32024R1350> , <file:///Users/marcobrattinga/GITREPO/normgrammatica/examples/32024R1358> , <file:///Users/marcobrattinga/GITREPO/normgrammatica/examples/32018R1240> , <file:///Users/marcobrattinga/GITREPO/normgrammatica/examples/32019R0818>;
