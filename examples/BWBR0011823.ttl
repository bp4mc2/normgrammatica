        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=1&artikel=16a&lid=3>;
        schema:position  "3";
        cnt:chars        "Bij of krachtens de algemene maatregel van bestuur, bedoeld in het eerste lid, onderdeel b, worden in ieder geval regels gesteld omtrent de inhoud van het inburgeringstraject en het te behalen niveau, alsmede omtrent de vrijstellingen en ontheffingen." .

<jci1.3:c:BWBR0011823&hoofdstuk=6&afdeling=4&artikel=67&lid=2&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
