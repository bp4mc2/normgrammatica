        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=3&artikel=109a&o=b>;
        schema:position  "2";
        cnt:chars        "jegens wie een procedure van uitlevering als bedoeld in de Uitleveringswet loopt." .

