        schema:position  "28";
        cnt:chars        "overdrachtsbesluit: het besluit, bedoeld in artikel 42 van de Asiel- en migratiebeheerverordening;" .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=29c&lid=1&o=d&z=2026-10-16&g=2026-10-16>
