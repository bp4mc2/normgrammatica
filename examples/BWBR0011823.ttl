<jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=57&lid=5&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "5";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=57&lid=5>;
        schema:position  "5";
        cnt:chars        "De termijn, bedoeld in het derde lid, wordt opgeschort gedurende de termijn waarin de vreemdeling de beperking van zijn bewegingsvrijheid niet in acht heeft genomen." .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=30c&lid=2>
