        dct:isPartOf          <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=2&artikel=41> .

<jci1.3:c:BWBR0011823&hoofdstuk=1c&artikel=2ff&lid=1&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=1c&artikel=2ff&lid=1>;
        schema:position  "1";
        cnt:chars        "Onze Minister is overeenkomstig de Screeningsverordening belast met de uitvoering van de taken en bezit daartoe de bevoegdheden die de Screeningsverordening aan de Screeningsautoriteiten toekent." .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45b&lid=2&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
