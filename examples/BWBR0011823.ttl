        eli:cites        <jci1.3:c:BWBR0011823&hoofdstuk=6&afdeling=2&artikel=65&z=2026-10-16&g=2026-10-16> , <jci1.3:c:BWBR0011823&hoofdstuk=2&artikel=5&z=2026-10-16&g=2026-10-16> , <jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=57&z=2026-10-16&g=2026-10-16> , <jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=58&z=2026-10-16&g=2026-10-16> , <jci1.3:c:BWBR0011823&hoofdstuk=4&afdeling=1&paragraaf=3&artikel=55&z=2026-10-16&g=2026-10-16> , <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=3&artikel=24a&z=2026-10-16&g=2026-10-16> , <jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=56&z=2026-10-16&g=2026-10-16> , <jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=3&paragraaf=1&artikel=2a&z=2026-10-16&g=2026-10-16> , <jci1.3:c:BWBR0011823&hoofdstuk=4&afdeling=1&paragraaf=3&artikel=54&z=2026-10-16&g=2026-10-16> , <jci1.3:c:BWBR0011823&hoofdstuk=2&artikel=6&z=2026-10-16&g=2026-10-16> , <jci1.3:c:BWBR0011823&hoofdstuk=4&afdeling=1&paragraaf=1&artikel=46&z=2026-10-16&g=2026-10-16> , <jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=2&paragraaf=3&artikel=2t&z=2026-10-16&g=2026-10-16> , <jci1.3:c:BWBR0011823&hoofdstuk=2&artikel=6a&z=2026-10-16&g=2026-10-16>;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=2&artikel=108&lid=1>;
        schema:position  "1";
        cnt:chars        "Met hechtenis van ten hoogste zes maanden of geldboete van de tweede categorie wordt gestraft overtreding van bij ministeriële regeling aan te wijzen voorschriften vastgesteld bij of krachtens de Schengengrenscode, overtreding van een voorschrift, vastgesteld bij of krachtens de artikelen 2t, tweede en derde lid, 5, eerste en tweede lid, 24a, tweede en derde lid, 46, tweede lid, aanhef, en onder b, alsmede handelen in strijd met artikel 56, eerste lid, dan wel handelen in strijd met een verplichting opgelegd bij of krachtens de artikelen 2a, derde lid, onder b, 6, eerste of derde lid, 6a, eerste lid, 54, 55, 57, eerste lid, 58, eerste lid, of 65, derde lid." .

<jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=2&paragraaf=4&artikel=2v>
        rdf:type              eli:WorkSubdivision;
