        schema:position  "1";
        cnt:chars        "een Nederlander, die in Nederland verblijft of met die vreemdeling in Nederland gaat verblijven;" .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45c&lid=4>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
