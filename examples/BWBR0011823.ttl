        schema:position  "3";
        cnt:chars        "De machtiging tot voorlopig verblijf wordt bij de vertegenwoordiging dan wel het Kabinet, bedoeld in het eerste lid, aan de vreemdeling in persoon afgegeven." .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=2&artikel=37&o=a>
        rdf:type              eli:WorkSubdivision;
