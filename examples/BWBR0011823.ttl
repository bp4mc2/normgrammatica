<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=98&lid=3&o=b&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0005682>;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=98&lid=3&o=b>;
        schema:position  "2";
        cnt:chars        "die aan een universiteit dan wel de Open Universiteit als bedoeld in de Wet op het hoger onderwijs en wetenschappelijk onderzoek het doctoraat in de rechtsgeleerdheid of het recht om de titel meester te voeren heeft verkregen." .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=2&artikel=41&lid=1&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
