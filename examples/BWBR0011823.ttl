<jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=3&artikel=2y&lid=3&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=3&artikel=2y&lid=3>;
        schema:position  "3";
        cnt:chars        "Onze Minister kan vrijstelling dan wel ontheffing verlenen van het eerste en tweede lid." .

<jci1.3:c:BWBR0011823&hoofdstuk=2&artikel=3&lid=2&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=2&artikel=3&lid=2>;
        schema:position  "2";
        cnt:chars        "Bij of krachtens algemene maatregel van bestuur worden regels gesteld over de weigering van toegang op grond van deze wet of ter uitvoering van de Schengengrenscode." .

<jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=59a&lid=2&z=2026-10-16&g=2026-10-16>
