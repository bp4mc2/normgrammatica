        cnt:chars        "het verstrekken van een reisdocument door een diplomatieke vertegenwoordiging ten behoeve van terugkeer;" .

<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=3&paragraaf=1&artikel=79&lid=2&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=5&artikel=45&z=2026-10-16&g=2026-10-16> , <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=3&artikel=43&z=2026-10-16&g=2026-10-16>;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=3&paragraaf=1&artikel=79&lid=2>;
        schema:position  "2";
        cnt:chars        "Deze afdeling is van overeenkomstige toepassing indien beroep wordt ingesteld tegen een besluit als bedoeld in de artikelen 43 en 45, vierde lid." .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=2&artikel=22&lid=1&o=a&z=2026-10-16&g=2026-10-16>
