        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=6&artikel=27&lid=1>;
        schema:position  "1";
        cnt:chars        "De beschikking waarbij een aanvraag tot het verlenen van een verblijfsvergunning voor bepaalde tijd als bedoeld in artikel 14 of een verblijfsvergunning voor onbepaalde tijd als bedoeld in artikel 20 wordt afgewezen, geldt als terugkeerbesluit, tenzij reeds eerder een terugkeerbesluit tegen de vreemdeling is uitgevaardigd en aan de daaruit voortvloeiende terugkeerverplichting niet is voldaan, en heeft van rechtswege tot gevolg dat:" .

<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=94&lid=1>
        rdf:type              eli:WorkSubdivision;
