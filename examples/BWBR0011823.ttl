        schema:position  "4";
        cnt:chars        "De adviesraad heeft tot taak Onze Minister te adviseren over het vreemdelingenrecht en het beleid ter zake, waaronder begrepen wijzigingen van deze wet." .

<jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=3&paragraaf=2&artikel=2e&lid=2>
        rdf:type              eli:WorkSubdivision;
