        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=58&lid=2>;
        schema:position  "2";
        cnt:chars        "De artikelen 6, vierde lid, 57, tweede tot en met vijfde lid en 59, derde lid, zijn van overeenkomstige toepassing." .

