<jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=2&artikel=2&lid=2&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=2&artikel=2&lid=2>;
        schema:position  "2";
        cnt:chars        "De adviesraad bestaat uit ten minste zeven leden. Ambtenaren die werkzaam zijn bij een ministerie of een daaronder ressorterende instelling, dienst of bedrijf, dan wel anderszins werkzaamheden verrichten in ondergeschiktheid aan Onze Ministers, worden niet tot lid benoemd." .

