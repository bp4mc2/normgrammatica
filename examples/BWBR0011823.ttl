        schema:position  "6";
        cnt:chars        "op de dag waarop de aanvraag is ontvangen, een verblijfsrecht van tijdelijke aard heeft; of" .

<jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=1&artikel=1&o=_28&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
