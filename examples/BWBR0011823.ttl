        schema:position  "1";
        cnt:chars        "Onze Minister kan een aanvraag tot het verlenen van een verblijfsvergunning asiel als bedoeld in artikel 28 buiten behandeling stellen als:" .

<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=106&lid=2&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
