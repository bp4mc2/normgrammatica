        schema:position  "2";
        cnt:chars        "Bij of krachtens algemene maatregel van bestuur kunnen regels worden gesteld over de toepassing van de gronden, bedoeld in het eerste lid, onderdeel a." .

<jci1.3:c:BWBR0011823&hoofdstuk=6&afdeling=4&artikel=67&lid=1&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
