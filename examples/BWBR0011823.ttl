        schema:position  "9" .

<jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=1a&artikel=107a&lid=1&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0040940&paragraaf=3.2> , <jci1.3:c:BWBR0040940&paragraaf=3.1>;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=1a&artikel=107a&lid=1>;
        schema:position  "1";
        cnt:chars        "Bijzondere categorieën van persoonsgegevens en persoonsgegevens van strafrechtelijke aard als bedoeld in paragraaf 3.1 onderscheidenlijk paragraaf 3.2 van de Uitvoeringswet Algemene verordening gegevensbescherming kunnen worden verwerkt, voor zover deze gegevens noodzakelijk zijn voor de doelmatige en doeltreffende uitvoering van de visumverlening, de grensbewaking, de toelating, het verblijf en de uitzetting van vreemdelingen en het toezicht op vreemdelingen op grond van deze wet dan wel de Schengengrenscode." .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=28&lid=1&o=c&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "c.";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=28&lid=1&o=c>;
        schema:position  "3";
        cnt:chars        "ambtshalve een verblijfsvergunning asiel te verlenen aan:" .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=1&artikel=11&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=1&artikel=11>;
        dct:title        "Artikel 11.";
        schema:position  "5" .

<jci1.3:c:BWBR0011823&hoofdstuk=2&artikel=4&lid=4&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "4";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=2&artikel=4&lid=4>;
        schema:position  "4";
        cnt:chars        "Bij of krachtens algemene maatregel van bestuur worden nadere regels gesteld omtrent de toepassing van het eerste tot en met het derde lid. Daarbij kan ter uitvoering van een verdrag of bindende EU-rechtshandeling het gebruik van de elektronische weg worden voorgeschreven." .

<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=1&artikel=69&lid=7>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
