        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=1&artikel=11&lid=5>;
        schema:position  "5";
        cnt:chars        "Indien het COA een verplichting als bedoeld in het vierde lid heeft opgelegd en de vreemdeling deze verplichting niet of onvoldoende nakomt, is het COA bevoegd materiële voorzieningen te beperken of in te trekken." .

<jci1.3:c:BWBR0011823&hoofdstuk=6&afdeling=4&artikel=68&lid=2&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
