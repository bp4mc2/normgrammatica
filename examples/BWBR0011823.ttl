        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=106&lid=2>;
        schema:position  "2";
        cnt:chars        "Het eerste lid is van overeenkomstige toepassing, indien de Afdeling bestuursrechtspraak van de Raad van State de opheffing van de maatregel strekkende tot vrijheidsontneming of -beperking beveelt." .

<jci1.3:c:BWBR0011823&hoofdstuk=1b&artikel=2ee&lid=1&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
