        schema:position  "1";
        cnt:chars        "Indien het belang van de openbare orde of de nationale veiligheid zulks vordert kan, met het oog op de uitzetting, door Onze Minister in vreemdelingenbewaring worden gesteld de vreemdeling die:" .

<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=98&lid=3&o=a&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
