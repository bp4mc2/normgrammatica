        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=3&paragraaf=2&artikel=83b&lid=3&o=a>;
        schema:position  "1";
        cnt:chars        "de aanvraag tot het verlenen van een verblijfsvergunning asiel als bedoeld in artikel 28 is ingewilligd op grond van artikel 29a;" .

