<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=98&lid=1&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0005537&artikel=8:24>;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=98&lid=1>;
        schema:position  "1";
        cnt:chars        "In afwijking van artikel 8:24 van de Algemene wet bestuursrecht kan de vreemdeling zich bij de gehoren ingevolge de artikelen 94, 96 en 96a uitsluitend door één of meer van zijn raadslieden doen bijstaan." .

<jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=59a>
        rdf:type              eli:WorkSubdivision;
