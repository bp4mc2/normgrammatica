        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=1&artikel=18&lid=1&o=a>;
        schema:position  "1";
        cnt:chars        "de houder daarvan zijn hoofdverblijf buiten Nederland heeft gevestigd;" .

