<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=3&paragraaf=2&artikel=83bc&o=c&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "c.";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=3&paragraaf=2&artikel=83bc&o=c>;
        schema:position  "3";
        cnt:chars        "ten hoogste vijf maanden, in de gevallen, bedoeld in artikel 35, vierde lid, van de Procedureverordening." .

<jci1.3:c:BWBR0011823&hoofdstuk=4&afdeling=1&paragraaf=1&artikel=47&lid=1&z=2026-10-16&g=2026-10-16>
