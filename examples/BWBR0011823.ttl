        schema:position  "2";
        cnt:chars        "bedoeld in artikel 8, onder j, en" .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=30b&lid=3&z=2026-10-16&g=2026-10-16>
