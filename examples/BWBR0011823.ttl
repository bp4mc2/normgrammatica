        schema:position  "1";
        cnt:chars        "ten hoogste zes weken, in de gevallen, bedoeld in artikel 35, eerste lid, van de Procedureverordening;" .

<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=3&paragraaf=2&artikel=83&lid=7&o=b&z=2026-10-16&g=2026-10-16>
