        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=3&artikel=45g&lid=2>;
        schema:position  "2";
        cnt:chars        "De termijn voor de bekendmaking van de beschikking, bedoeld in het eerste lid, kan ten hoogste voor zes maanden worden verlengd, indien er naar het oordeel van Onze Minister sprake is van bijzondere omstandigheden die verband houden met het complexe karakter van de behandeling van de aanvraag." .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=5&artikel=45&lid=1&o=a&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
