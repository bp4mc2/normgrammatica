        dct:isPartOf          <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=2&paragraaf=1&artikel=73> .

<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=3&paragraaf=1&artikel=80&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=3&paragraaf=1&artikel=80>;
        dct:title        "Artikel 80.";
        schema:position  "2";
        cnt:chars        "In afwijking van artikel 8:1 van de Algemene wet bestuursrecht kan geen beroep worden ingesteld tegen:" .

<jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=3&paragraaf=1&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
