        dct:title        "Artikel 20.";
        schema:position  "1" .

<jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=59&lid=3&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=59&lid=3>;
        schema:position  "3";
        cnt:chars        "Vreemdelingenbewaring van een vreemdeling blijft achterwege indien en wordt beëindigd zodra hij te kennen geeft Nederland te willen verlaten en hiertoe voor hem ook gelegenheid bestaat." .

