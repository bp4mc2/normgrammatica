        dct:title        "Paragraaf 1. Algemeen";
        schema:position  "1" .

<jci1.3:c:BWBR0011823&hoofdstuk=6&afdeling=4&artikel=67>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Artikel>;
        dct:isPartOf          <jci1.3:c:BWBR0011823&hoofdstuk=6&afdeling=4> .

<jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=57&lid=4&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "4";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=57&lid=4>;
        schema:position  "4";
        cnt:chars        "De aanwijzing, bedoeld in het eerste lid, vervalt indien de beschikking waarbij de aanvraag is afgewezen is vernietigd of zodra het vertrek van de vreemdeling uit de ruimte of plaats nodig is om Nederland te verlaten." .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=2&artikel=36&lid=2&o=b>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Onderdeel>;
        dct:isPartOf          <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=2&artikel=36&lid=2> .

<jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=1a&artikel=107&lid=5&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=1a&artikel=107a&z=2026-10-16&g=2026-10-16>;
        eli:number       "5";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=1a&artikel=107&lid=5>;
        schema:position  "5";
        cnt:chars        "Onverminderd het in het tweede lid, onder a, genoemde doel, en in aanvulling op het bepaalde bij of krachtens artikel 107a, kunnen gegevens als bedoeld in het eerste lid, onder a, uitsluitend beschikbaar worden gesteld met het oog op:" .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45d&lid=3&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45d&lid=3>;
        schema:position  "3";
        cnt:chars        "De EU-verblijfsvergunning voor langdurig ingezetenen wordt ingetrokken, indien:" .

<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=101&lid=3&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=100&z=2026-10-16&g=2026-10-16>;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=101&lid=3>;
        schema:position  "3";
        cnt:chars        "Toevoeging van een andere raadsman geschiedt door het bureau bedoeld in artikel 100, tweede of derde lid." .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=3&artikel=24a&lid=1&o=a>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Onderdeel>;
        dct:isPartOf          <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=3&artikel=24a&lid=1> .

<jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=3&paragraaf=1&artikel=2a&lid=3&o=b&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=3&paragraaf=1&artikel=2a&lid=3&o=b>;
        schema:position  "2";
        cnt:chars        "wordt ten aanzien van referenten voorzien in zorgplichten jegens de vreemdeling;" .

<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=94&lid=3&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=94&lid=3>;
        schema:position  "3";
        cnt:chars        "Het tweede lid is niet van toepassing indien tussen de uitreiking van het besluit tot weigering van toegang tot Nederland en het opleggen van de vrijheidsontnemende maatregel meer dan achtentwintig dagen zijn verstreken." .

<jci1.3:c:BWBR0011823&hoofdstuk=4&afdeling=1&paragraaf=3&artikel=55.0a&lid=2&z=2026-10-16&g=2026-10-16>
