        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=1&artikel=16&lid=1&o=k>;
        schema:position  "11";
        cnt:chars        "ten behoeve van het verblijf van de vreemdeling geen verklaring van een referent is overgelegd als bedoeld in artikel 2a, tweede lid." .

<jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=1&artikel=1&o=_17&z=2026-10-16&g=2026-10-16>
