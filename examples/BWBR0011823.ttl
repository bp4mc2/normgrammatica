        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=1&artikel=1&o=_14&o=_5>;
        schema:position  "5";
        cnt:chars        "onderdanen van de Zwitserse Bondsstaat, indien zij verblijven op grond van de op 21 juni 1999 te Luxemburg totstandgekomen Overeenkomst tussen de Europese Gemeenschap en haar lidstaten, enerzijds, en de Zwitserse Bondsstaat, anderzijds, over het vrije verkeer van personen (Trb. 2000, 16 en 86);" .

