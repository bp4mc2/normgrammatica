<jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=3&artikel=109a&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=3&artikel=109a>;
        dct:title        "Artikel 109a.";
        schema:position  "2";
        cnt:chars        "De verplichtingen die voor Nederland voortvloeien uit de Terugkeerrichtlijn, gelden niet ten aanzien van vreemdelingen:" .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=29c&lid=3&z=2026-10-16&g=2026-10-16>
