        schema:position  "4";
        cnt:chars        "Vreemdelingenbewaring krachtens het eerste lid, onder b, of het tweede lid duurt in geen geval langer dan vier weken." .

<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=1&artikel=69&lid=5&o=b&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
