        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=27a&lid=2>;
        schema:position  "2";
        cnt:chars        "Overeenkomstig artikel 4, tweede lid, van de Procedureverordening zijn belast met de uitoefening van de daarin opgenomen taken en bevoegdheden:" .

