        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=2&paragraaf=2&artikel=2s&lid=1&o=a>;
        schema:position  "1";
        cnt:chars        "bij de Nederlandse diplomatieke of consulaire vertegenwoordiging in het land van herkomst of van bestendig verblijf dan wel, bij gebreke daarvan, het dichtstbijzijnde land waar wel een vertegenwoordiging is gevestigd, dan wel bij het Kabinet van de Gouverneur van de Nederlandse Antillen of het Kabinet van de Gouverneur van Aruba aldaar, door de vreemdeling, of" .

