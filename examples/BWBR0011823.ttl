        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=32&lid=6>;
        schema:position  "6";
        cnt:chars        "Bij de afsluiting, bedoeld in artikel 66, zesde lid, van de Procedureverordening, vermeldt Onze Minister dat in het dossier van de vreemdeling en vermeldt hij daarbij de rechtsgrond voor die afsluiting." .

