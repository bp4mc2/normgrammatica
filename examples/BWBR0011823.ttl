        schema:position  "1";
        cnt:chars        "de aanvraag tot het verlenen van een EU-verblijfsvergunning voor langdurig ingezetenen in te willigen, af te wijzen dan wel niet in behandeling te nemen;" .

<jci1.3:c:BWBR0011823&hoofdstuk=1c&artikel=2hh>
