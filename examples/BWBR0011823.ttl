<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=1&artikel=14&lid=2&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&hoofdstuk=4&afdeling=1&paragraaf=3&artikel=54&z=2026-10-16&g=2026-10-16>;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=1&artikel=14&lid=2>;
        schema:position  "2";
        cnt:chars        "Onze Minister verleent de houder van een geldige machtiging tot voorlopig verblijf binnen twee weken nadat deze zich overeenkomstig artikel 54, eerste lid, onder e, heeft aangemeld, ambtshalve een verblijfsvergunning voor bepaalde tijd onder dezelfde beperking als die waaronder de machtiging tot voorlopig verblijf is verleend." .

<jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=3&paragraaf=2&artikel=2c&lid=2&z=2026-10-16&g=2026-10-16>
