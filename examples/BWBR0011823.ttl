<jci1.3:c:BWBR0011823&hoofdstuk=6&afdeling=1&artikel=62&lid=2&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=6&afdeling=1&artikel=62&lid=2>;
        schema:position  "2";
        cnt:chars        "Onze Minister kan de voor een vreemdeling geldende termijn, bedoeld in het eerste lid, verkorten, dan wel, in afwijking van het eerste lid, bepalen dat een vreemdeling Nederland onmiddellijk moet verlaten, indien:" .

<jci1.3:c:BWBR0011823&hoofdstuk=6&afdeling=3&artikel=66a&lid=3>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
