        dct:title        "Paragraaf 1. De EU-verblijfsvergunning voor langdurig ingezetenen";
        schema:position  "1" .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=5&artikel=45&lid=1&o=d&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "d.";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=5&artikel=45&lid=1&o=d>;
        schema:position  "4";
        cnt:chars        "de ambtenaren belast met het toezicht op vreemdelingen na ommekomst van de termijn waarbinnen de vreemdeling Nederland uit eigen beweging dient te verlaten, bevoegd zijn elke plaats te betreden, daaronder begrepen een woning zonder toestemming van de bewoner, teneinde de vreemdeling uit te zetten;" .

