<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=94&lid=4&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0005537&artikel=8:42>;
        eli:number       "4";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=94&lid=4>;
        schema:position  "4";
        cnt:chars        "De rechtbank bepaalt onmiddellijk het tijdstip van het onderzoek ter zitting. De rechtbank roept de vreemdeling op om in persoon dan wel in persoon of bij raadsman en Onze Minister om bij gemachtigde te verschijnen teneinde te worden gehoord. In afwijking van artikel 8:42, tweede lid, van de Algemene wet bestuursrecht kan de in dat artikel bedoelde termijn niet worden verlengd." .

<jci1.3:c:BWBR0011823&hoofdstuk=4&afdeling=1&paragraaf=3&artikel=55.0a&lid=3&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
