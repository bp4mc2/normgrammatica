<jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=56&lid=2&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=56&lid=2>;
        schema:position  "2";
        cnt:chars        "Toepassing van het eerste lid blijft achterwege wanneer en wordt beëindigd zodra de vreemdeling te kennen geeft Nederland te willen verlaten en hiertoe voor hem ook gelegenheid bestaat." .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=1&artikel=11&lid=2&o=a&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=1&artikel=8&z=2026-10-16&g=2026-10-16>;
        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=1&artikel=11&lid=2&o=a>;
        schema:position  "1";
        cnt:chars        "rechtmatig verblijf heeft, als bedoeld in artikel 8, onder a, tot en met e en l;" .

<jci1.3:c:BWBR0011823&hoofdstuk=4&afdeling=1&paragraaf=1&artikel=48&lid=3&o=a>
