        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=1a&artikel=107&lid=2&o=d>;
        schema:position  "4";
        cnt:chars        "de Screeningsverordening." .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=1&artikel=9&lid=8&o=a&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=1&artikel=9&lid=8&o=a>;
        schema:position  "1";
        cnt:chars        "de bescheiden, bedoeld in het eerste, zesde en zevende lid, en kan daarbij modellen vaststellen voor de documenten en de schriftelijke verklaring;" .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=32&lid=7&z=2026-10-16&g=2026-10-16>
