        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=1&artikel=1&o=_8>;
        schema:position  "8";
        cnt:chars        "besluit tot buitenbehandelingstelling: een besluit tot het afwijzen van een verzoek als impliciet of expliciet ingetrokken overeenkomstig artikel 36, tweede lid, van de Procedureverordening;" .

<jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=2&artikel=2&lid=5&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "5";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=2&artikel=2&lid=5>;
        schema:position  "5";
        cnt:chars        "Bij algemene maatregel van bestuur worden regels gesteld over de inrichting en de werkwijze van de adviesraad." .

<jci1.3:c:BWBR0011823&hoofdstuk=6&afdeling=3&artikel=66a&lid=6&o=b&z=2026-10-16&g=2026-10-16>
