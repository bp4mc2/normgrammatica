        schema:position  "3";
        cnt:chars        "de gegevens bedoeld in het eerste lid, onderdeel d, in overeenstemming met de desbetreffende verordening, voor zover dit noodzakelijk is in verband met een besluit van Onze Minister en eventuele daarmee samenhangende procedures in rechte;" .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=32&lid=6&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
