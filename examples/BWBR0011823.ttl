        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=30&lid=2>;
        schema:position  "2";
        cnt:chars        "Bij of krachtens algemene maatregel van bestuur kunnen nadere regels worden gesteld over de toepassing van het eerste lid." .

