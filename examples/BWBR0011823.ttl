<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=6&artikel=27&lid=2&o=c&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "c.";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=6&artikel=27&lid=2&o=c>;
        schema:position  "3";
        cnt:chars        "een verblijfsvergunning is ingetrokken of de geldigheidsduur ervan niet is verlengd." .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=29c&lid=2&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=29c&lid=2>;
        schema:position  "2";
        cnt:chars        "De verblijfsvergunning asiel wordt niet geweigerd indien de overschrijding van de in het eerste lid bedoelde termijn op grond van bijzondere omstandigheden objectief verschoonbaar is." .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=1&artikel=14&lid=1&o=a&z=2026-10-16&g=2026-10-16>
