        schema:position  "11";
        cnt:chars        "Bij of krachtens algemene maatregel van bestuur kunnen regels worden gesteld omtrent:" .

<jci1.3:c:BWBR0011823&hoofdstuk=4&afdeling=1&paragraaf=2&artikel=53&lid=1&z=2026-10-16&g=2026-10-16>
