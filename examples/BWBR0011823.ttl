<jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=1&paragraaf=5&artikel=2n&lid=1&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0005537&artikel=4:5>;
