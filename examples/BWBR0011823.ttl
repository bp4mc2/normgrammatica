        schema:position  "5";
        cnt:chars        "de ambtenaren bedoeld in de artikelen 46, eerste lid, en 47, eerste lid." .

<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=2&paragraaf=1&artikel=72&lid=2&z=2026-10-16&g=2026-10-16>
