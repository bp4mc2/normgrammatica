        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=2&artikel=22&lid=1>;
        schema:position  "1";
        cnt:chars        "De verblijfsvergunning voor onbepaalde tijd, bedoeld in artikel 20, kan worden ingetrokken indien:" .

