        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=5&artikel=45&lid=1&o=a>;
        schema:position  "1";
        cnt:chars        "de vreemdeling niet langer rechtmatig in Nederland verblijft tenzij een andere rechtsgrond voor rechtmatig verblijf als bedoeld in artikel 8 van toepassing is;" .

<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=3&paragraaf=1&artikel=79&lid=1&o=d&z=2026-10-16&g=2026-10-16>
