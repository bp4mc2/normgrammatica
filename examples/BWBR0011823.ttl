        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=99&z=2026-10-16&g=2026-10-16>;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=100&lid=1>;
        schema:position  "1";
        cnt:chars        "Op verzoek van de vreemdeling wordt hem een raadsman toegevoegd zodra hem ingevolge deze wet zijn vrijheid is ontnomen. Artikel 99, derde lid, is van overeenkomstige toepassing." .

