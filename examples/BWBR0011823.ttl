        schema:position  "2";
        cnt:chars        "de ambtenaren van de Koninklijke marechaussee;" .

<jci1.3:c:BWBR0011823&hoofdstuk=4&afdeling=1&paragraaf=2&artikel=50&lid=2&o=a&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "a.";
