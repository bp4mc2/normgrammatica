        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=3&paragraaf=1&artikel=2b&lid=2>;
        schema:position  "2";
        cnt:chars        "Onze Minister stelt de gewezen referent in kennis van de beëindiging van diens referentschap." .

