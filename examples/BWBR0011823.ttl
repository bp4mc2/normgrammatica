<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=1&artikel=69&lid=3&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=95&z=2026-10-16&g=2026-10-16> , <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=93&z=2026-10-16&g=2026-10-16> , <jci1.3:c:BWBR0005537&artikel=6:7>;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=1&artikel=69&lid=3>;
        schema:position  "3";
        cnt:chars        "In afwijking van artikel 6:7 van de Algemene wet bestuursrecht is het instellen van beroep als bedoeld in artikel 96 tegen een besluit als bedoeld in artikel 93 niet aan enige termijn gebonden. De termijn voor het instellen van het hoger beroep, bedoeld in artikel 95, bedraagt één week." .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=3&artikel=23&lid=1>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
        dct:isPartOf          <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=3&artikel=23> .

<jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=2&paragraaf=3&artikel=2u&lid=1&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=2&paragraaf=3&artikel=2u&lid=1>;
        schema:position  "1";
        cnt:chars        "Onze Minister beslist binnen 90 dagen na ontvangst van een aanvraag om verlening of wijziging van een machtiging tot voorlopig verblijf. Onze Minister kan deze termijn verlengen met ten hoogste drie maanden." .

<jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=2&paragraaf=1&artikel=2p&z=2026-10-16&g=2026-10-16>
