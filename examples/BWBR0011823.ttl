<jci1.3:c:BWBR0011823&hoofdstuk=4&afdeling=1&paragraaf=2&artikel=50&lid=5&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "5";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=4&afdeling=1&paragraaf=2&artikel=50&lid=5>;
        schema:position  "5";
        cnt:chars        "De ophouding, bedoeld in het tweede lid, onder c, duurt overeenkomstig artikel 8, vierde lid, van de Screeningsverordening, niet langer dan 72 uur." .

<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=101&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=101>;
