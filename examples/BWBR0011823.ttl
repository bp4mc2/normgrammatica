<jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=2&artikel=108&lid=5&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&hoofdstuk=4&afdeling=1&paragraaf=3&artikel=54&z=2026-10-16&g=2026-10-16>;
