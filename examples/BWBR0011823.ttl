        dct:title        "Artikel 2y.";
        schema:position  "3" .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=6&artikel=27&lid=5&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "5";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=6&artikel=27&lid=5>;
        schema:position  "5";
        cnt:chars        "In afwijking van het eerste lid, aanhef, geldt de beschikking waarbij een aanvraag tot het verlenen van een verblijfsvergunning voor bepaalde tijd als bedoeld in artikel 14 of een verblijfsvergunning voor onbepaalde tijd als bedoeld in artikel 20 wordt afgewezen, niet als terugkeerbesluit, indien dat niet in overeenstemming is met de Terugkeerrichtlijn en het beginsel van non-refoulement." .

