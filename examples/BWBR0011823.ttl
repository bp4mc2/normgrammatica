        eli:number       "1°";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=1&artikel=69&lid=2&o=a&o=1>;
        schema:position  "1";
        cnt:chars        "niet in behandeling is genomen op grond van artikel 30;" .

