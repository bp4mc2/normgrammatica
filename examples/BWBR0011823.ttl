        schema:position  "1";
        cnt:chars        "aan een schriftelijke reactie redelijkerwijs geen behoefte bestaat;" .

<jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=1a&artikel=107&lid=1&z=2026-10-16&g=2026-10-16>
