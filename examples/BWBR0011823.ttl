        rdf:type         eli:Expression;
        eli:number       "c.";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=32&lid=5&o=c>;
        schema:position  "3";
        cnt:chars        "de gronden voor verlening, bedoeld in de artikelen 29c of 29d, zijn komen te vervallen;" .

