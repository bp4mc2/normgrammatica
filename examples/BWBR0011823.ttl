        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=4&afdeling=1&paragraaf=3&artikel=55.0a&lid=3>;
        schema:position  "3";
        cnt:chars        "De vreemdeling aan wie een geografisch gebied is toegewezen, kan Onze Minister om toestemming verzoeken om dat gebied tijdelijk te verlaten." .

