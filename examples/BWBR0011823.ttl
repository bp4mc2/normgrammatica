        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=2&paragraaf=3&artikel=2t&lid=1&o=a>;
        schema:position  "1";
        cnt:chars        "Onze Minister die gegevens of bescheiden kan verkrijgen uit bij regeling van Onze Minister aan te wijzen administraties, tenzij hierdoor een goede uitvoering van de wet wordt belet, of" .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=30b&lid=2&o=b&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=30b&lid=2&o=b>;
        schema:position  "2";
        cnt:chars        "artikel 41, eerste en vijfde lid, van de Procedureverordening op het ogenblik waarop de aanvraag impliciet wordt ingetrokken." .

<jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=3&paragraaf=1&artikel=2a&lid=1&o=a&z=2026-10-16&g=2026-10-16>
