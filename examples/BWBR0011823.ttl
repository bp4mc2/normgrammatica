        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=59b&lid=1&o=d>;
        schema:position  "4";
        cnt:chars        "de vreemdeling een gevaar vormt voor de nationale veiligheid of openbare orde als bedoeld in artikel 10, vierde lid, onderdeel f, van de Opvangrichtlijn; of" .

<jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=3&artikel=2y&z=2026-10-16&g=2026-10-16>
