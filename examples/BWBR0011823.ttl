        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=1a&artikel=107&lid=3>;
        schema:position  "3";
        cnt:chars        "Aan een vreemdeling wordt in de vreemdelingenadministratie een uniek vreemdelingennummer toegekend." .

<jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=1a&artikel=107&lid=10>
