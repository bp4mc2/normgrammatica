        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=5&artikel=99&lid=2>;
        schema:position  "2";
        cnt:chars        "Daartoe is ook zijn wettige vertegenwoordiger of zijn bijzondere gemachtigde bevoegd." .

<jci1.3:c:BWBR0011823&hoofdstuk=6&afdeling=4&artikel=67a>
        rdf:type              eli:WorkSubdivision;
