        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45b&lid=2>;
        schema:position  "2";
        cnt:chars        "Onverminderd het eerste lid kan de aanvraag tot het verlenen van een EU-verblijfsvergunning voor langdurig ingezetenen slechts worden afgewezen, indien de vreemdeling:" .

<jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=1&artikel=1&o=3>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Onderdeel>;
        dct:isPartOf          <jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=1&artikel=1&o=_12> .

