<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=1&artikel=70&lid=1&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0005537&artikel=8:24> , <jci1.3:c:BWBR0005537&artikel=2:1>;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=1&artikel=70&lid=1>;
        schema:position  "1";
        cnt:chars        "In afwijking van de artikelen 2:1, tweede en derde lid, en 8:24 van de Algemene wet bestuursrecht wordt het bezwaar, administratief beroep, het beroep op de rechtbank of het hoger beroep ingesteld door de vreemdeling in persoon, zijn wettelijke vertegenwoordiger, zijn bijzondere gemachtigde, zijn referent of een advocaat." .

