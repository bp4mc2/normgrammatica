        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=1&paragraaf=4&artikel=2m&lid=3&o=a>;
        schema:position  "1";
        cnt:chars        "op aanvraag;" .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
