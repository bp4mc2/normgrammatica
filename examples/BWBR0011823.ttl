        dct:title        "Artikel 29d.";
        schema:position  "7" .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=1&artikel=9&lid=3&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=1&artikel=9&lid=3>;
        schema:position  "3";
        cnt:chars        "De geldigheidsduur van de verblijfstitel, bedoeld in het tweede lid, onderdeel a, vangt aan op de datum van verlening van de verblijfsvergunning asiel, bedoeld in artikel 44, tweede lid, en heeft een initiële geldigheidsduur van drie jaar. Wanneer de geldigheidsduur verstrijkt, kan deze met drie jaar worden verlengd." .

