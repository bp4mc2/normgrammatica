<jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=1a&artikel=107&lid=12&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:number       "12";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=8&paragraaf=1a&artikel=107&lid=12>;
        schema:position  "12";
        cnt:chars        "Voor de toepassing van het vierde en zevende lid worden met bestuursorganen gelijkgesteld instellingsbesturen van uit de openbare kas bekostigde instellingen en bevoegde gezagsorganen van uit de openbare kas bekostigde scholen en instellingen." .

<jci1.3:c:BWBR0011823&hoofdstuk=4&afdeling=1&paragraaf=2&artikel=53&lid=2&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&hoofdstuk=5&artikel=59&z=2026-10-16&g=2026-10-16>;
