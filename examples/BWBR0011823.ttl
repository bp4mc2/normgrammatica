<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=1&artikel=9&lid=7&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0005537&artikel=4:3>;
