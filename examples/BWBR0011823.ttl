        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=1b&artikel=2ee&lid=1>;
        schema:position  "1";
        cnt:chars        "De Etias-eenheid is bevoegd een reisautorisatie met beperkte territoriale geldigheid als bedoeld in artikel 44 van de Etias-verordening te verlenen." .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=2&artikel=13&o=b&z=2026-10-16&g=2026-10-16>
