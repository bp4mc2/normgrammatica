<jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=3&paragraaf=1&artikel=2a&lid=2&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=3&paragraaf=1&artikel=14&z=2026-10-16&g=2026-10-16>;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=1&afdeling=3&paragraaf=1&artikel=2a&lid=2>;
        schema:position  "2";
        cnt:chars        "De referent dient ten behoeve van het voorgenomen verblijf op grond van een machtiging tot voorlopig verblijf of het verblijf op grond van een verblijfsvergunning als bedoeld in artikel 14 van een vreemdeling een daartoe strekkende schriftelijke verklaring af te leggen, tenzij hij door Onze Minister als referent is aangewezen." .

<jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=2&paragraaf=1&artikel=2r&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
