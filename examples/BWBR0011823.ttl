        eli:realizes     <jci1.3:c:BWBR0011823&hoofdstuk=6&afdeling=3&artikel=66a&lid=6&o=a>;
        schema:position  "1";
        cnt:chars        "van de vreemdeling die een eerste aanvraag tot het verlenen van een verblijfsvergunning als bedoeld in artikel 28 heeft ingediend, zolang op die aanvraag nog niet is beslist;" .

