        schema:position  "2";
        cnt:chars        "reeds de mogelijkheid van toegang tot de asielprocedure heeft gehad; en" .

<jci1.3:c:BWBR0011823&hoofdstuk=7&afdeling=3&paragraaf=2&artikel=83&lid=7&o=a&z=2026-10-16&g=2026-10-16>
