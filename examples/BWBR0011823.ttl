        schema:position  "3";
        cnt:chars        "de erkende referent zich niet heeft gehouden aan zijn verplichtingen als referent, of" .

<jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=1&artikel=8&o=g&z=2026-10-16&g=2026-10-16>
        rdf:type         eli:Expression;
