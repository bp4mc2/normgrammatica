<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=6&paragraaf=2&artikel=3.127&lid=2&o=a&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&artikel=45c> , <jci1.3:c:BWBR0011823&artikel=9>;
        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=6&paragraaf=2&artikel=3.127&lid=2&o=a>;
        schema:position  "1";
        cnt:chars        "op het document, bedoeld in artikel 9, eerste lid, van de Wet, van de vreemdeling aan wie een EU-verblijfsvergunning voor langdurig ingezetenen is verleend, geen aantekening krachtens artikel 45c, eerste lid, van de Wet is geplaatst, ambtshalve een verblijfsvergunning regulier voor onbepaalde tijd worden verleend, en," .

<jci1.3:c:BWBR0011825&hoofdstuk=2&afdeling=2&artikel=2.4&lid=2&o=c&z=2026-09-25&g=2026-09-25>
