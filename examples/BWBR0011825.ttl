<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=4&artikel=3.89&lid=2&o=b>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Onderdeel>;
        dct:isPartOf          <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=4&artikel=3.89&lid=2> .

<jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=1&artikel=5.4&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=1&artikel=5.4&lid=2>;
        schema:position  "2";
        cnt:chars        "De beslissing op het verzoek om toestemming wordt objectief en onpartijdig genomen op basis van de merites van elk afzonderlijk geval. Bij afwijzing van het verzoek worden de redenen daartoe vermeld in de beslissing." .

<jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=3&paragraaf=1&artikel=1.11&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0021777&artikel=2> , <jci1.3:c:BWBR0021777> , <jci1.3:c:BWBR0011823&artikel=2c>;
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=3&paragraaf=1&artikel=1.11>;
        dct:title        "Artikel 1.11.";
        schema:position  "4";
        cnt:chars        "Ten behoeve van het verblijf van een vreemdeling die in Nederland verblijft of wil verblijven voor het verrichten van onderzoek in de zin van richtlijn (EU) 2016/801, kan als referent optreden de krachtens artikel 2c van de Wet als referent erkende onderzoeksinstelling, waarmee de vreemdeling een gastovereenkomst als bedoeld in artikel 10 van richtlijn (EU) 2016/801 heeft gesloten, die, voor zover op grond van de Handelsregisterwet 2007 vereist, is ingeschreven in het handelsregister, bedoeld in artikel 2 van die wet, en die:" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=4&artikel=3.80a&lid=4>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
        dct:isPartOf          <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=4&artikel=3.80a> .

