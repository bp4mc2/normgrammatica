        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=3&artikel=3.71a&lid=3>;
        schema:position  "3";
        cnt:chars        "Bij ministeriële regeling kunnen nadere regels worden gesteld omtrent de toepassing van het tweede lid, onderdelen a en b, en bij ministeriële regeling kunnen nadere regels worden gesteld omtrent de toepassing van het tweede lid, onderdeel c." .

