        schema:position  "2";
        cnt:chars        "inlichtingen te verstrekken over het doel en de duur van zijn voorgenomen verblijf in Nederland;" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=3&paragraaf=2&artikel=3.96a&lid=2&o=a&z=2026-09-25&g=2026-09-25>
