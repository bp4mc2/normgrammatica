        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=2&afdeling=4&artikel=2.11&lid=2>;
        schema:position  "2";
        cnt:chars        "De zekerheid, bedoeld in het eerste lid, kan bestaan uit:" .

<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=3&artikel=8.29&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=3&artikel=8.29&lid=2>;
        schema:position  "2";
        cnt:chars        "Het wijzigen en vernietigen van de vingerafdrukken in de vreemdelingenadministratie vindt plaats vanuit het bestand, bedoeld in het eerste lid." .

<jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=3&paragraaf=1&artikel=1.16&z=2026-09-25&g=2026-09-25>
