        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=7&artikel=7.2&lid=1&o=b>;
        schema:position  "2";
        cnt:chars        "onmiddellijk voorafgaande aan het tijdstip waarop het rechtmatig verblijf, bedoeld in artikel 8, onder a tot en met e, dan wel l, van de Wet is geëindigd, gedurende twee aaneengesloten jaren dit rechtmatig verblijf heeft gehad;" .

