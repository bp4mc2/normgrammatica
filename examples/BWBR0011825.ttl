<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=3&paragraaf=1&artikel=4.37&lid=1&o=a&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=3&paragraaf=1&artikel=4.37&lid=1&o=a>;
        schema:position  "1";
        cnt:chars        "verandering van adres binnen de gemeente waar de vreemdeling woont of verblijft, hiervan binnen vijf dagen kennis te geven aan Onze Minister;" .

<jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=2>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/unknown/afdeling>;
