<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.19&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&artikel=25> , <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.7&z=2026-09-25&g=2026-09-25>;
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.19>;
        dct:title        "Artikel 8.19.";
        schema:position  "13";
        cnt:chars        "Onze Minister verstrekt de vreemdeling, bedoeld in artikel 8.7 eerste lid, met duurzaam verblijfsrecht op aanvraag en na verificatie van de verblijfsduur een verblijfsdocument, waarvan het model wordt vastgesteld bij ministeriële regeling. Het verblijfsdocument wordt zo spoedig mogelijk verstrekt. Artikel 25 van de Wet is niet van toepassing." .

<jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=2&paragraaf=2&artikel=1.7&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=2&paragraaf=2&artikel=1.7&lid=2>;
        schema:position  "2";
        cnt:chars        "De adviezen vermelden de namen van de personen die ter vergadering aanwezig zijn geweest. Zij vermelden tevens met welke stemmenverhouding zij zijn vastgesteld." .

