        schema:position  "2";
        cnt:chars        "de erkenning als referent, en de schorsing en intrekking van die erkenning;" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=3&artikel=3.71&lid=1&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=3&artikel=3.71&lid=1>;
        schema:position  "1";
        cnt:chars        "De aanvraag tot het verlenen van de verblijfsvergunning regulier voor bepaalde tijd wordt afgewezen, indien de vreemdeling niet beschikt over een geldige machtiging tot voorlopig verblijf." .

