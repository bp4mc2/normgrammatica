        cnt:chars        "of de vreemdeling eerder een aanvraag tot het verlenen van een verblijfsvergunning asiel heeft gedaan;" .

<jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=2&artikel=6.4&lid=4&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=3&paragraaf=1&artikel=1.12&z=2026-09-25&g=2026-09-25>;
