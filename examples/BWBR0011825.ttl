        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=1&artikel=3.1a&lid=2&o=e>;
        schema:position  "5";
        cnt:chars        "ernstige redenen aanwezig zijn om aan te nemen dat de vreemdeling:" .

