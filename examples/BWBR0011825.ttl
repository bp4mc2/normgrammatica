        dct:title        "Artikel 3.3.";
        schema:position  "5" .

<jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=1&artikel=5.1&lid=1&o=a&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=1&artikel=5.1&lid=1&o=a>;
        schema:position  "1";
        cnt:chars        "een verplichting zich bij verblijf in Nederland in een bepaald gedeelte van Nederland te bevinden, of" .

<jci1.3:c:BWBR0011825&hoofdstuk=2&afdeling=1&artikel=2.2a&lid=7>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
