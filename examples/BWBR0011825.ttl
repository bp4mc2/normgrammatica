        eli:number       "5°.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=2&afdeling=1&artikel=2.2a&lid=3&o=a&o=5>;
        schema:position  "5";
        cnt:chars        "het geslacht;" .

<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=2&artikel=4.33&lid=3&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0007149>;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=2&artikel=4.33&lid=3>;
        schema:position  "3";
        cnt:chars        "Uit de aantekening, bedoeld in het eerste en tweede lid, blijkt of het de vreemdeling is toegestaan arbeid te verrichten en of voor deze arbeid ingevolge de Wet arbeid vreemdelingen een tewerkstellingsvergunning of gecombineerde vergunning vereist is." .

<jci1.3:c:BWBR0011825&hoofdstuk=9&artikel=9.13>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Artikel>;
