        schema:position  "6";
        cnt:chars        "Het verblijfsdocument wordt afgegeven met een geldigheidsduur:" .

<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.7&lid=3&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
