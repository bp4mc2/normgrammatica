<jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=3&paragraaf=2&artikel=1.20&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=3&paragraaf=2&artikel=1.20>;
        dct:title        "Artikel 1.20.";
        schema:position  "3";
        cnt:chars        "Als referent van een vreemdeling die in Nederland verblijft of wil verblijven voor studie aan het hoger onderwijs, kan slechts worden erkend de instelling voor hoger onderwijs, die aangesloten is bij de Gedragscode internationale student hoger onderwijs." .

