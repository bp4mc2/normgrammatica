<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=3.98a&lid=8&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "8";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=3.98a&lid=8>;
        schema:position  "8";
        cnt:chars        "De examenprogramma’s, bedoeld in het derde en zesde lid, worden overeenkomstig door Onze Minister van Sociale Zaken en Werkgelegenheid te stellen regels en tegen een door Onze Minister van Sociale Zaken en Werkgelegenheid te stellen bedrag beschikbaar gesteld." .

<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.12&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.12&lid=2>;
        schema:position  "2";
        cnt:chars        "Het rechtmatig verblijf van de vreemdeling, bedoeld in het eerste lid, onder a, eindigt niet om de enkele reden dat die vreemdeling niet langer werknemer of zelfstandige is:" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=3&paragraaf=2&artikel=3.96a&lid=2&o=f&o=1>
        rdf:type              eli:WorkSubdivision;
