        schema:position  "1";
        cnt:chars        "volledig arbeidsongeschikt is en een arbeidsongeschiktheidsuitkering ontvangt, of" .

<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=3&paragraaf=7&artikel=4.52a&lid=2&z=2026-09-25&g=2026-09-25>
