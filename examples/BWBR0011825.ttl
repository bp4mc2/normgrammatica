        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
        dct:isPartOf          <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=3.98c> .

<jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=1&artikel=5.2&lid=1&o=b&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=1&artikel=5.2&lid=1&o=b>;
        schema:position  "2";
        cnt:chars        "vreemdelingen die zijn overgebracht naar Nederland als lidstaat waar zij overeenkomstig artikel 17, vierde lid, van de Asiel- en migratiebeheerverordening verplicht zijn zich te bevinden nadat zij zijn ondergedoken en zich naar een andere lidstaat hebben begeven." .

