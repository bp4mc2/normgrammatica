<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=2&artikel=3.100&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=2&artikel=3.100>;
        dct:title        "Artikel 3.100.";
        schema:position  "4";
        cnt:chars        "Indien de vreemdeling, hangende de besluitvorming op een eerdere aanvraag, wijziging van het gevraagde verblijfsdoel wenst, dient hij een nieuwe aanvraag in." .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=2&artikel=3.63>
