        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=5&paragraaf=2&artikel=3.116&lid=1>;
        schema:position  "1";
        cnt:chars        "Het schriftelijk voornemen om een verblijfsvergunning asiel in te trekken wordt aan de vreemdeling meegedeeld door uitreiking of toezending ervan." .

