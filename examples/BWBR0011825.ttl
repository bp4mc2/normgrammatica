        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=2&artikel=5.6&lid=2&o=r>;
        schema:position  "18";
        cnt:chars        "geen vaste woon- of verblijfplaats heeft;" .

