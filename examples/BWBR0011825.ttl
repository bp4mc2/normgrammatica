        dct:title        "Artikel 1.1.";
        schema:position  "1";
        cnt:chars        "In dit besluit en de daarop berustende bepalingen wordt verstaan onder:" .

<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=3&paragraaf=5&artikel=4.47&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=3&paragraaf=5&artikel=4.47&lid=2>;
        schema:position  "2";
        cnt:chars        "Voor de berekening van de in het eerste lid bedoelde termijn van 90 dagen wordt eerder verblijf in Nederland binnen een tijdvak van 180 dagen, onmiddellijk voorafgaande aan de binnenkomst, mede in aanmerking genomen." .

<jci1.3:c:BWBR0011825&hoofdstuk=2&afdeling=1&artikel=2.2a&lid=3&o=b&o=1>
        rdf:type              eli:WorkSubdivision;
