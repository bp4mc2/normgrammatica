        eli:number       "4";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=3.98c&lid=4>;
        schema:position  "4";
        cnt:chars        "Het resultaat van het basisexamen inburgering wordt in de gevallen waarin Onze Minister van Sociale Zaken en Werkgelegenheid niet door middel van het geautomatiseerde systeem, bedoeld in het tweede lid, tot een beoordeling daarvan heeft kunnen komen, alsmede in het in artikel 3.98d, derde lid, bedoelde geval, beoordeeld door examinatoren." .

