        schema:position  "2";
        cnt:chars        "de vreemdeling houder is van een buitenlands vreemdelingen- of vluchtelingenpaspoort;" .

<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=2&artikel=4.29&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
