<jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=1&artikel=5.3&lid=1&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&artikel=56>;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=1&artikel=5.3&lid=1>;
        schema:position  "1";
        cnt:chars        "De maatregel van beperking van vrijheid van beweging, bedoeld in artikel 56, eerste lid, van de Wet, is evenredig en houdt rekening met de relevante aspecten van de individuele situatie van de vreemdeling." .

<jci1.3:c:BWBR0011825&hoofdstuk=2&afdeling=1&artikel=2.1b&lid=1>
        rdf:type              eli:WorkSubdivision;
