<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.8&lid=1&o=c&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "c.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.8&lid=1&o=c>;
        schema:position  "3";
        cnt:chars        "indien hij om redenen van de openbare orde of openbare veiligheid uit Nederland is verwijderd en sinds de verwijdering nog geen redelijke termijn is verstreken." .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=4&artikel=3.86&lid=3>
