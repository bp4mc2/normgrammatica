        dct:isPartOf          <jci1.3:c:BWBR0011825&hoofdstuk=2&afdeling=1&artikel=2.2a&lid=3&o=a> .

<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=1&artikel=8.6&lid=4&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&artikel=21>;
        eli:number       "4";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=1&artikel=8.6&lid=4>;
        schema:position  "4";
        cnt:chars        "In afwijking van artikel 21 van de Wet, kan de verblijfsvergunning regulier voor onbepaalde tijd die is verleend aan de vreemdeling, bedoeld in het eerste lid, slechts worden ingetrokken op de in het derde lid, onder a, bedoelde grond." .

