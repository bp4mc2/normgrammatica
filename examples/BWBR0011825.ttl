        schema:position  "3";
        cnt:chars        "hij in het bezit is van een geldig document voor grensoverschrijding en reisbiljetten op grond waarvan zijn doorreis naar en zijn toegang tot het land van bestemming vaststaat, en" .

<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=3&paragraaf=6&artikel=4.51&lid=1&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&artikel=54>;
