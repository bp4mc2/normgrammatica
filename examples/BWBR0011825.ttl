        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=2&artikel=4.22&lid=1&o=a>;
        schema:position  "1";
        cnt:chars        "de vreemdeling aan wie het document werd afgegeven, overeenkomstig artikel 4.44 aangifte heeft gedaan van vermissing, verlies of het voor identificatie ondeugdelijk worden van dat document, en" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=3&artikel=3.103ab&lid=2&o=b&z=2026-09-25&g=2026-09-25>
