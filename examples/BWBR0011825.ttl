<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=2&artikel=4.23&lid=1&o=b&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&artikel=50>;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=2&artikel=4.23&lid=1&o=b>;
        schema:position  "2";
        cnt:chars        "indien de persoon ter vaststelling van zijn identiteit is staande gehouden en niet aanstonds blijkt dat het hem is toegestaan in Nederland te verblijven, terwijl de gelegenheid ontbreekt hem, met toepassing van artikel 50, tweede of derde lid, van de Wet naar een plaats, bestemd voor verhoor, over te brengen;" .

<jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=4&artikel=6.6&lid=4&o=b&z=2026-09-25&g=2026-09-25>
