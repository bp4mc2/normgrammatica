        schema:position  "6";
        cnt:chars        "Bij ministeriële regeling kunnen regels worden gesteld omtrent de afwijzing van de aanvraag om wijziging van de verblijfsvergunning in andere gevallen dan bedoeld in het eerste lid, en omtrent de toepassing van het tweede lid, onder e, het derde lid en het vijfde lid." .

<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=3&artikel=8.36&o=c&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&artikel=107>;
        eli:number       "c.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=3&artikel=8.36&o=c>;
        schema:position  "3";
        cnt:chars        "de wijze waarop de gezichtsopnames en vingerafdrukken, op grond van artikel 107, vijfde lid, van de Wet beschikbaar worden gesteld;" .

<jci1.3:c:BWBR0011825&hoofdstuk=2&afdeling=4&artikel=2.11&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
