        schema:position  "2";
        cnt:chars        "verandering van woon- of verblijfplaats binnen Nederland, onder opgave van het nieuwe adres, hiervan binnen vijf dagen na aankomst in de nieuwe woon- of verblijfplaats in persoon kennis te geven aan Onze Minister;" .

<jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=3&artikel=6.5a&lid=4&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
