<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.17&lid=8&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.7&z=2026-09-25&g=2026-09-25>;
        eli:number       "8";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.17&lid=8>;
        schema:position  "8";
        cnt:chars        "De bij hem in Nederland verblijvende familieleden van de werknemer of zelfstandige hebben duurzaam verblijfsrecht, indien de werknemer of zelfstandige een nationaliteit als bedoeld in artikel 8.7, eerste lid, bezit en:" .

<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=3&artikel=8.26&o=m>
