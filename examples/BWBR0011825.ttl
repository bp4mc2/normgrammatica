        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=3&artikel=3.103ab&lid=2&o=b>;
        schema:position  "2";
        cnt:chars        "de vreemdeling bij onherroepelijk geworden rechterlijk vonnis veroordeeld is voor een bijzonder ernstig misdrijf en een gevaar vormt voor de samenleving." .

<jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=2&artikel=5.6&lid=2&o=f>
