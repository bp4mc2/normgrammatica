<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=6&paragraaf=1&artikel=3.124&lid=2&o=d&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "d.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=6&paragraaf=1&artikel=3.124&lid=2&o=d>;
        schema:position  "4";
        cnt:chars        "als houder van een Europese blauwe kaart in de periode van vijf jaar niet langer dan twaalf achtereenvolgende maanden en in totaal niet langer dan achttien maanden buiten Nederland heeft verbleven." .

<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=3&paragraaf=7&artikel=4.52b&lid=1>
        rdf:type              eli:WorkSubdivision;
