<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=4&artikel=3.86&lid=17&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "17";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=4&artikel=3.86&lid=17>;
        schema:position  "17";
        cnt:chars        "De aanvraag wordt niet afgewezen, indien uitzetting van de vreemdeling in strijd zou zijn met artikel 8 van het Verdrag tot bescherming van de rechten van de mens en de fundamentele vrijheden." .

<jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=3&artikel=6.5a&lid=4&o=a>
