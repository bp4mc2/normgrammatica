        schema:position  "2";
        cnt:chars        "de nakoming van zijn verplichtingen als referent, en" .

<jci1.3:c:BWBR0011825&hoofdstuk=1a&paragraaf=3&artikel=1.29&lid=1>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
