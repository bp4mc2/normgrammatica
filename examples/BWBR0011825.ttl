        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.13&lid=3>;
        schema:position  "3";
        cnt:chars        "Bij de indiening van de aanvraag legt de vreemdeling over:" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=3&artikel=3.102&lid=4>
        rdf:type              eli:WorkSubdivision;
