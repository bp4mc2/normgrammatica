<jci1.3:c:BWBR0011825&hoofdstuk=2&afdeling=1&artikel=2.1b&lid=1&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&artikel=8> , <jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=1&artikel=1.3&z=2026-09-25&g=2026-09-25>;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=2&afdeling=1&artikel=2.1b&lid=1>;
        schema:position  "1";
        cnt:chars        "De toegang wordt niet geweigerd indien de vreemdeling van een andere staat als bedoeld in artikel 1.3 het bevel heeft gekregen onmiddellijk naar Nederland terug te keren, en hij op dat moment rechtmatig verblijf als bedoeld in artikel 8 van de Wet had." .

<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=1&artikel=8.6&lid=1&o=b&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=1&artikel=8.6&lid=1&o=b>;
        schema:position  "2";
        cnt:chars        "niet over voldoende middelen van bestaan beschikt." .

