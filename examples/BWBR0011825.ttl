        rdf:type         eli:Expression;
        eli:cites        <file:///Users/marcobrattinga/GITREPO/normgrammatica/examples/onbekend>;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=2&artikel=3.101a&lid=1>;
        schema:position  "1";
        cnt:chars        "Indien de eerste aanvraag tot het verlenen van een verblijfsvergunning regulier voor bepaalde tijd is afgewezen, wordt iedere daarop volgende aanvraag tot het verlenen van een dergelijke verblijfsvergunning voor hetzelfde verblijfsdoel aangemerkt als een tweede of volgende aanvraag in de zin van de rijen A75, A76, A77, A78, A79 en A80 van de bijlage bij het Besluit vergoedingen rechtsbijstand 2000." .

