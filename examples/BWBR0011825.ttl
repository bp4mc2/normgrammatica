        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=3&artikel=6.5b&lid=3&o=c>;
        schema:position  "3";
        cnt:chars        "een overzicht van de plaatsen waar de vreemdeling sinds zijn inreisverbod heeft verbleven, voorzien van bewijsstukken;" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=1&artikel=3.1a&lid=2&o=e&z=2026-09-25&g=2026-09-25>
