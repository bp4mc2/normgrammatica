        eli:cites        <jci1.3:c:BWBR0011823&artikel=8>;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=3&paragraaf=7&artikel=4.52a&lid=2&o=b>;
        schema:position  "2";
        cnt:chars        "zolang de vreemdeling rechtmatig verblijf heeft als bedoeld in artikel 8, onder h of j, van de Wet; of" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=3&artikel=3.71&lid=3&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=3&artikel=3.71&lid=3>;
        schema:position  "3";
        cnt:chars        "Onze Minister kan het eerste lid buiten toepassing laten, voorzover toepassing daarvan naar zijn oordeel zal leiden tot een onbillijkheid van overwegende aard." .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=3&artikel=3.102b&lid=1>
        rdf:type              eli:WorkSubdivision;
