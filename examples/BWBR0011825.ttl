        dct:isPartOf          <jci1.3:c:BWBR0011825&hoofdstuk=2&afdeling=1&artikel=2.2a&lid=3> .

<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=2&artikel=4.31&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0007149>;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=2&artikel=4.31&lid=2>;
        schema:position  "2";
        cnt:chars        "Uit de aantekening blijkt of het de vreemdeling is toegestaan arbeid te verrichten en of voor deze arbeid ingevolge de Wet arbeid vreemdelingen een tewerkstellingsvergunning of gecombineerde vergunning vereist is." .

