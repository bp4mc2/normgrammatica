        rdf:type         eli:Expression;
        eli:number       "g.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=3&artikel=3.71&lid=2&o=g>;
        schema:position  "7";
        cnt:chars        "die in Nederland verblijft, bij de rechtbank Den Haag een verzoek heeft ingediend tot vaststelling van zijn Nederlanderschap dat naar het oordeel van Onze Minister niet klaarblijkelijk van elke grond ontbloot is;" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=6&paragraaf=3&artikel=3.129&lid=4&z=2026-09-25&g=2026-09-25>
