        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=1a&paragraaf=3&artikel=1.31&o=b>;
        schema:position  "2";
        cnt:chars        "het zich laten fotograferen en het laten afnemen van vingerafdrukken." .

