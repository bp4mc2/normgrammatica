        schema:position  "1";
        cnt:chars        "de vreemdeling wiens referent hij is of was;" .

<jci1.3:c:BWBR0011825&hoofdstuk=4&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
