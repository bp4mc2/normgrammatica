<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.12&lid=2&o=b&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.12&lid=2&o=b>;
        schema:position  "2";
        cnt:chars        "indien hij na werkzaamheden als werknemer of zelfstandige van ten minste een jaar onvrijwillig werkloos is en als werkzoekende bij het Uitvoeringsinstituut werknemersverzekeringen is ingeschreven;" .

