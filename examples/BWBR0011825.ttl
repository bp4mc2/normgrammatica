<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=4&artikel=3.86&lid=9&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "9";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=4&artikel=3.86&lid=9>;
        schema:position  "9";
        cnt:chars        "In afwijking van de voorgaande leden wordt de aanvraag niet afgewezen, indien de vreemdeling minderjarig is en één van zijn ouders met de Nederlandse nationaliteit in Nederland is gevestigd." .

<jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=3&paragraaf=1&artikel=1.13&o=e&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0005904>;
        eli:number       "e.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=3&paragraaf=1&artikel=1.13&o=e>;
        schema:position  "5";
        cnt:chars        "opleidingsactiviteiten faciliteert in het kader van de Wet op het specifiek cultuurbeleid." .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=2&artikel=3.99a&o=c&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=1&sub-paragraaf=5&artikel=3.48&z=2026-09-25&g=2026-09-25>;
        eli:number       "c.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=2&artikel=3.99a&o=c>;
        schema:position  "3";
        cnt:chars        "het verlenen van een verblijfsvergunning onder een beperking verband houdend met tijdelijke humanitaire gronden als bedoeld in artikel 3.48, tweede lid." .

<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=1&paragraaf=2&artikel=4.6&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=1&paragraaf=2&artikel=4.6>;
        dct:title        "Artikel 4.6.";
        schema:position  "3";
        cnt:chars        "Een ieder die zich op of nabij een plaats bevindt waar een grensdoorlaatpost is gevestigd, houdt zich aan de aldaar door de ambtenaren, belast met de grensbewaking, in het kader van de uitoefening van hun taak gegeven aanwijzingen." .

<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=2&artikel=4.21&lid=1&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
