<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.8&lid=4&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "4";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.8&lid=4>;
        schema:position  "4";
        cnt:chars        "Een vreemdeling die niet beschikt over het vereiste document voor grensoverschrijding, wordt niet uitgezet dan nadat hem gedurende een redelijke termijn de gelegenheid is gegeven dat document te verkrijgen of op andere wijze te laten vaststellen of bewijzen dat hij het recht op vrij verkeer en verblijf geniet." .

<jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=1&artikel=1.1&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
