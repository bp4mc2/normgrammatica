        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=1&artikel=1.1&o=_20>;
        schema:position  "20";
        cnt:chars        "staatloze: de persoon die voor de toepassing van het op 28 september 1954 te New York gesloten verdrag betreffende de status van staatlozen (Trb. 1955, 42 en 1957, 22) als staatloze geldt;" .

<jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=2&artikel=5.7&lid=3&o=d&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
