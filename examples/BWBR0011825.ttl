        schema:position  "3";
        cnt:chars        "een document waaruit de familierechtelijke relatie of duurzame relatie blijkt met de vreemdeling, bedoeld onder b; en" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=3&artikel=3.77&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
