<jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=4&artikel=6.6&lid=1&o=a&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=4&artikel=6.6&lid=1&o=a>;
        schema:position  "1";
        cnt:chars        "indien hij ongewenst is verklaard wegens een geweldsdelict, een opiumdelict of een misdrijf waartegen een gevangenisstraf van meer dan zes jaren is bedreigd, na de ongewenstverklaring ten minste tien achtereenvolgende jaren buiten Nederland heeft verbleven;" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=2>;
