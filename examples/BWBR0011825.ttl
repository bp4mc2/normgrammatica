        schema:position  "5";
        cnt:chars        "de Minister van Binnenlandse Zaken en Koninkrijksrelaties, voor zover deze is belast met de uitvoering van de Wet basisregistratie personen;" .

<jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=2&artikel=5.6&lid=2&o=h&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "h.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=2&artikel=5.6&lid=2&o=h>;
        schema:position  "8";
        cnt:chars        "heeft te kennen gegeven dat hij geen gevolg zal geven aan zijn verplichting tot terugkeer;" .

<jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=1&artikel=5.1&lid=3>
        rdf:type              eli:WorkSubdivision;
