<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.12&lid=1&o=b&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "b.";
