<jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=2&artikel=5.11&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&artikel=58> , <jci1.3:c:BWBR0011823&artikel=6>;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=2&artikel=5.11&lid=2>;
        schema:position  "2";
        cnt:chars        "Indien de tenuitvoerlegging van de vreemdelingenbewaring een aanvang neemt op een politiebureau of in een cel van de Koninklijke marechaussee, wordt zodra dit redelijkerwijs mogelijk is de tenuitvoerlegging voortgezet in een huis van bewaring of een ruimte of plaats als bedoeld in artikel 6, tweede lid of artikel 58, eerste lid, van de Wet." .

<jci1.3:c:BWBR0011825&hoofdstuk=2&afdeling=1&artikel=2.2a&lid=2>
