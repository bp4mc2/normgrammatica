        dct:title        "Artikel 1.28.";
        schema:position  "5";
        cnt:chars        "Een terugkeervisum wordt niet geweigerd op de in artikel 2x, eerste lid, onder a, van de Wet bedoelde grond aan:" .

<jci1.3:c:BWBR0011825&hoofdstuk=2&afdeling=4&artikel=2.11&lid=2&o=d&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
