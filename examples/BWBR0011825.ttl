        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.24&lid=1&o=c>;
        schema:position  "3";
        cnt:chars        "gebaseerd is op dwingende redenen van openbare veiligheid." .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=5&paragraaf=2&artikel=3.109c&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=5&paragraaf=2&artikel=3.109c>;
        dct:title        "Artikel 3.109c.";
        schema:position  "10";
        cnt:chars        "Indien de vreemdeling zich tijdens het gehoor laat bijstaan door een juridisch adviseur, mag de juridisch adviseur pas aan het einde van het gehoor interveniëren." .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=3&artikel=3.77&lid=9&o=b&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=3&artikel=3.77&lid=9&o=b>;
        schema:position  "2";
        cnt:chars        "die huiselijk geweld heeft ondervonden van de persoon bij wie eerder verblijf was toegestaan;" .

<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=2&artikel=4.33&lid=3>
