        schema:position  "3";
        cnt:chars        "de maatregelen die in geval van onregelmatigheden of ordeverstoring kunnen worden getroffen." .

<jci1.3:c:BWBR0011825&hoofdstuk=2&afdeling=1&artikel=2.2&lid=3&o=g&z=2026-09-25&g=2026-09-25>
