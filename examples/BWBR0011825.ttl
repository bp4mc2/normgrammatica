<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=3&artikel=3.103a&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=3&artikel=3.103a&lid=2>;
        schema:position  "2";
        cnt:chars        "Het eerste lid is van overeenkomstige toepassing indien Onze Minister besluit de verblijfsvergunning van de in het eerste lid bedoelde houder in te trekken of niet te verlengen." .

<jci1.3:c:BWBR0011825&hoofdstuk=1a&paragraaf=2&artikel=1.27&lid=1&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011825&hoofdstuk=1a&paragraaf=2&artikel=1.24&z=2026-09-25&g=2026-09-25>;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=1a&paragraaf=2&artikel=1.27&lid=1>;
        schema:position  "1";
        cnt:chars        "De aanvraag, bedoeld in artikel 1.24, eerste lid, wordt getoetst aan het recht dat gold op het tijdstip waarop de aanvraag is ontvangen, tenzij uit de Wet anders voortvloeit of het recht dat geldt op het tijdstip waarop de beschikking wordt gegeven, voor de vreemdeling gunstiger is." .

<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.15&lid=2&o=a&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.15&lid=2&o=a>;
        schema:position  "1";
        cnt:chars        "indien hij ten minste een jaar voor het overlijden van die vreemdeling in Nederland verbleef;" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=4&artikel=3.82&lid=2&o=b&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=4&artikel=3.82&lid=2&o=b>;
        schema:position  "2";
        cnt:chars        "onjuiste gegevens heeft verstrekt dan wel gegevens heeft achtergehouden, terwijl die gegevens tot afwijzing van de oorspronkelijke aanvraag tot het verlenen of verlengen zouden hebben geleid, of" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=3&artikel=3.103aa&lid=3&o=b>
        rdf:type              eli:WorkSubdivision;
