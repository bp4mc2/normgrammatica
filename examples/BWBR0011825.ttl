        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=4&artikel=3.87a&lid=3>;
        schema:position  "3";
        cnt:chars        "Bij ministeriële regeling kunnen regels worden gesteld omtrent de toepassing van het eerste lid, onder a, en het tweede lid." .

<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.17&lid=2&o=d>
        rdf:type              eli:WorkSubdivision;
