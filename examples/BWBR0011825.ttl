<jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=1&artikel=5.2&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=2&artikel=5.6&z=2026-09-25&g=2026-09-25>;
