<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=6&paragraaf=1&artikel=3.124&lid=3&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=6&paragraaf=1&artikel=3.124&lid=3>;
        schema:position  "3";
        cnt:chars        "In de gevallen, bedoeld in het eerste lid, wordt bij de berekening van het tijdvak van vijf jaar buiten beschouwing gelaten het gedeelte van het verblijf buiten Nederland, dat tien maanden in totaal of bij aaneengesloten verblijf buiten Nederland zes maanden te boven gaat." .

