        schema:position  "1";
        cnt:chars        "minderjarig is of de pensioengerechtigde leeftijd, bedoeld in artikel 7a, eerste lid, van de Algemene Ouderdomswet, heeft bereikt;" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=6&paragraaf=3&artikel=3.129>
        rdf:type              eli:WorkSubdivision;
