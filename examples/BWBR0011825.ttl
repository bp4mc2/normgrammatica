<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=3&artikel=3.71&lid=2&o=f&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "f.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=3&artikel=3.71&lid=2&o=f>;
        schema:position  "6";
        cnt:chars        "die in aanmerking komt voor de verblijfsvergunning regulier voor bepaalde tijd onder een beperking verband houdend met grensoverschrijdende dienstverlening;" .

<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=1&artikel=8.2a&lid=2&o=b>
