        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Onderdeel>;
        dct:isPartOf          <jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=2&artikel=5.6&lid=2> .

<jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=3&artikel=6.5&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=3&artikel=6.5&lid=2>;
        schema:position  "2";
        cnt:chars        "Tegen een vreemdeling wordt geen inreisverbod uitgevaardigd, indien deze:" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=3&paragraaf=1&artikel=3.92&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&artikel=21>;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=3&paragraaf=1&artikel=3.92&lid=2>;
        schema:position  "2";
        cnt:chars        "De aanvraag wordt niet afgewezen op grond van artikel 21, eerste lid, onder a, e of f, van de Wet." .

<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=1&artikel=8.2a&lid=1&o=a&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0044770> , <jci1.3:c:BWBR0020611> , <jci1.3:c:BWBR0015703> , <jci1.3:c:BWBR0033715>;
        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=1&artikel=8.2a&lid=1&o=a>;
        schema:position  "1";
        cnt:chars        "de colleges van burgemeester en wethouders, voor zover deze zijn belast met de uitvoering van de Wet basisregistratie personen, de Participatiewet en aanverwante inkomensvoorzieningswetten, de Wet inburgering en de Wet inburgering 2021;" .

<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=2&artikel=4.25>
        rdf:type              eli:WorkSubdivision;
