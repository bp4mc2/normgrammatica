        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=1&artikel=6.1d>;
        dct:title        "Artikel 6.1d.";
        schema:position  "5" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=2&artikel=3.57&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=2&artikel=3.57&lid=2>;
        schema:position  "2";
        cnt:chars        "In afwijking van het eerste lid, kan de verblijfsvergunning worden verleend met ingang van de dag die bij de afgifte van de machtiging tot voorlopig verblijf is opgegeven als de dag waarop de vreemdeling Nederland zal inreizen." .

<jci1.3:c:BWBR0011825&hoofdstuk=2&afdeling=1&artikel=2.2a&lid=3&o=a&o=6&z=2026-09-25&g=2026-09-25>
