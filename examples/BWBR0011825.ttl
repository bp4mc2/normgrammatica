<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.13&lid=6&o=b&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.13&lid=6&o=b>;
        schema:position  "2";
        cnt:chars        "van vijf jaar in de overige gevallen." .

<jci1.3:c:BWBR0011825&hoofdstuk=2&afdeling=1&artikel=2.2a&lid=4&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "4";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=2&afdeling=1&artikel=2.2a&lid=4>;
        schema:position  "4";
        cnt:chars        "Bij ministeriële regeling kunnen gevallen worden aangewezen waarin vervoerders verplicht zijn de in het derde lid bedoelde passagiersgegevens te verzamelen en te verstrekken zonder vordering daartoe. Daarbij kunnen nadere regels worden gesteld met betrekking tot de vorm waarin de in het derde lid genoemde gegevens worden verstrekt." .

<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=1&paragraaf=2&artikel=4.5&lid=1&o=a&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=1&paragraaf=2&artikel=4.5&lid=1&o=a>;
        schema:position  "1";
        cnt:chars        "het in zijn bezit zijnde document voor grensoverschrijding, de benodigde machtiging tot voorlopig verblijf dan wel het benodigde reisvisum of doorreisvisum te tonen en te overhandigen;" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=6&paragraaf=1&artikel=3.125&lid=3>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
