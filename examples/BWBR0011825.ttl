        eli:cites        <jci1.3:c:BWBR0011823&artikel=8>;
        eli:number       "2°.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=3&paragraaf=2&artikel=3.96a&lid=2&o=f&o=2>;
        schema:position  "2";
        cnt:chars        "voor het negentiende levensjaar vijf jaren rechtmatig in Nederland heeft verbleven als bedoeld in artikel 8, onder a, b dan wel l, van de Wet, en voor wie Nederland naar het oordeel van Onze Minister het meest aangewezen land is;" .

