        schema:position  "3";
        cnt:chars        "inkomensvervangende uitkeringen krachtens een sociale verzekeringswet waarvoor premies zijn afgedragen;" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=5&paragraaf=2&artikel=3.116&lid=1&z=2026-09-25&g=2026-09-25>
