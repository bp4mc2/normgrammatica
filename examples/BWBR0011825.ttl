<jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=2&artikel=5.6&lid=2&o=j&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "j.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=2&artikel=5.6&lid=2&o=j>;
        schema:position  "10";
        cnt:chars        "een aanvraag voor het verlenen van een verblijfsvergunning asiel heeft ingediend die niet-ontvankelijk is verklaard of is afgewezen als kennelijk ongegrond;" .

<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.7&lid=2&o=d&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "d.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.7&lid=2&o=d>;
        schema:position  "4";
        cnt:chars        "de rechtstreekse bloedverwant in opgaande lijn die ten laste is van de vreemdeling of van het gezinslid, bedoeld onder a of b." .

<jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=3&paragraaf=2&artikel=1.19&lid=2>
