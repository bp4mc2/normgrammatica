        schema:position  "5";
        cnt:chars        "vertrek of uitzetting uit Nederland;" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=3.98b&lid=4&o=c&z=2026-09-25&g=2026-09-25>
