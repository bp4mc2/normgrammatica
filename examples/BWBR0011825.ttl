<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=3&paragraaf=1&artikel=3.92&lid=1&o=a&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&artikel=8>;
