<jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=3&paragraaf=1&artikel=1.10&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0021777&artikel=2> , <jci1.3:c:BWBR0021777>;
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=3&paragraaf=1&artikel=1.10>;
        dct:title        "Artikel 1.10.";
        schema:position  "3";
        cnt:chars        "Ten behoeve van het verblijf van een vreemdeling die in Nederland verblijft of wil verblijven voor het verrichten van seizoenarbeid of arbeid in loondienst, kan als referentoptreden de werkgever, die, voor zover op grond van de Handelsregisterwet 2007 vereist, is ingeschreven in het handelsregister, bedoeld in artikel 2 van die wet, en die:" .

