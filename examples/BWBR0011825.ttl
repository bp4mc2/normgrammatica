        eli:cites        <jci1.3:c:BWBR0011823&artikel=8>;
        eli:number       "k.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=3&artikel=3.71&lid=2&o=k>;
        schema:position  "11";
        cnt:chars        "die minderjarig is, schoolgaand is en drie jaar ononderbroken hoofdverblijf in Nederland heeft en een aanvraag heeft ingediend tot het verlenen van een verblijfsvergunning regulier voor bepaalde tijd onder een beperking verband houdend met gezinshereniging bij een Nederlander of een hoofdpersoon met rechtmatig verblijf, als bedoeld in artikel 8, onder a tot en met e dan wel l, van de Wet;" .

