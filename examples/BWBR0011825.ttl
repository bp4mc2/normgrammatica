        dct:isPartOf          <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=1&artikel=3.98b> .

<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.12&lid=1&o=f&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.7&z=2026-09-25&g=2026-09-25>;
        eli:number       "f.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.12&lid=1&o=f>;
        schema:position  "6";
        cnt:chars        "familielid is als bedoeld in artikel 8.7, derde lid, en hij in het land van herkomst ten laste is van of inwoont bij een vreemdeling als bedoeld in het eerste lid, onder a, b of c;" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=5&paragraaf=2&artikel=3.108d&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&artikel=106a>;
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=5&paragraaf=2&artikel=3.108d>;
        dct:title        "Artikel 3.108d.";
        schema:position  "6";
        cnt:chars        "De vreemdeling werkt mee aan het maken van een gezichtsopname en de afname van vingerafdrukken op grond van artikel 106a van de Wet." .

<jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=2&artikel=5.5&lid=3&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&artikel=6>;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=2&artikel=5.5&lid=3>;
        schema:position  "3";
        cnt:chars        "Het eerste lid is van overeenkomstige toepassing in geval van oplegging van de vrijheidsontnemende maatregel op grond van artikel 6, zesde lid, van de Wet." .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=3&artikel=3.77&lid=7>
