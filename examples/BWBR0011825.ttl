        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=1&paragraaf=3&artikel=4.9&o=b>;
        schema:position  "2";
        cnt:chars        "het toelaten van ambtenaren, belast met de grensbewaking, aan boord van zijn schip;" .

