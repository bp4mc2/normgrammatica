        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=2&afdeling=1&artikel=2.2a&lid=3&o=a&o=6>;
        schema:position  "6";
        cnt:chars        "de staat van afgifte van het reisdocument;" .

