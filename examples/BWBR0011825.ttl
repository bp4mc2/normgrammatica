<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=2&artikel=4.22&lid=1&o=b&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=2&artikel=4.22&lid=1&o=b>;
        schema:position  "2";
        cnt:chars        "Onze Minister heeft vastgesteld dat er gegronde redenen zijn om te veronderstellen dat de aangifte naar waarheid is gedaan." .

