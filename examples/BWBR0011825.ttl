<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=4&artikel=3.80a&lid=5&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "5";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=4&artikel=3.80a&lid=5>;
        schema:position  "5";
        cnt:chars        "Onze Minister kan het eerste lid voorts buiten toepassing laten, indien hij van oordeel is dat de vreemdeling aantoonbaar voldoende is ingeburgerd." .

<jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=2&artikel=5.8&lid=2>
