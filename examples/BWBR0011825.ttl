        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=2&artikel=5.7&lid=3&o=d>;
        schema:position  "4";
        cnt:chars        "of de vreemdeling in het Schengeninformatiesysteem ter zake van een inreisverbod gesignaleerd staat;" .

<jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=2&artikel=6.4&lid=4>
