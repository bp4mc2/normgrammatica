<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=6&paragraaf=2&artikel=3.127&lid=1&o=d&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "d.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=6&paragraaf=2&artikel=3.127&lid=1&o=d>;
        schema:position  "4";
        cnt:chars        "voormalig houder van een Europese blauwe kaart is, dan wel het gezinslid van een voormalig houder van een Europese blauwe kaart is, en niet langer dan een aaneengesloten periode van 24 maanden heeft verbleven buiten het Schengengebied." .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=5&artikel=3.91b&lid=2>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
        dct:isPartOf          <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=5&artikel=3.91b> .

<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=1&paragraaf=1&artikel=4.2&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=1&paragraaf=1&artikel=4.2&lid=2>;
        schema:position  "2";
        cnt:chars        "Bij ministeriële regeling worden de plaatsen aangewezen waar grensdoorlaatposten, al dan niet tijdelijk, zijn gevestigd." .

<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=1&artikel=8.2a&lid=1&o=g&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0024705&artikel=17>;
        eli:number       "g.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=1&artikel=8.2a&lid=1&o=g>;
        schema:position  "7";
        cnt:chars        "de Gemeentelijke gezondheidsdienst, bedoeld in artikel 17 van de Wet publieke gezondheid;" .

<jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=2&artikel=5.9&lid=1>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
