<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=1&artikel=8.6&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=1&artikel=8.6&lid=2>;
        schema:position  "2";
        cnt:chars        "De aanvraag tot het verlengen van de geldigheidsduur van de verblijfsvergunning regulier voor bepaalde tijd die is ingediend door de in het eerste lid bedoelde vreemdeling, wordt niet afgewezen, en de verblijfsvergunning wordt niet ingetrokken, op grond van de omstandigheid dat de vreemdeling niet meer over voldoende middelen van bestaan beschikt." .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=1&artikel=3.3&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
