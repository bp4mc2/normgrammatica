        eli:cites        <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=6&paragraaf=3&artikel=3.129&z=2026-09-25&g=2026-09-25> , <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=5&paragraaf=2&artikel=3.123&z=2026-09-25&g=2026-09-25> , <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=3&artikel=3.103aa&z=2026-09-25&g=2026-09-25> , <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=4&paragraaf=3&artikel=3.103a&z=2026-09-25&g=2026-09-25>;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=6&paragraaf=3&artikel=3.130&lid=3>;
        schema:position  "3";
        cnt:chars        "Onze Minister vormt het contactpunt dat door een andere lidstaat van de Europese Unie kan worden geraadpleegd, ter uitvoering van de richtlijn langdurig ingezetenen en de richtlijn 2009/50/EG, en is verantwoordelijk voor het door Nederland ontvangen en toezenden van de informatie, bedoeld in de artikelen 3.103a, 3.103aa, eerste lid, 3.123 en 3.129." .

