        dct:title        "Paragraaf 1. Verlening";
        schema:position  "1" .

<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=2&artikel=4.17a&lid=1&o=b&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=2&artikel=4.17a&lid=1&o=b>;
        schema:position  "2";
        cnt:chars        "in treinen gedurende ten hoogste dertig minuten na het passeren van de gemeenschappelijke landgrens met België of Duitsland of, als binnen deze periode het tweede station na het passeren van de grens nog niet is bereikt, tot uiterlijk het tweede station na het passeren van de grens;" .

<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=3&artikel=8.30&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=3&artikel=8.30&lid=2>;
        schema:position  "2";
        cnt:chars        "De vreemdeling van wie de vingers niet blijvend fysiek beschadigd zijn, wordt uitgenodigd om op een bij ministeriële regeling bepaald moment opnieuw zijn vingerafdrukken af te laten nemen." .

