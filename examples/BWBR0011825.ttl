        eli:number       "n.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=3&artikel=8.26&o=n>;
        schema:position  "14";
        cnt:chars        "het Associatieakkoord tussen de Europese Unie en de Europese Gemeenschap voor Atoomenergie en haar lidstaten, enerzijds, en Georgië, anderzijds (Trb. 2014, 210);" .

