<jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=2&artikel=6.3&lid=1&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011823&artikel=65>;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=2&artikel=6.3&lid=1>;
        schema:position  "1";
        cnt:chars        "De kosten van uitzetting van een vreemdeling welke ingevolge artikel 65, tweede lid, van de Wet op een vervoersonderneming kunnen worden verhaald, zijn verschuldigd aan het openbaar lichaam te welks laste die kosten zijn gekomen." .

<jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=1&artikel=1.1&o=_24&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
