        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=3&paragraaf=6&artikel=4.51&lid=1>;
        schema:position  "1";
        cnt:chars        "Tot periodieke aanmelding als bedoeld in artikel 54, eerste lid, onder f, van de Wet, bij de korpschef is verplicht de vreemdeling die:" .

<jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=1&artikel=6.1b&lid=2>
