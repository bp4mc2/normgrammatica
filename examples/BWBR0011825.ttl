        schema:position  "2";
        cnt:chars        "een kopie van de documenten voor grensoverschrijding die de vreemdeling sinds zijn inreisverbod heeft gehouden;" .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=1&artikel=3.1a&lid=2&o=d&z=2026-09-25&g=2026-09-25>
