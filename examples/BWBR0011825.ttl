        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=1&artikel=8.1&lid=3&o=a>;
        schema:position  "1";
        cnt:chars        "de vreemdeling niet voorkomt in de basisregistratie personen, maar wel beschikt over het bescheid, bedoeld in artikel 9, vijfde lid, van de Wet;" .

<jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=3&artikel=6.5>
        rdf:type              eli:WorkSubdivision;
