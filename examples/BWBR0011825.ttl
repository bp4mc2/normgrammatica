        dct:isPartOf          <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=6&paragraaf=2&artikel=3.128> .

<jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=2&artikel=5.12&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=5&paragraaf=2&artikel=5.12&lid=2>;
        schema:position  "2";
        cnt:chars        "Van de tenuitvoerlegging van een vrijheidsontnemende maatregel als bedoeld in het eerste lid, wordt op verzoek van de vreemdeling zo spoedig mogelijk kennis gegeven aan diens naaste verwanten of aan een in Nederland gevestigde diplomatieke of consulaire vertegenwoordiging van de staat waarvan hij onderdaan is." .

<jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=3&artikel=6.5&lid=2&o=f&z=2026-09-25&g=2026-09-25>
