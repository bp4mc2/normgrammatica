        dct:isPartOf          <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=3&paragraaf=1&artikel=3.93&lid=1> .

<jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=3&artikel=6.5a&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=1&artikel=3.3&z=2026-09-25&g=2026-09-25>;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=6&afdeling=3&artikel=6.5a&lid=2>;
        schema:position  "2";
        cnt:chars        "In afwijking van het eerste lid, bedraagt de duur van het inreisverbod ten hoogste één jaar, indien het betreft de vreemdeling die de vrije termijn, bedoeld in artikel 3.3, heeft overschreden met meer dan drie dagen maar niet meer dan 90 dagen." .

