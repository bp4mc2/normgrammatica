        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=5&artikel=3.90&lid=2>;
        schema:position  "2";
        cnt:chars        "Het eerste lid is niet van toepassing, indien er sedert de verbreking van de samenwoning een jaar is verstreken. " .

<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=3&paragraaf=7&artikel=4.52a&lid=3&o=d&z=2026-09-25&g=2026-09-25>
