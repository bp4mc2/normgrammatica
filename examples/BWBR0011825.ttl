        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=1&artikel=1.1&o=_24>;
        schema:position  "24";
        cnt:chars        " verblijfsvergunning regulier voor onbepaalde tijd: de verblijfsvergunning, bedoeld in artikel 20 van de Wet;" .

<jci1.3:c:BWBR0011825&hoofdstuk=4&afdeling=3&paragraaf=2&z=2026-09-25&g=2026-09-25>
