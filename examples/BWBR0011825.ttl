<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=3&paragraaf=1&artikel=3.93&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=3&paragraaf=2&artikel=3.94&z=2026-09-25&g=2026-09-25>;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=3&paragraaf=1&artikel=3.93&lid=2>;
        schema:position  "2";
        cnt:chars        "In afwijking van artikel 3.94, tweede lid, zijn de middelen van bestaan van de vreemdeling als bedoeld in het eerste lid duurzaam, indien zij nog gedurende ten minste één jaar beschikbaar zijn." .

