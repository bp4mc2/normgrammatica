<jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=3&paragraaf=2&artikel=1.18&lid=2&z=2026-09-25&g=2026-09-25>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0011825&hoofdstuk=1&afdeling=3&paragraaf=2&artikel=1.18&lid=2>;
        schema:position  "2";
        cnt:chars        "De aanvraag om erkenning als referent kan in ieder geval worden afgewezen, indien de aanvrager failliet is verklaard of aan hem surséance van betaling is verleend." .

<jci1.3:c:BWBR0011825&hoofdstuk=3&afdeling=2&paragraaf=3&artikel=3.77&lid=1&o=b>
