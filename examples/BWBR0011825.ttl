        schema:position  "1";
        cnt:chars        "naam en voornaam of voornamen van de vreemdeling;" .

<jci1.3:c:BWBR0011825&hoofdstuk=8&afdeling=2&paragraaf=2&artikel=8.18&lid=2&z=2026-09-25&g=2026-09-25>
