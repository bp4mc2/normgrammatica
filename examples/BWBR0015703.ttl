        schema:position  "3";
        cnt:chars        "voor zover de inleg in het kader van de lijfrente of lijfrenten:" .

<jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.3&artikel=18&lid=4&o=f&z=2026-07-01&g=2026-07-01>
