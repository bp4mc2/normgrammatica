        schema:position  "5";
        cnt:chars        "In deze wet en de daarop berustende bepalingen wordt verstaan onder:" .

<jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.1&artikel=50&lid=2&z=2026-07-01&g=2026-07-01>
