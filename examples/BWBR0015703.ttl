        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=7&paragraaf=7.3&artikel=77&lid=1>;
        schema:position  "1";
        cnt:chars        "Het college legt verantwoording af aan Onze Minister over de uitvoering van deze wet, op de wijze, bedoeld in artikel 17a van de Financiële-verhoudingswet." .

