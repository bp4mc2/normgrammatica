        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.1&artikel=41&lid=12>;
        schema:position  "12";
        cnt:chars        "In alle gevallen waar het vierde lid niet op van toepassing is, stelt het college betrokkene na melding onverwijld in de gelegenheid een aanvraag in te dienen." .

<jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.6&artikel=64&lid=5&o=b&z=2026-07-01&g=2026-07-01>
