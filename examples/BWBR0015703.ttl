<jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.3&artikel=18a&lid=3&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0001854&artikel=23> , <jci1.3:c:BWBR0013060&artikel=30c> , <jci1.3:c:BWBR0015703&hoofdstuk=4&paragraaf=4.1&artikel=36b&z=2026-07-01&g=2026-07-01> , <jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.3&artikel=17&z=2026-07-01&g=2026-07-01>;
