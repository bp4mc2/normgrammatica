<jci1.3:c:BWBR0015703&hoofdstuk=1&paragraaf=1.2&artikel=7&lid=1&o=b>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Onderdeel>;
        dct:isPartOf          <jci1.3:c:BWBR0015703&hoofdstuk=1&paragraaf=1.2&artikel=7&lid=1> .

<jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.4&artikel=47c&lid=3&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:number       "3";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.4&artikel=47c&lid=3>;
        schema:position  "3";
        cnt:chars        "Indien het college een gegrond vermoeden heeft dat een belanghebbende niet voldoet aan de verplichting tot arbeidsinschakeling dan wel niet of onvoldoende gebruik maakt van re-integratievoorzieningen of inburgeringsvoorzieningen, stelt het de Sociale verzekeringsbank daarvan in kennis." .

<jci1.3:c:BWBR0015703&hoofdstuk=4&paragraaf=4.1&artikel=36&lid=4>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
