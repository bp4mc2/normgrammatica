        schema:position  "1";
        cnt:chars        "Door het college op grond van de Wet werk en bijstand genomen besluiten gelden als door hem genomen besluiten op grond van deze wet." .

<jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.1&artikel=9a&lid=5&o=c&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
