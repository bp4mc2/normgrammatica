<jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.1&artikel=50&lid=2&o=a&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0015703&hoofdstuk=4&paragraaf=4.2&artikel=37&z=2026-07-01&g=2026-07-01>;
        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.1&artikel=50&lid=2&o=a>;
        schema:position  "1";
        cnt:chars        "indien de bijstand over een periode van een jaar, te rekenen vanaf de eerste dag waarover bijstand wordt verleend, naar verwachting meer bedraagt dan het netto minimumloon, bedoeld in artikel 37, eerste lid; en" .

<jci1.3:c:BWBR0015703&hoofdstuk=7a&artikel=78k&lid=1>
        rdf:type              eli:WorkSubdivision;
