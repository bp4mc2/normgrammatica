<jci1.3:c:BWBR0015703&hoofdstuk=1&paragraaf=1.2&artikel=7&lid=1&o=a&o=2&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.1&artikel=10d&z=2026-07-01&g=2026-07-01> , <jci1.3:c:BWBR0019057&artikel=36> , <jci1.3:c:BWBR0019057&artikel=35> , <jci1.3:c:BWBR0019057&artikel=34a>;
        eli:number       "2°.";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=1&paragraaf=1.2&artikel=7&lid=1&o=a&o=2>;
        schema:position  "2";
        cnt:chars        "personen als bedoeld in de artikelen 34a, vijfde lid, onderdeel b, 35, vierde lid, onderdeel b, en 36, derde lid, onderdeel b, van de Wet werk en inkomen naar arbeidsvermogen tot het moment dat het inkomen uit arbeid in dienstbetrekking gedurende twee aaneengesloten jaren ten minste het minimumloon vermenigvuldigd met de arbeidsduur welke in overeenkomstige dienstbetrekking in de regel geacht wordt een volledige dienstbetrekking te vormen bedraagt en ten behoeve van die persoon in die twee jaren geen loonkostensubsidie als bedoeld in artikel 10d is verleend," .

