<jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.3&artikel=18a&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.3&artikel=18a>;
        dct:title        "Artikel 18a. Bestuurlijke boete";
        schema:position  "3" .

<jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.4&artikel=47e&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.6&artikel=67&z=2026-07-01&g=2026-07-01> , <jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.6&artikel=64&z=2026-07-01&g=2026-07-01>;
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.4&artikel=47e>;
        dct:title        "Artikel 47e. Gegevensverstrekkingen aan en door de Sociale verzekeringsbank";
        schema:position  "5";
        cnt:chars        "De artikelen 64 en 67 zijn van overeenkomstige toepassing voor het kosteloos verstrekken van opgaven en inlichtingen aan de Sociale verzekeringsbank die noodzakelijk zijn voor de uitvoering van de taak van de Sociale verzekeringsbank op grond van dit hoofdstuk en voor het verstrekken van gegevens door de Sociale verzekeringsbank uit de administratie voor de uitvoering van deze taak." .

<jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.4&artikel=47c&lid=10&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:number       "10";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.4&artikel=47c&lid=10>;
        schema:position  "10";
        cnt:chars        "De Sociale verzekeringsbank ziet af van het opleggen van een maatregel, indien elke vorm van verwijtbaarheid ontbreekt." .

<jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.1&artikel=41&lid=8&o=b&o=1&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:number       "1°.";
