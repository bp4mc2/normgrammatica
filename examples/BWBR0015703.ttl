<jci1.3:c:BWBR0015703&hoofdstuk=7a&artikel=78m&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.2&artikel=11&z=2026-07-01&g=2026-07-01> , <jci1.3:c:BWBR0015703&hoofdstuk=1&paragraaf=1.1&artikel=4&z=2026-07-01&g=2026-07-01> , <jci1.3:c:BWBR0015703&hoofdstuk=1&paragraaf=1.1&artikel=3&z=2026-07-01&g=2026-07-01>;
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=7a&artikel=78m>;
        dct:title        "Artikel 78m. Overgangsrecht gelijkstelling voormalige pleeg- en stiefkinderen aan eigen kinderen";
        schema:position  "13";
        cnt:chars        "De artikelen 3, zevende en achtste lid, en 4, tweede lid, zijn niet van toepassing, indien voor 1 januari 2010 op grond van artikel 11 recht bestaat op bijstand voor gehuwden, omdat de ongehuwde bijstandsgerechtigde wegens een gezamenlijke huishouding met een meerderjarig aangehuwd kind of een meerderjarig voormalig pleegkind is aangemerkt als gehuwd, voor zolang dit recht op bijstand bestaat, tenzij toepassing van de genoemde artikelleden leidt tot een hogere bijstandsuitkering." .

<jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.5&artikel=62b&lid=4&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:number       "4";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.5&artikel=62b&lid=4>;
        schema:position  "4";
        cnt:chars        "Het college is bevoegd, met uitsluiting van degene die de bijstand ontvangt, het verschuldigde bij dwangbevel in te vorderen." .

<jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.5&artikel=62f>
        rdf:type              eli:WorkSubdivision;
