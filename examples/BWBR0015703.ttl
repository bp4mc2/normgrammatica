<jci1.3:c:BWBR0015703&hoofdstuk=7c&artikel=78gg&lid=1&o=b&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0011353&artikel=8.9> , <jci1.3:c:BWBR0015703&hoofdstuk=4&paragraaf=4.2&artikel=37&z=2026-07-01&g=2026-07-01> , <jci1.3:c:BWBR0018472> , <jci1.3:c:BWBR0015703&hoofdstuk=3&paragraaf=3.1&artikel=19&z=2026-07-01&g=2026-07-01>;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=7c&artikel=78gg&lid=1&o=b>;
        schema:position  "2";
        cnt:chars        "vergeleken met een vergelijkbaar huishouden, waarvoor het inkomen uit enkel een uitkering bestaat op grond van artikel 19, ontvangt het huishouden een lager bedrag aan tegemoetkomingen met toepassing van de Algemene wet inkomensafhankelijke regelingen, als gevolg van de verschillende afbouwpaden van de dubbele algemene heffingskorting, bedoeld in artikel 37, tweede lid, en in artikel 8.9 van de Wet inkomstenbelasting 2001; en" .

<jci1.3:c:BWBR0015703&hoofdstuk=7&paragraaf=7.3&artikel=77&lid=1&z=2026-07-01&g=2026-07-01>
