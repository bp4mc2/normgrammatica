        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=3&paragraaf=3.1&artikel=19&lid=1&o=b>;
        schema:position  "2";
        cnt:chars        "er geen in aanmerking te nemen vermogen is." .

<jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.6&artikel=65&lid=2&o=b&z=2026-07-01&g=2026-07-01>
