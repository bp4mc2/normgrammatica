        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.3&artikel=47&o=d>;
        schema:position  "4";
        cnt:chars        "onderwerpen voor de agenda van dit overleg kunnen aanmelden;" .

