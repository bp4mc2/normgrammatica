<jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.6&artikel=64&lid=14&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:number       "14";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.6&artikel=64&lid=14>;
        schema:position  "14";
        cnt:chars        "De Belastingdienst verstrekt aan het college, of indien het college aan het Uitvoeringsinstituut werknemersverzekeringen mandaat heeft verleend tot het nemen van besluiten inzake de verlening van bijstand, aan het Uitvoeringsinstituut werknemersverzekeringen, zonder dat daaraan een verzoek ten grondslag ligt gegevens als bedoeld in het eerste lid over samenloop van een uitkering met inkomen uit of in verband met arbeid of bedrijf of over vermogen, die bij de uitvoering van een belastingwet of bij de invordering van enige rijksbelasting bekend zijn geworden voor zover die gegevens noodzakelijk zijn voor de uitvoering van deze wet." .

<jci1.3:c:BWBR0015703&hoofdstuk=1&paragraaf=1.2&artikel=7a&lid=1&o=a&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0015703&hoofdstuk=1&paragraaf=1.2&artikel=7&z=2026-07-01&g=2026-07-01>;
