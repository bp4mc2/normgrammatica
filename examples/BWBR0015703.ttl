        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.3&artikel=18&lid=4&o=f>;
        schema:position  "6";
        cnt:chars        "het verkrijgen en behouden van kennis en vaardigheden, noodzakelijk voor het naar vermogen verkrijgen, het aanvaarden of het behouden van algemeen geaccepteerde arbeid;" .

<jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.1&artikel=43a&lid=1&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.1&artikel=43a&lid=1>;
        schema:position  "1";
        cnt:chars        "Indien na het eindigen van de algemene bijstand binnen twaalf maanden een nieuwe aanvraag wordt gedaan, kan het college de gegevens die bij hem berusten in verband met de eerdere bijstandsverlening gebruiken, indien dit leidt tot een voor de belanghebbende minder belastende aanvraag." .

<jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.1&artikel=10h&lid=6&o=a&o=1&z=2026-07-01&g=2026-07-01>
