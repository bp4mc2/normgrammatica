        eli:number       "1°.";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.2&artikel=15&lid=2&o=b&o=1>;
        schema:position  "1";
        cnt:chars        "tijdens de toetsingsperiode de ingangsdatum van de lijfrente niet is uitgesteld;" .

<jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.3&artikel=18&lid=4&o=d&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:number       "d.";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.3&artikel=18&lid=4&o=d>;
        schema:position  "4";
        cnt:chars        "bereid zijn om te reizen over een afstand met een totale reisduur van 3 uur per dag, indien dat noodzakelijk is voor het naar vermogen verkrijgen, het aanvaarden of het behouden van algemeen geaccepteerde arbeid;" .

<jci1.3:c:BWBR0015703&hoofdstuk=7a&artikel=78y&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0031793>;
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=7a&artikel=78y>;
        dct:title        "Artikel 78y. \n      Uitbetaling door Sociale verzekeringsbank aan het college\n    ";
        schema:position  "24";
        cnt:chars        "Indien als gevolg van inwerkingtreding van de Wet afschaffing huishoudinkomenstoets het college ten aanzien van belanghebbende over een periode een vordering heeft met betrekking tot kosten van algemene bijstand en als gevolg van inwerkingtreding van die wet die belanghebbende over diezelfde periode recht op algemene bijstand heeft jegens de Sociale verzekeringsbank, betaalt de Sociale Verzekeringsbank, zonder dat daarvoor machtiging nodig is van de belanghebbende, op verzoek van het college uit die bijstand het bedrag van die vordering uit aan het college." .

<jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.4&artikel=47c&lid=8&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:number       "8";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.4&artikel=47c&lid=8>;
        schema:position  "8";
        cnt:chars        "Indien de belanghebbende een verplichting als bedoeld in het vijfde lid niet nakomt binnen twaalf maanden nadat het zevende lid toepassing heeft gevonden, verlaagt de Sociale verzekeringsbank, in afwijking van het zesde en zevende lid, de bijstand met 100% voor een periode van drie maanden." .

<jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.3&artikel=18b&lid=2&o=c&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:number       "c.";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.3&artikel=18b&lid=2&o=c>;
        schema:position  "3";
        cnt:chars        "geen ander document kan overleggen waaruit blijkt dat hij de vaardigheden in de Nederlandse taal beheerst." .

