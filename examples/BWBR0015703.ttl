        schema:position  "2";
        cnt:chars        "het voortgezet speciaal onderwijs, bedoeld in artikel 2 van de Wet op de expertisecentra; of" .

<jci1.3:c:BWBR0015703&hoofdstuk=3&paragraaf=3.4&artikel=34b&lid=1&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
