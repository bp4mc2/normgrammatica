        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=3&paragraaf=3.4&artikel=33&lid=5>;
        schema:position  "5";
        cnt:chars        "Indien de alleenstaande, de alleenstaande ouder of een van de echtgenoten de pensioengerechtigde leeftijd heeft bereikt, wordt voor de vaststelling van de hoogte van de algemene bijstand een in de vorm van een periodieke uitkering ontvangen particuliere oudedagsvoorziening buiten beschouwing gelaten tot een bedrag van:" .

<jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.4&artikel=59&lid=2&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
