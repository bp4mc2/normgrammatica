        schema:position  "9";
        cnt:chars        "rente ontvangen over op grond van artikel 34, tweede lid, onderdelen b en c, niet in aanmerking genomen vermogen en spaargelden;" .

<jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.1&artikel=10&lid=3&o=a&z=2026-07-01&g=2026-07-01>
