        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.1&artikel=10h&lid=3>;
        schema:position  "3";
        cnt:chars        "Het Uitvoeringsinstituut werknemersverzekeringen kan op aanvraag van personen als bedoeld in het eerste lid of het college een werkvoorziening toekennen en voor die personen bekostigen." .

<jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.5&artikel=62b&lid=1&z=2026-07-01&g=2026-07-01>
