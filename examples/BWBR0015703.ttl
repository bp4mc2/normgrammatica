        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.1&artikel=9a&lid=5&o=c>;
        schema:position  "3";
        cnt:chars        "door het college opgeschort op een daartoe strekkend verzoek van de alleenstaande ouder aan wie de ontheffing, bedoeld in het eerste lid, is verleend; of" .

<jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.4&artikel=47f&lid=5&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:number       "5";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.4&artikel=47f&lid=5>;
        schema:position  "5";
        cnt:chars        "Indien de Sociale verzekeringsbank het bedrag van de geldlening of borgtocht invordert, betaalt de Sociale verzekeringsbank aan het college, bedoeld in het eerste lid, het bedrag van de door het college verstrekte geldlening of borgtocht, of indien de opbrengst na aftrek van kosten minder bedraagt dan het totale bedrag van de geldlening of borgtocht een evenredig deel van de geldlening of borgtocht." .

<jci1.3:c:BWBR0015703&hoofdstuk=7a&artikel=78x&lid=2&z=2026-07-01&g=2026-07-01>
