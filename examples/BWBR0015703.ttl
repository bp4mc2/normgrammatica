        schema:position  "2";
        cnt:chars        "degene op wie de gegevens betrekking hebben schriftelijk heeft verklaard tegen de verstrekking van deze gegevens geen bezwaar te hebben;" .

<jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.5&artikel=62c&lid=2&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
