<jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.1&artikel=49&o=b&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:number       "b.";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.1&artikel=49&o=b>;
        schema:position  "2";
        cnt:chars        "indien daartoe zeer dringende redenen bestaan en de in onderdeel a genoemde mogelijkheid geen uitkomst biedt." .

