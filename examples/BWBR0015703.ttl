        dct:isPartOf          <jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.6&artikel=64&lid=5> .

<jci1.3:c:BWBR0015703&hoofdstuk=4&paragraaf=4.2&artikel=38&lid=6&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0018451&artikel=4> , <jci1.3:c:BWBR0018451&artikel=2> , <jci1.3:c:BWBR0018451> , <jci1.3:c:BWBR0015703&hoofdstuk=3&paragraaf=3.2&artikel=23&z=2026-07-01&g=2026-07-01>;
        eli:number       "6";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=4&paragraaf=4.2&artikel=38&lid=6>;
        schema:position  "6";
        cnt:chars        "De bedragen, genoemd in artikel 23, tweede lid, worden gewijzigd, indien het drempelinkomen, bedoeld in de Wet op de zorgtoeslag, wordt aangepast, de percentages, bedoeld in artikel 2 van die wet, worden gewijzigd of het bedrag van de standaardpremie op grond van artikel 4 van die wet op een ander bedrag wordt vastgesteld." .

