        schema:position  "2";
        cnt:chars        "indien het vierde lid niet van toepassing is: binnen vier weken na de melding, bedoeld in artikel 44." .

<jci1.3:c:BWBR0015703&hoofdstuk=1&paragraaf=1.1&artikel=6&o=g&z=2026-07-01&g=2026-07-01>
