        eli:cites        <jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.6&artikel=67&z=2026-07-01&g=2026-07-01> , <jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.6&artikel=64&z=2026-07-01&g=2026-07-01>;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.6&artikel=68&lid=1>;
        schema:position  "1";
        cnt:chars        "Bij de verstrekking van gegevens door het college, het Bureau Informatiediensten Nederland en de in de artikelen 64 en 67 bedoelde instanties wordt, indien daartoe bevoegd, gebruik gemaakt van het burgerservicenummer." .

