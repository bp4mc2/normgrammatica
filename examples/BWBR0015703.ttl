<jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.2&artikel=53a&lid=7&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:number       "7";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.2&artikel=53a&lid=7>;
        schema:position  "7";
        cnt:chars        "De voordracht voor een krachtens het eerste lid, derde zin, vast te stellen algemene maatregel van bestuur wordt niet eerder gedaan dan twee weken nadat het ontwerp aan beide kamers der Staten-Generaal is overgelegd." .

<jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.3&artikel=18a&lid=3>
