        schema:position  "6";
        cnt:chars        "anderszins onverschuldigd is betaald, waaronder begrepen dat:" .

<jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.1&artikel=40&lid=3&o=b&z=2026-07-01&g=2026-07-01>
