        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=1&paragraaf=1.2&artikel=8a&lid=1&o=b>;
        schema:position  "2";
        cnt:chars        "het opdragen van een tegenprestatie als bedoeld in artikel 9, eerste lid, onderdeel c;" .

