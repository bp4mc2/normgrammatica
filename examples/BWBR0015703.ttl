<jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.3&artikel=18&lid=10&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:number       "10";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.3&artikel=18&lid=10>;
        schema:position  "11";
        cnt:chars        "Het college stemt een op te leggen maatregel of een opgelegde maatregel af op de omstandigheden van de belanghebbende en diens mogelijkheden om middelen te verwerven, indien naar zijn oordeel, gelet op bijzondere omstandigheden, dringende redenen daartoe noodzaken." .

<jci1.3:c:BWBR0015703&hoofdstuk=7a&artikel=78g&lid=1>
        rdf:type              eli:WorkSubdivision;
        eli:type_subdivision  <http://bp4mc2.org/subdivisiontype/Lid>;
