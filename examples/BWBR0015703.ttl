<jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.6&artikel=65&lid=4&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.6&artikel=63&z=2026-07-01&g=2026-07-01>;
        eli:number       "4";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.6&artikel=65&lid=4>;
        schema:position  "4";
        cnt:chars        "Degene die op grond van de artikelen 63 tot en met 68 gegevens verstrekt dient na te gaan of degene aan wie de gegevens worden verstrekt redelijkerwijs bevoegd is te achten om die gegevens te verkrijgen." .

<jci1.3:c:BWBR0015703&hoofdstuk=7a&artikel=78p>
