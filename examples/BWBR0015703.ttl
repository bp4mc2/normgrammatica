<jci1.3:c:BWBR0015703&hoofdstuk=3&paragraaf=3.4&artikel=32&lid=2&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:number       "2";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=3&paragraaf=3.4&artikel=32&lid=2>;
        schema:position  "2";
        cnt:chars        "Middelen die het karakter hebben van uitgesteld inkomen worden in aanmerking genomen naar de periode waarin deze zijn verworven. Middelen die het karakter hebben van doorbetaling van inkomen over een periode worden in aanmerking genomen naar de periode waarin deze te gelde kunnen worden gemaakt." .

