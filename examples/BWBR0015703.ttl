        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.2&artikel=15&lid=2&o=b>;
        schema:position  "2";
        cnt:chars        "benutten van de mogelijkheid om te beschikken over de waarde van een lijfrente zolang de belanghebbende de pensioengerechtigde leeftijd nog niet heeft bereikt, en:" .

