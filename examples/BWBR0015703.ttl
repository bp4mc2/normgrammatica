        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.1&artikel=10d&lid=2&o=b>;
        schema:position  "2";
        cnt:chars        "een persoon was als bedoeld in de artikelen 7, eerste lid, onderdeel a, of 7a, eerste lid, onderdeel a; dan wel" .

<jci1.3:c:BWBR0015703&hoofdstuk=1&paragraaf=1.1&artikel=4&lid=1&o=c&o=3&z=2026-07-01&g=2026-07-01>
