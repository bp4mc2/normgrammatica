        schema:position  "1";
        cnt:chars        "de gronden voor verlening van de vangnetuitkering;" .

<jci1.3:c:BWBR0015703&hoofdstuk=3&paragraaf=3.4&artikel=31&lid=2&o=v&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
