        eli:number       "1°.";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.1&artikel=10d&lid=2&o=a&o=1>;
        schema:position  "1";
        cnt:chars        "het praktijkonderwijs, bedoeld in artikel 2.8 van de Wet voortgezet onderwijs 2020;" .

