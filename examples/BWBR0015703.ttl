        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=7&paragraaf=7.1&artikel=74&lid=7>;
        schema:position  "7";
        cnt:chars        "Bij ministeriële regeling worden regels gesteld voor de termijn waarbinnen een verzoek kan worden ingediend." .

