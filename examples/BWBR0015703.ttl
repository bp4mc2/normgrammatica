        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.3&artikel=56&lid=2>;
        schema:position  "2";
        cnt:chars        "Indien het college de in het eerste lid genoemde verplichting oplegt, dient de belanghebbende zelf een verzoek terzake in bij een bij algemene maatregel van bestuur aan te wijzen instelling. " .

<jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.2&artikel=15&lid=4&z=2026-07-01&g=2026-07-01>
