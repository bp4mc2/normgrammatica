        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=1&paragraaf=1.2&artikel=7a&lid=1&o=a>;
        schema:position  "1";
        cnt:chars        "het een persoon betreft als bedoeld in artikel 7, eerste lid, onderdeel a, en het college oordeelt dat het volgen van uit ’s Rijks kas bekostigd onderwijs voor die persoon niet mogelijk of niet passend is;" .

<jci1.3:c:BWBR0015703&hoofdstuk=7&paragraaf=7.3&artikel=78&lid=2&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
