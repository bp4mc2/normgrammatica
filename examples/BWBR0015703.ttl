        schema:position  "1";
        cnt:chars        "van 18, 19 of 20 jaar die in een inrichting verblijft;" .

<jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.4&artikel=47c&lid=7&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
