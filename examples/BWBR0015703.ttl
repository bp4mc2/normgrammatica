        schema:position  "3";
        cnt:chars        "de pensioengerechtigde leeftijd heeft bereikt: voor 25 procent en tot € 226,00 van deze inkomsten per maand." .

<jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.1&artikel=43&lid=3&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
