        cnt:chars        "bijstandsnorm: de op grond van paragraaf 3.2, op de belanghebbende van toepassing zijnde norm, verminderd met de op grond van paragraaf 3.3, door het college vastgestelde verlaging;" .

<jci1.3:c:BWBR0015703&hoofdstuk=1&paragraaf=1.1&artikel=4&lid=1&o=e&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
