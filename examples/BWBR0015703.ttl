        eli:cites        <jci1.3:c:BWBR0015703&hoofdstuk=3&paragraaf=3.2&artikel=22a&z=2026-07-01&g=2026-07-01> , <jci1.3:c:BWBR0015703&hoofdstuk=3&paragraaf=3.2&artikel=22&z=2026-07-01&g=2026-07-01> , <jci1.3:c:BWBR0015703&hoofdstuk=3&paragraaf=3.2&artikel=19a&z=2026-07-01&g=2026-07-01> , <jci1.3:c:BWBR0015703&hoofdstuk=3&paragraaf=3.2&artikel=20&z=2026-07-01&g=2026-07-01> , <jci1.3:c:BWBR0015703&hoofdstuk=3&paragraaf=3.2&artikel=21&z=2026-07-01&g=2026-07-01>;
        eli:number       "a.";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.2&artikel=53a&lid=2&o=a>;
        schema:position  "1";
        cnt:chars        "hij een belanghebbende is als bedoeld in artikel 20, eerste lid, aanhef en onderdeel a, of artikel 20, tweede lid, aanhef en onderdeel a, of artikel 21, aanhef en onderdeel a, of artikel 22, aanhef en onderdeel a of dat op hem artikel 22a niet van toepassing is, dan wel dat er niet meer dan het door hem gestelde aantal kostendelende medebewoners als bedoeld in artikel 19a in dezelfde woning zijn hoofdverblijf heeft;" .

<jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.3&artikel=18a&lid=6&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
