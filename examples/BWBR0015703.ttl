        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.4&artikel=47c&lid=7>;
        schema:position  "7";
        cnt:chars        "Indien de belanghebbende een verplichting als bedoeld in het vijfde lid niet nakomt binnen twaalf maanden nadat het zesde lid toepassing heeft gevonden, verlaagt de Sociale verzekeringsbank, in afwijking van het zesde lid, de bijstand met 100% voor een periode die in ieder geval langer is dan de op grond van het zesde lid vastgestelde periode van verlaging en ten hoogste drie maanden." .

<jci1.3:c:BWBR0015703&hoofdstuk=6&paragraaf=6.4&artikel=58&lid=7&o=c&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
