<jci1.3:c:BWBR0015703&hoofdstuk=1&paragraaf=1.2&artikel=8c&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0015703&hoofdstuk=7&paragraaf=7.3&z=2026-07-01&g=2026-07-01> , <jci1.3:c:BWBR0015703&hoofdstuk=7&paragraaf=7.1&z=2026-07-01&g=2026-07-01> , <jci1.3:c:BWBR0003740&artikel=8> , <jci1.3:c:BWBR0003740>;
