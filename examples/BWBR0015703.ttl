        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=2&paragraaf=2.2&artikel=13&lid=1&o=d>;
        schema:position  "4";
        cnt:chars        "die wegens werkstaking of uitsluiting niet deelneemt aan de arbeid, voorzover diens gebrek aan middelen daarvan het gevolg is;" .

