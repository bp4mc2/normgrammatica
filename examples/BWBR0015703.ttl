        rdf:type         eli:Expression;
        eli:cites        <jci1.3:c:BWBR0015703&hoofdstuk=3&paragraaf=3.2&artikel=21&z=2026-07-01&g=2026-07-01> , <jci1.3:c:BWBR0015703&hoofdstuk=3&paragraaf=3.2&artikel=20&z=2026-07-01&g=2026-07-01>;
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=3&paragraaf=3.3&artikel=27>;
        dct:title        "Artikel 27. Woonsituatie";
        schema:position  "3";
        cnt:chars        "Het college kan de norm, bedoeld in de artikelen 20 en 21, lager vaststellen voorzover de belanghebbende lagere algemeen noodzakelijke kosten van het bestaan heeft dan waarin de norm voorziet als gevolg van zijn woonsituatie, waaronder begrepen het niet aanhouden van een woning." .

