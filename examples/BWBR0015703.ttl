<jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.4&artikel=47a&lid=1&z=2026-07-01&g=2026-07-01>
        rdf:type         eli:Expression;
        eli:number       "1";
        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=5&paragraaf=5.4&artikel=47a&lid=1>;
        schema:position  "1";
        cnt:chars        "De Sociale verzekeringsbank heeft tot taak het verlenen van algemene bijstand in de vorm van een aanvullende inkomensvoorziening ouderen aan:hier te lande die in zodanige omstandigheden verkeren of dreigen te geraken dat zij niet over de middelen beschikken om in de noodzakelijke kosten van het bestaan te voorzien." .

