        eli:realizes     <jci1.3:c:BWBR0015703&hoofdstuk=3&paragraaf=3.4&artikel=31&lid=4>;
        schema:position  "4";
        cnt:chars        "Bij ministeriële regeling worden regels gesteld met betrekking tot het in aanmerking nemen van de aanspraak op vakantietoeslag over een inkomen." .

