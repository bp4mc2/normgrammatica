#
# Norm uit Artikel 45a, lid 1
#
annotatie:Artikel45alid1Vw2000 a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45a&lid=1&z=2026-10-16&g=2026-10-16>;
  ];
  oa:body "Dit lijkt de kern te zijn: de feitelijke bevoegdheid die aan Onze Minister wordt verleend. Maar is hier nu sprake van één normuitdrukking of meerdere? Ik zou zeggen, het is er maar eentje, want anders moet je 'is bevoegd' steeds herhalen. Wel lijkt het mij dat hier sprake is van vier normen op het semantische niveau: (1) bevoegdheid tot inwilligen; (2) bevoegdheid tot afwijzen; (3) bevoegdheid tot niet in behandeling te nemen; (4) bevoegdheid tot intrekken.";
.
annotatie:Artikel45alid1Vw2000.PrimarySubject a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45a&lid=1&z=2026-10-16&g=2026-10-16>;
    oa:selector [oa:start 1; oa:end 13]
  ];
  oa:body lg:PrimarySubject
.
annotatie:Artikel45alid1Vw2000.NormExpression a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45a&lid=1&z=2026-10-16&g=2026-10-16>;
    oa:selector [oa:start 15; oa:end 24], [oa:start 114; oa:end 127], [oa:start 130; oa:end 141], [oa:start 151; oa:end 178], [oa:start 235; oa:end 247]
  ];
  oa:body lg:NormExpression
.
annotatie:Artikel45alid1Vw2000.Object a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45a&lid=1&z=2026-10-16&g=2026-10-16>;
    oa:selector [oa:start 26; oa:end 112]
  ];
  oa:body lg:Object
.
annotatie:Artikel45alid1Vw2000.Object a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45a&lid=1&z=2026-10-16&g=2026-10-16>;
    oa:selector [oa:start 180; oa:end 233]
  ];
  oa:body lg:Object
.

#
# Norm uit Artikel 45a, lid 2
#
annotatie:Artikel45alid2Vw2000 a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45a&lid=2&z=2026-10-16&g=2026-10-16>;
  ];
  oa:body "Dit lijkt een van-rechtswege norm. Niemand 'doet' hier iets, er is al wat gedaan... 'De status van langdurig ingezetene' lijkt een juridisch effect, niet enkel een object. Als je hier een object van maakt, wat is dan nog WEL een juridisch effect? Dat die status permanent is, lijkt me dan ook een juridisch effect. De verlening lijkt me in dit geval de conditie waaronder deze norm 'actief' wordt."
.
annotatie:Artikel45alid2Vw2000.LegalEffect a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45a&lid=2&z=2026-10-16&g=2026-10-16>;
    oa:selector [oa:start 1; oa:end 34]
  ];
  oa:body lg:LegalEffect
.
annotatie:Artikel45alid2Vw2000.NormExpression a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45a&lid=2&z=2026-10-16&g=2026-10-16>;
    oa:selector [oa:start 36; oa:end 50]
  ];
  oa:body lg:NormExpression
.
annotatie:Artikel45alid2Vw2000.Condition a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45a&lid=2&z=2026-10-16&g=2026-10-16>;
    oa:selector [oa:start 57; oa:end 126]
  ];
  oa:body lg:Condition
.
annotatie:Artikel45alid2Vw2000.LegalEffect a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45a&lid=2&z=2026-10-16&g=2026-10-16>;
    oa:selector [oa:start 129; oa:end 201]
  ];
  oa:body lg:LegalEffect
.

#
# Norm uit Artikel 46d, lid 1
#
annotatie:Artikel46dlid1Vw2000 a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45d&lid=1&z=2026-10-16&g=2026-10-16>;
  ];
  oa:body "De vraag is of hier -zelfstandig- ook een bevoegdheid wordt gemaakt. Het lijkt vooral condities te beschrijven waaronder de bevoegdheid kan worden uitgevoerd. In die zin is het aanvullend aan de norm uit Artikel 45a lid 1";
.
