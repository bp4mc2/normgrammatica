    oa:selector [oa:start 54; oa:end 75]
  ];
  oa:body lg:NormExpression
.
annotatie:Artikel45alid1Vw2000.Condition a oa:Annotation;
  oa:target [
  oa:source <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45d&lid=1&z=2026-10-16&g=2026-10-16>;
    oa:selector [oa:start 85; oa:end 264], [oa:start 265; oa:end 369]
  ];
  oa:body lg:Condition
.

#
# Norm uit Artikel 46d, lid 2
#
annotatie:Artikel46dlid2Vw2000 a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45d&lid=2&z=2026-10-16&g=2026-10-16>;
  ];
  oa:body "Hier lijkt sprake te zijn van een speciaal soort object. Het is niet zomaar een EU-verblijfsvergunning, maar een hele specifieke. Vandaar om dat specifiekere deel niet een conditie te maken.";
.
annotatie:Artikel46dlid2Vw2000.Object a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45d&lid=2&z=2026-10-16&g=2026-10-16>;
    oa:selector [oa:start 1; oa:end 177]
  ];
  oa:body lg:Object
.
annotatie:Artikel46dlid2Vw2000.NormExpression a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45d&lid=2&z=2026-10-16&g=2026-10-16>;
    oa:selector [oa:start 180; oa:end 201]
  ];
  oa:body lg:NormExpression
.
annotatie:Artikel45alid2Vw2000.Condition a oa:Annotation;
  oa:target [
  oa:source <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45d&lid=2&z=2026-10-16&g=2026-10-16>;
    oa:selector [oa:start 212; oa:end 482], [oa:start 488; oa:end 697]
  ];
  oa:body lg:Condition
.

#
# Norm uit Artikel 46d, lid 3
#
annotatie:Artikel46dlid3Vw2000 a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45d&lid=3&z=2026-10-16&g=2026-10-16>;
  ];
  oa:body "Net als bij lid 1 lijkt hier geen sprake van een afzonderlijke norm. Maar wel geldt dat de modaliteit in dit geval 'moeten' is. Dus als we maar 1 modaliteit toestaan, dan hebben we hier wel twee normen pakken (op semantisch niveau). Ze zijn bijna gelijk aan elkaar, maar verschillen in de modaliteit en de condities";
.
annotatie:Artikel46dlid3Vw2000.Object a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0011823&hoofdstuk=3&afdeling=5&paragraaf=1&artikel=45d&lid=3&z=2026-10-16&g=2026-10-16>;
    oa:selector [oa:start 1; oa:end 52]
  ];
  oa:body lg:Object
.
