#
# Norm uit Artikel 2r, lid 1 - Eerste volzin
#
annotatie:Artikel2rlid1Vw2000 a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=2&paragraaf=1&artikel=2r&lid=1&z=2026-10-16&g=2026-10-16>;
  ];
  oa:body "Een mooi voorbeeld. Er lijken hier drie bepalingen in één lid te zitten. In de eerste volzin lijkt 'daarvan' een object, maar daarbij wordt verwezen naar het begin van de zin. Dat lijkt echter in zijn geheel een conditie. 'schriftelijk' lijkt ook een conditie, maar dan niet een preconditie, maar een postconditie? In de derde volzin wordt over 'de termijn' gesproken. Dit lijkt ook een object, maar wordt eigenlijk helemaal niet benoemd in de tweede volzin.";
.
annotatie:Artikel2rlid1Vw2000-1.NormExpression a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0011823&hoofdstuk=1a&afdeling=2&paragraaf=1&artikel=2r&lid=1&z=2026-10-16&g=2026-10-16>;
    oa:selector [oa:start 86; oa:end 90], [oa:start 130; oa:end 138]
  ];
  oa:body lg:NormExpression;
.
