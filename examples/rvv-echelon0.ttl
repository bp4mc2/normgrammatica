#
# Norm uit Artikel 12 RVV
#
annotatie:Artikel12RVV a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=12&z=2026-07-01&g=2026-07-01>;
  ];
  oa:body "Waarom is in deze zin 'een voertuig' het secondair subject? Waarom niet een object?";
.
annotatie:Artikel12RVV.NormExpression a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=12&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 1; oa:end 15], [oa:start 77; oa:end 87]
  ];
  oa:body lg:NormExpression;
.
annotatie:Artikel12RVV.SecondarySubject a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=12&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 17; oa:end 28]
  ];
  oa:body lg:SecondarySubject;
.
annotatie:Artikel12RVV.Condition a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=12&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 30; oa:end 75]
  ];
  oa:body lg:Condition;
.

#
# Norm uit Artikel 12 lid 2 RVV
#
annotatie:Artikel12lid2RVV a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=3&artikel=13&lid=2&z=2026-07-01&g=2026-07-01>;
  ];
  oa:body "Deze normbepaling maakt dat de norm uit artikel 11 minder strikt is dan uit artikel 11 oorspronkelijk bleek. Maar om 'files' nu het secundair subject te noemen, dat lijkt toch wel heel raar.";
.
annotatie:Artikel12lid2RVV.Object a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=3&artikel=13&lid=2&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 2; oa:end 6]
  ];
  oa:body lg:Object
.
annotatie:Artikel12lid2RVV.NormExpression a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=3&artikel=13&lid=2&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 8; oa:end 12], [oa:start 34; oa:end 49]
  ];
  oa:body lg:NormExpression
.
annotatie:Artikel12lid2RVV.Condition a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=3&artikel=13&lid=2&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 14; oa:end 32]
  ];
  oa:body lg:Condition
.

#
# Norm uit Artikel 13 WVW lid 1
#
annotatie:Artikel13lid1WVW a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0006622&hoofdstuk=II&paragraaf=1&artikel=13&lid=1&z=2026-09-01&g=2026-09-01>;
  ];
  oa:body "Dit lijkt de delegatiebepaling te zijn die maakt dat de RVV kan worden opgesteld. Vreemd genoeg staat dat niet als zodanig in de RVV. De originele considerance gaat terug naar de oude wet, bij de informatie staat bij de grondslagen niet dit artikel. 'betreffende het gedrag..' heeft de functie van conditie. Maar toch is het meer kenmerkend dan conditionerend?";
.
annotatie:Artikel13lid1WVW.Condition a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0006622&hoofdstuk=II&paragraaf=1&artikel=13&lid=1&z=2026-09-01&g=2026-09-01>;
    oa:selector [oa:start 1; oa:end 34], [oa:start 69; oa:end 113]
  ];
  oa:body lg:Condition
.
annotatie:Artikel13lid1WVW.NormExpression a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0006622&hoofdstuk=II&paragraaf=1&artikel=13&lid=1&z=2026-09-01&g=2026-09-01>;
    oa:selector [oa:start 36; oa:end 41], [oa:start 57; oa:end 67]
  ];
  oa:body lg:NormExpression
.
annotatie:Artikel13lid1WVW.Object a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0006622&hoofdstuk=II&paragraaf=1&artikel=13&lid=1&z=2026-09-01&g=2026-09-01>;
    oa:selector [oa:start 43; oa:end 55]
  ];
  oa:body lg:Object
.

#
# Norm uit Artikel 177 lid 2 (en dan in het bijzonder onderdeel d)
#
annotatie:Artikel177lid2WVW a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0006622&hoofdstuk=XI&artikel=177&lid=2&z=2026-09-01&g=2026-09-01>;
  ];
  oa:body "Hier wordt de strafdreiging geformuleerd voor regels die krachtens deze wet zijn bepaald, mits expliciet als strafbaar aangewezen. Is de handeling nu het object, en 'met hechtenis...' nu een conditie ten aanzien van de manier van straffen?";
.
annotatie:Artikel177lid2WVW.Object a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0006622&hoofdstuk=XI&artikel=177&lid=2&z=2026-09-01&g=2026-09-01>;
    oa:selector [oa:start 1; oa:end 15], [oa:start 989; oa:end 1094]
  ];
  oa:body lg:Object
.
annotatie:Artikel177lid2WVW.NormExpression a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0006622&hoofdstuk=XI&artikel=177&lid=2&z=2026-09-01&g=2026-09-01>;
    oa:selector [oa:start 1098; oa:end 1111]
  ];
  oa:body lg:NormExpression
.
annotatie:Artikel177lid2WVW.Condition a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0006622&hoofdstuk=XI&artikel=177&lid=2&z=2026-09-01&g=2026-09-01>;
    oa:selector [oa:start 1113; oa:end 1191]
  ];
  oa:body lg:Condition
.

#
# Norm uit Artikel 92 lid 1 RVV
#
annotatie:Artikel92lid1RVV a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=VII&artikel=92&lid=1&z=2026-07-01&g=2026-07-01>;
  ];
  oa:body "Dit maakt dat overtreden van artikel 11 en 12 als strafbaar wordt gesteld. Maar als sprake is van 13, dan (dus) niet (meer) van 11. Dit lijkt een bepaling waarbij een iets andere grammatica nodig is dan de normgrammatica. Het constitueert iets, namelijk deze handelingen als strafbare feiten.";
.
annotatie:Artikel92lid1RVV.Object a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=VII&artikel=92&lid=1&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 1; oa:end 231]
  ];
  oa:body lg:Object
.

#
# Norm uit Artikel 2 WAHV
#
annotatie:Artikel2lid1WAHV a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004581&hoofdstuk=II&artikel=2&lid=1&z=2026-09-01&g=2026-09-01>;
  ];
  oa:body "Twee bepalingen in dit lid. De 1e regelt een bevoegdheid, de 2e beschrijft een gevolg van het toepassen van die bevoegdheid. Ook hier lijkt de normgrammatica niet het meest geschikt.";
.
annotatie:Artikel2lid1WAHV.Condition1 a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004581&hoofdstuk=II&artikel=2&lid=1&z=2026-09-01&g=2026-09-01>;
    oa:selector [oa:start 1; oa:end 275], [oa:start 285; oa:end 316]
  ];
  oa:body lg:Condition;
.
annotatie:Artikel2lid1WAHV.NormExpression1 a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004581&hoofdstuk=II&artikel=2&lid=1&z=2026-09-01&g=2026-09-01>;
    oa:selector [oa:start 278; oa:end 283], [oa:start 343; oa:end 357]
  ];
  oa:body lg:NormExpression;
.
annotatie:Artikel2lid1WAHV.Object1 a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004581&hoofdstuk=II&artikel=2&lid=1&z=2026-09-01&g=2026-09-01>;
    oa:selector [oa:start 318; oa:end 341]
  ];
  oa:body lg:Object;
.
