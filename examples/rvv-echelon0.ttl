#
# Norm uit Artikel 11, lid 4 RVV
#
annotatie:Artikel11lid4RVV a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=4&z=2026-07-01&g=2026-07-01>;
  ];
  oa:body "Vierde lid. De eerste 'bestuurder' en de tweede 'bestuurder' vervullen een andere functie. Maar dat is eigenlijk alleen zichtbaar door de conditie. Hoort die dan niet bij de respectievelijke bestuurder? Want hoewel 'rechts' ook onderdeel is van de conditie, vervult deze een toch net iets andere functie dan de tekst vlak daarvoor. Maar als we dat in dit lid zo doen, waarom dan niet in lid 2?";
.
annotatie:Artikel11lid4RVV.PrimarySubject a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=4&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 2; oa:end 12]
  ];
  oa:body lg:PrimarySubject;
.
annotatie:Artikel11lid4RVV.Condition a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=4&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 14; oa:end 59], [oa:start 79; oa:end 120], [oa:start 122; oa:end 127]
  ];
  oa:body lg:Condition;
.
annotatie:Artikel11lid4RVV.NormExpression a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=4&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 61; oa:end 65], [oa:start 129; oa:end 135]
  ];
  oa:body lg:NormExpression;
.
annotatie:Artikel11lid4RVV.SecondarySubject a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=4&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 67; oa:end 77]
  ];
  oa:body lg:SecondarySubject;
.

#
# Norm uit Artikel 11, lid 5 RVV
#
annotatie:Artikel11lid5RVV a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=5&z=2026-07-01&g=2026-07-01>;
  ];
  oa:body "Vijfde lid. Dat het hier niet over 'trambestuurders' maar 'trams' gaat, lijkt vooral praktisch taalgebruik te zijn";
.
annotatie:Artikel11lid5RVV.PrimarySubject a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=5&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 2; oa:end 12]
  ];
  oa:body lg:PrimarySubject;
.
