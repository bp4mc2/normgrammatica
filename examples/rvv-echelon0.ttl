  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=3&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 54; oa:end 71]
  ];
  oa:body lg:SecondarySubject;
.
