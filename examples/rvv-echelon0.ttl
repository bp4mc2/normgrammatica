  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=3&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 44; oa:end 46]
  ];
  oa:body lg:PrimarySubject;
.
annotatie:Artikel11lid3RVV.NormExpression2 a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=3&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 48; oa:end 52], [oa:start 80; oa:end 86]
  ];
  oa:body lg:NormExpression;
.
