PREFIX cnt:  <http://www.w3.org/2011/content#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX eli:  <http://data.europa.eu/eli/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX oa: <http://www.w3.org/ns/oa#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

PREFIX lg: <http://bp4mc2.org/legalgrammar/>

PREFIX annotatie: <http://bp4mc2.org/legalgrammar/examples/annotations/>

#
# Norm uit Artikel 11, lid 1 RVV
#
annotatie:Artikel11lid1RVV a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=1&z=2026-07-01&g=2026-07-01>;
  ];
  oa:body "Is 'inhalen' hier nu het object, of juist onderdeel van de normexpressie? Het is immers onderdeel van het werkwoordelijk gezegde. Als 'inhalen' hier het object is, waarom is dan 'inwilligen' juist geen object, maar onderdeel van de normexpressie?";
.

annotatie:Artikel11lid1RVV.NormExpression a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=1&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 1; oa:end 17]
  ];
  oa:body lg:NormExpression;
.

annotatie:Artikel11lid1RVV.Condition a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=1&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 19; oa:end 23]
  ];
  oa:body lg:Condition;
.

#
# Norm uit Artikel 11, lid 2 RVV
#
annotatie:Artikel11lid2RVV a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=2&z=2026-07-01&g=2026-07-01>;
  ];
  oa:body "Tweede lid. 'Bestuurder' lijkt hier het secundair subject? En 'rechts' is ook een soort conditie, maar wel een andere dan 'die links...'";
.
annotatie:Artikel11lid2RVV.SecondarySubject a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=2&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 2; oa:end 12]
  ];
  oa:body lg:SecondarySubject;
.
annotatie:Artikel11lid2RVV.Condition a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=2&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 14; oa:end 106], [oa:start 116; oa:end 121]
  ];
  oa:body lg:Condition;
.
annotatie:Artikel11lid2RVV.NormExpression a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=2&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 109; oa:end 114], [oa:start 123; oa:end 131]
  ];
  oa:body lg:NormExpression;
.

#
# Norm uit Artikel 11, lid 3 RVV
#
annotatie:Artikel11lid3RVV a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=3&z=2026-07-01&g=2026-07-01>;
  ];
  oa:body "Derde lid. Bevat eigenlijk twee normexpressies. 'elkaar' verhoudt zich puur grammaticaal als secondair subject. Draai in die zinnen de twee secundaire objecten maar eens om...";
.
annotatie:Artikel11lid3RVV.PrimarySubject1 a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=3&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 2; oa:end 9]
  ];
  oa:body lg:PrimarySubject;
.
annotatie:Artikel11lid3RVV.SecondarySubject1 a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=3&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 18; oa:end 23]
  ];
  oa:body lg:SecondarySubject;
.
