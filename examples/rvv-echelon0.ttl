  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=5&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 14; oa:end 18], [oa:start 33; oa:end 39]
  ];
  oa:body lg:NormExpression;
.
annotatie:Artikel11lid5RVV.SecondarySubject a oa:Annotation;
  oa:target [
    oa:source <jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=2&artikel=11&lid=5&z=2026-07-01&g=2026-07-01>;
    oa:selector [oa:start 20; oa:end 24]
  ];
  oa:body lg:SecondarySubject;
.
