PREFIX :       <http://data.europa.eu/eli/ontology#>
PREFIX crm:    <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX dc:     <http://purl.org/dc/elements/1.1/>
PREFIX eli:    <http://data.europa.eu/eli/ontology#>
PREFIX foaf:   <http://xmlns.com/foaf/0.1/>
PREFIX frbroo: <http://iflastandards.info/ns/fr/frbr/frbroo/>
PREFIX owl:    <http://www.w3.org/2002/07/owl#>
PREFIX rdakit: <http://metadataregistry.org/uri/profile/rdakit/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX regap:  <http://metadataregistry.org/uri/profile/regap/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX terms:  <http://purl.org/dc/terms/>
PREFIX vann:   <http://purl.org/vocab/vann/>
PREFIX xml:    <http://www.w3.org/XML/1998/namespace>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

eli:WorkTypeTable  rdf:type  skos:ConceptScheme , owl:NamedIndividual;
        rdfs:label       "Work Type Table"@en;
        skos:definition  "A set of values for the type of a work.\nELI does not include a set of values for this table."@en .

eli:FormatTypeTable  rdf:type  skos:ConceptScheme , owl:NamedIndividual;
        rdfs:comment  "A set of types for a Format.\nELI includes a list of values for this table.\nThis should contain user-oriented types to dinstinguish e.g. authentic PDF from scanned PDF from generated-on-the-fly PDF; or e.g. XML in a standard (AkomaNtoso) format vs. XML in a proprietary format."@en;
        rdfs:label    "Format type table"@en .

eli:LegalValue-authoritative
        rdf:type          skos:Concept , eli:LegalValue , owl:NamedIndividual;
        owl:versionInfo   "created in v1.0"@en , "modified in v1.1"@en;
        skos:broader      eli:LegalValue-official;
        skos:definition   "The publisher gives some special status to the publication of the document. (\"The Queens Printer\" version of a UK Act of Parliament). This status is specific to UK where no text can be considered « definitive »."@en;
        skos:example      "\"The Queens Printer\" version of a UK Act of Parliament, or the Official Journal version of a EU Directive published by EU Publications Office."@en;
        skos:historyNote  "v1.1 : improved definition"@en;
        skos:inScheme     eli:LegalValueTable;
        skos:narrower     eli:LegalValue-definitive;
        skos:prefLabel    "authoritative"@en .

<https://www.iana.org/assignments/media-types/application/pdf>
        rdf:type         eli:FormatType , owl:NamedIndividual;
        owl:versionInfo  "created in v1.2"@en;
        skos:inScheme    eli:FormatTypeTable;
        skos:prefLabel   "application/pdf" .

eli:WorkSubdivision  rdf:type  owl:Class;
        rdfs:comment     "A component of a work, at an arbitrary level of precision. A subdivision can be linked with its parent and children subdivision using eli:has_part / eli:is_part_of."@en;
        rdfs:label       "Work Subdivision"@en;
        rdfs:subClassOf  eli:Work;
        owl:versionInfo  "created in v1.4" .

frbroo:R10i_is_member_of
        rdf:type  owl:ObjectProperty .

eli:FormatType  rdf:type     owl:Class;
        rdfs:comment         "Formally defined as the set of skos:Concept in concept scheme eli:MediaTypeTable."@en;
        rdfs:label           "Format type"@en;
        rdfs:subClassOf      skos:Concept;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( skos:Concept
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    eli:FormatTypeTable;
                                                       owl:onProperty  skos:inScheme
                                                     ]
                                                   )
                             ];
        owl:versionInfo      "created in v1.2"@en .

eli:refers_to  rdf:type         owl:ObjectProperty;
        rdfs:comment            "Any entity that this work or expression refers to ; typically references are made to other Works, but it can be also to legislative processes, persons, etc.\n\nNote that specific subproperties exist in ELI-DL to describe future legal impacts (\\\"foresees_xxxx\\\" links) and links between amendments and draft legislation.\n\nExample : an opinion refers to the specific version of the draft legislation on which it is based."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:Expression eli:Work )
                                ];
        rdfs:label              "refers to"@en;
        rdfs:range              owl:Thing;
        eli:specificPropertyOf  terms:relation;
        owl:versionInfo         "created in v1.5" .

eli:InForceTable  rdf:type  skos:ConceptScheme , owl:NamedIndividual;
        rdfs:label       "In force table"@en;
        skos:definition  "A set of values for the legal force of a resource.\nELI includes a set of values for this table."@en .

eli:has_derivative  rdf:type    owl:ObjectProperty;
        rdfs:comment            "Inverse of is_derivative_of"@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:Expression eli:Work )
                                ];
        rdfs:label              "has derivative"@en;
        rdfs:range              [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:Expression eli:Work )
                                ];
        eli:specificPropertyOf  terms:relation;
        owl:inverseOf           eli:is_derivative_of;
        owl:versionInfo         "created in v1.4"@en .

eli:date_document  rdf:type     owl:FunctionalProperty , owl:DatatypeProperty;
        rdfs:comment            "Date of adoption or signature (of the form yyyy-mm-dd)"@en;
        rdfs:domain             eli:Work;
        rdfs:label              "date of the document"@en;
        rdfs:range              xsd:date;
        eli:specificPropertyOf  terms:date;
        owl:versionInfo         "created in v1.0\nmodified in v1.4";
        skos:historyNote        "v1.4 : broaden domain to Work"@en .

skos:topConceptOf  rdf:type  owl:AnnotationProperty .

eli:rights  rdf:type            owl:DatatypeProperty , owl:FunctionalProperty;
        rdfs:comment            "Information about rights held in and over the resource (definition from Dublin Core). For example, that property can be used to provide a link to a page that describes the licensing terms."@en;
        rdfs:domain             eli:Format;
        rdfs:label              "rights"@en;
        rdfs:range              rdfs:Literal;
        eli:specificPropertyOf  terms:rights;
        owl:versionInfo         "modified in v1.2" , "created in v1.0";
        skos:historyNote        "v1.1 : improved definition and changed the range to xsd:string"@en , "v1.2 : modified the range to rdfs:Literal"@en .

eli:publishes  rdf:type  owl:ObjectProperty;
        rdfs:comment     "Inverse of \"published_in_format\". Note this property does not link a publisher with a resource, but rather a specific Format of a resource with a specific Format of another resource, indicating that the subject Format publishes the object Format."@en;
        rdfs:domain      eli:Format;
        rdfs:label       "publishes"@en;
        rdfs:range       eli:Format;
        owl:versionInfo  "modified in v1.1"@en , "created in v1.0" .

eli:Format  rdf:type      owl:Class;
        rdfs:comment      "The physical embodiment of a legal expression, either on paper or in any electronic format.\nFor example, any electronic or physical format of the legal expression (XML, TIFF, PDF, etc.) ; e.g. PDF version of act 3 of 2005.  (adapted from Akoma Ntoso).\nNote that the notion of Format in ELI is more precise than a FRBR Manifestation in the sense that a Format in ELI can carry a legal value (see the property eli:legal_value)."@en;
        rdfs:label        "Format"@en;
        rdfs:subClassOf   eli:Manifestation;
        rdfs:subClassOf   [ rdf:type         owl:Restriction;
                            owl:cardinality  "1"^^xsd:nonNegativeInteger;
                            owl:onProperty   eli:format
                          ];
        owl:versionInfo   "modified in v1.3" , "created in v1.0";
        skos:historyNote  "v1.3 : declared as a sublcass of eli:Manifestation\nv1.2 : replaced reference of RDA with FRBRoo (for more information on FRBRoo, see https://www.ifla.org/node/10171) ."@en .

eli:is_embodied_by  rdf:type  owl:ObjectProperty;
        rdfs:comment        "Relates an expression to a manifestation of that expression. Inverse of \"embodies\"."@en;
        rdfs:domain         eli:Expression;
        rdfs:label          "is embodied by"@en;
        rdfs:range          eli:Manifestation;
        rdfs:subPropertyOf  frbroo:R4_carriers_provided_by;
        owl:versionInfo     "modified in v1.3" , "created in v1.0";
        skos:historyNote    "v1.3 : broaden the domain to Expression instead of LegalExpression and the range to Manifestation instead of Format.\nv1.2 : replaced reference of RDA with FRBRoo."@en .

eli:LegalValue  rdf:type     owl:Class;
        rdfs:comment         "Formally defined as the set of skos:Concept in concept scheme eli:LegalValueTable"@en;
        rdfs:label           "Legal value"@en;
        rdfs:subClassOf      skos:Concept;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( skos:Concept
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    eli:LegalValueTable;
                                                       owl:onProperty  skos:inScheme
                                                     ]
                                                   )
                             ];
        owl:versionInfo      "created in v1.0" .

eli:media_type  rdf:type        owl:ObjectProperty;
        rdfs:comment            "The file format of the manifestation.\nThis field is intended to capture the technical file format and will serve as a basis for content negotiation for the server to return the appropriate file based on the client preference.\nAlthough not mandatory, this property is highly encouraged.\nPossible URIs values MUST be taken from http://www.iana.org/assignments/media-types (e.g. http://www.iana.org/assignments/media-types/application/xml).\nSee also the \"format\" property."@en;
        rdfs:domain             eli:Manifestation;
        rdfs:label              "media type"@en;
        rdfs:range              owl:Thing;
        rdfs:seeAlso            eli:format;
        eli:specificPropertyOf  terms:format;
        owl:versionInfo         "modified in v1.3" , "created in v1.2";
        skos:historyNote        "v1.3 : broaden the domain to Manifestation instead of Format"@en .

eli:published_in_format
        rdf:type         owl:ObjectProperty;
        rdfs:comment     "Reference to the Official Journal or other publication manifestation in which this format is published.\nThis property should be used when the value can be identified by a suitable URI; in the absence of such a URI, the property \"published_in\" should be used with a string value."@en;
        rdfs:domain      eli:Format;
        rdfs:label       "published in format"@en;
        rdfs:range       eli:Format;
        rdfs:seeAlso     eli:published_in;
        owl:inverseOf    eli:publishes;
        owl:versionInfo  "created in v1.1"@en .

eli:InForce-inForce  rdf:type  owl:NamedIndividual , eli:InForce , skos:Concept;
        owl:versionInfo    "modified in v1.1"@en , "created in v1.0"@en;
        skos:definition    "Indicates that a legal resource is in force."@en;
        skos:historyNote   "v1.1 : improved definition"@en;
        skos:inScheme      eli:InForceTable;
        skos:prefLabel     "in force"@en;
        skos:topConceptOf  eli:InForceTable .

eli:format  rdf:type            owl:ObjectProperty;
        rdfs:comment            "The format of the manifestation, expressed as a custom URI.\nThis field is intended to capture the format of the resource from an application or user perspective, as opposed to the \"media_type\" property that expresses its format from a technical point of view. This property allows to describe different XML schemas (Akoma N'toso vs. proprietary), describe different types of PDFs (scanned PDF, generated-on-the-fly PDF, signed PDF, archival PDF) or describe the paper (printed) version of the legislation.\nELI includes a set of possible values for the most common use-cases and possible URIs values CAN also be taken from http://www.iana.org/assignments/media-types , or can de defined by the Member States."@en;
        rdfs:domain             eli:Manifestation;
        rdfs:label              "format"@en;
        rdfs:range              eli:FormatType;
        rdfs:seeAlso            eli:media_type;
        eli:specificPropertyOf  terms:format;
        owl:versionInfo         "created in v1.0" , "modified in v1.3";
        skos:historyNote        "v1.3 : broaden the domain to Manifestation instead of Format.\nv1.2 : this field should now not be used as basis of content negociation. Modified the description to introduce eli:media_type and declared a local ConceptScheme FormatType with values."@en .

eli:publisher  rdf:type         owl:DatatypeProperty;
        rdfs:comment            "An entity responsible for making the resource available (definition from Dublin Core).\nThis property should be used when the value cannot be identified by a suitable URI; if a URI is available, the property \"publisher_agent\" should be used."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:Format eli:LegalExpression )
                                ];
        rdfs:label              "publisher"@en;
        rdfs:range              rdfs:Literal;
        rdfs:seeAlso            eli:publisher_agent;
        eli:specificPropertyOf  terms:publisher;
        owl:versionInfo         "created in v1.0" , "modified in v1.2";
        skos:historyNote        "v1.1 : modified the range to xsd:string and introduced the corresponding object property publisher_agent."@en , "v1.2 : changed range from xsd:string to rdfs:Literal"@en .

eli:repeals  rdf:type       owl:ObjectProperty;
        rdfs:comment        "Indicates that this legal resource or legal expression completely cancels, abrogates or replaces another. If a resource partially repeals another, this link can be used at the corresponding subdivision level being completely repealed."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                            ];
        rdfs:label          "repeals"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                            ];
        rdfs:subPropertyOf  eli:changes;
        owl:versionInfo     "created in v1.1"@en .

eli:is_exemplified_by
        rdf:type            owl:ObjectProperty;
        rdfs:comment        "Link to a concrete file URL.\nRelates a manifestation to a single exemplar or instance of that manifestation."@en;
        rdfs:domain         eli:Manifestation;
        rdfs:label          "is exemplified by"@en;
        rdfs:subPropertyOf  frbroo:R7i_has_example;
        owl:versionInfo     "modified in v1.3" , "created in v1.0";
        skos:historyNote    "v1.3 : broaden the domain to Manifestation instead of Format.\nv1.2 : replaced reference of RDA with FRBRoo."@en .

frbroo:R7i_has_example
        rdf:type  owl:ObjectProperty .

eli:Work  rdf:type       owl:Class;
        rdfs:comment     "Any distinct intellectual creation (i.e., the intellectual content), in the context of ELI.\n\nThe substance of Work is ideas."@en;
        rdfs:label       "Work"@en;
        rdfs:subClassOf  frbroo:F1_Work;
        owl:versionInfo  "created in v1.3" .

eli:rightsholder_agent
        rdf:type                owl:ObjectProperty;
        rdfs:comment            "A person or organisation owning or managing rights over the resource (definition from Dublin Core).\nThis property should be used when the value can be identified by a suitable URI; in the absence of such a URI, the property \"rightsholder\" should be used with a string value."@en;
        rdfs:domain             eli:Format;
        rdfs:label              "rightsholder agent"@en;
        rdfs:range              eli:Agent;
        rdfs:seeAlso            eli:rightsholder;
        eli:specificPropertyOf  terms:rightsholder;
        owl:versionInfo         "created in v1.1"@en .

frbroo:R10_has_member
        rdf:type  owl:ObjectProperty .

eli:LegalResource  rdf:type  owl:Class;
        rdfs:comment      "A work in a legislative corpus. This applies to acts that have been legally enacted (whether or not they are still in force).\nFor example, the abstract concept of the legal resource; e.g. \"act 3 of 2005\" (adapted from Akoma Ntoso)\n\nA legal resource can represent a legal act or any component of a legal act, like an article.  Legal resources can be linked together using properties defined in the model.\n\nNote that ELI ontology accommodates different point of view on what should be considered a new legal resource, or a new legal expression of the same resource. Typically, a consolidated version can be viewed, in the context of ELI, either as separate legal resource (linked to original version and previous consolidated version using corresponding ELI relations), or as a different legal expression of the same legal resource."@en;
        rdfs:label        "Legal Resource"@en;
        rdfs:subClassOf   eli:Work;
        owl:versionInfo   "modified in v1.3" , "created in v1.0";
        skos:historyNote  "v1.3 : declared as a subclass of eli:Work\nv1.2 : replaced reference of RDA with FRBRoo (for more information on FRBRoo, see https://www.ifla.org/node/10171) ."@en .

eli:Version  rdf:type        owl:Class;
        rdfs:comment         "Formally defined as the set of skos:Concept in concept scheme eli:VersionTable"@en;
        rdfs:label           "Version"@en;
        rdfs:subClassOf      skos:Concept;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( skos:Concept
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    eli:VersionTable;
                                                       owl:onProperty  skos:inScheme
                                                     ]
                                                   )
                             ];
        owl:versionInfo      "created in v1.0" .

frbroo:R3_is_realised_in
        rdf:type  owl:ObjectProperty .

eli:specificPropertyOf
        rdf:type      owl:AnnotationProperty;
        rdfs:comment  "Indicates that a property is, in a generic sense, a more specific property of another one. This does not entail the same logical reasoning as rdfs:subPropertyOf.\nThis is used to indicate the alignement to Dublin Core properties, without redeclaring the Dublin Core property in Protégé, and without commiting to choose that a DubinCore property is either a datatype or an object property."@en;
        rdfs:label    "specific property of"@en .

eli:changes  rdf:type           owl:ObjectProperty;
        rdfs:comment            "Indicates that this work or expression legally changes another. This encompasses the notions of amendment, replacement, repeal, or other types of change. This may be a direct change (textual or non-textual amendment) or a consequential or indirect change. Note, the property is to be used to express the existence of a change relationship between two acts rather than the existence of a consolidated version of the text that shows the result of the change. For consolidation relationships, use the \"consolidates\" and \"consolidated_by\" properties."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:Expression eli:Work )
                                ];
        rdfs:label              "changes"@en;
        rdfs:range              [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:Expression eli:Work )
                                ];
        eli:specificPropertyOf  terms:relation;
        owl:versionInfo         "modified in v1.4"@en , "created in v1.0";
        skos:historyNote        "v1.4 : broaden to Work or Expression\nv1.1 : improved definition"@en .

<https://www.iana.org/assignments/media-types/text/plain>
        rdf:type         eli:FormatType , owl:NamedIndividual;
        owl:versionInfo  "created in v1.2"@en;
        skos:inScheme    eli:FormatTypeTable;
        skos:prefLabel   "text/plain" .

eli:has_member  rdf:type        owl:ObjectProperty;
        rdfs:comment            "Indicates that this work conceptually includes another one. For the notion of physical inclusion, use eli:has_part."@en;
        rdfs:domain             eli:Work;
        rdfs:label              "has member"@en;
        rdfs:range              eli:Work;
        rdfs:seeAlso            "modified in v1.2";
        rdfs:subPropertyOf      frbroo:R10_has_member;
        eli:specificPropertyOf  terms:hasPart;
        owl:inverseOf           eli:is_member_of;
        owl:versionInfo         "created in v1.1";
        skos:historyNote        "v1.3 : broaden the domain and range to Work instead of LegalResource\nv1.2 : replaced reference of RDA with FRBRoo."@en .

eli:jurisdiction  rdf:type  owl:ObjectProperty;
        rdfs:comment        "The jurisdiction from which the legal resource originates. \n\nThe place identifier can be taken from the Administrative Territorial Unit table published of the EU Publications Office at https://op.europa.eu/en/web/eu-vocabularies/at-dataset/-/resource/dataset/atu. Member States don't have to recreate their own list of values."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                            ];
        rdfs:label          "jurisdiction"@en;
        rdfs:range          eli:AdministrativeArea;
        rdfs:subPropertyOf  eli:relevant_for;
        owl:versionInfo     "modified in v1.3" , "created in v1.1"@en;
        skos:historyNote    "v1.3 : Updated link to EU vocabularies website in the definition."@en .

frbroo:F22_Self-Contained_Expression
        rdf:type  owl:Class .

eli:ResourceType  rdf:type   owl:Class;
        rdfs:comment         "Formally defined as the set of skos:Concept in concept scheme eli:ResourceTypeTable"@en;
        rdfs:label           "Resource type"@en;
        rdfs:subClassOf      skos:Concept;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( skos:Concept
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    eli:ResourceTypeTable;
                                                       owl:onProperty  skos:inScheme
                                                     ]
                                                   )
                             ];
        owl:versionInfo      "created in v1.0" .

eli:first_date_entry_in_force
        rdf:type            owl:FunctionalProperty , owl:DatatypeProperty;
        rdfs:comment        "The first date any part of the legal resource or legal expression came into force (can be seen as the start date of a dc:valid range for this resource)"@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                            ];
        rdfs:label          "first date of entry into force"@en;
        rdfs:range          xsd:date;
        rdfs:seeAlso        eli:date_no_longer_in_force;
        rdfs:subPropertyOf  owl:topDataProperty;
        owl:versionInfo     "created in v1.0" .

eli:AdministrativeAreaTable
        rdf:type         skos:ConceptScheme , owl:NamedIndividual;
        rdfs:label       "Administrative area table"@en;
        skos:definition  "A set of values for administrative areas.\nELI does not include a set of values for this table."@en .

eli:uri_schema  rdf:type  owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment     "Schema describing the URI of an ELI instance. ELI uses URI template specifications (IETF RFC 6570). Schemes should be associated with member states and will be published in a registry."@en;
        rdfs:domain      [ rdf:type     owl:Class;
                           owl:unionOf  ( eli:Format eli:LegalExpression eli:LegalResource )
                         ];
        rdfs:label       "uri schema"@en;
        rdfs:range       owl:Thing;
        owl:versionInfo  "created in v1.0" .

<https://www.iana.org/assignments/media-types/application/pdf;type=signed>
        rdf:type         eli:FormatType , owl:NamedIndividual;
        owl:versionInfo  "created in v1.2"@en;
        skos:prefLabel   "application/pdf;type=signed";
        skos:scopeNote   "ELI introduces this value to describe PDF files that are signed electronically."@en .

eli:consolidated_by  rdf:type   owl:ObjectProperty;
        rdfs:comment            "Inverse of \"consolidates\". Indicates that this legal resource or expression is taken into account in a consolidated text (which is usually the product of an editorial process that revises the legislation)."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                                ];
        rdfs:label              "consolidated by"@en;
        rdfs:range              [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                                ];
        eli:specificPropertyOf  terms:relation;
        owl:inverseOf           eli:consolidates;
        owl:versionInfo         "created in v1.0" , "modified in v1.1"@en;
        skos:historyNote        "v1.1 : improved definition"@en .

eli:passed_by  rdf:type         owl:ObjectProperty;
        rdfs:comment            "The person or organization that originally passed or made the law : typically parliament (for primary legislation) or government (for secondary legislation). This indicates the \"legal author\" of the law, as opposed to its physical author. \n\nThis property can be used multiple times to indicate both the agent that authored the text, and/or the agent that signed the text, thus turning it into an actual legislation.\n\nThe relationship between current and any former law making body should be represented in the description of the agent itself.\n\nMember states are encouraged to make their own list of Agents. EU Publications Office provides a list of corporate bodies at https://op.europa.eu/en/web/eu-vocabularies/at-dataset/-/resource/dataset/corporate-body."@en;
        rdfs:domain             eli:LegalResource;
        rdfs:label              "passed by"@en;
        rdfs:range              eli:Agent;
        eli:originalName        "agent_document"@en;
        eli:specificPropertyOf  terms:creator;
        owl:versionInfo         "modified in v1.3" , "created in v1.0";
        skos:historyNote        "v1.3 : Updated link to EU vocabularies website in the definition.\nIn v1.1, the semantic of this property was broaden to encompass organisations/persons that « drafted the text » and « signed it »."@en .

eli:date_applicability
        rdf:type         owl:DatatypeProperty;
        rdfs:comment     "The date at which the legislation becomes applicable. This is distinct from the date of entry into force : a text may come in force today, and state it will become applicable in 3 months.\n\nThe group notes that applicability dates can lead to complex situations, e.g. a text with different applicability dates for different jurisdictions; specific extensions to the model should be used for such situations."@en;
        rdfs:domain      [ rdf:type     owl:Class;
                           owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                         ];
        rdfs:label       "date of applicability"@en;
        rdfs:range       xsd:date;
        owl:versionInfo  "created in v1.1"@en .

eli:changed_by  rdf:type        owl:ObjectProperty;
        rdfs:comment            "Inverse of « changes ». Indicates that this work or expression is being legally changed by another. This encompasses the notions of amendment, replacement, repeal, or other types of change."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:Expression eli:Work )
                                ];
        rdfs:label              "changed by"@en;
        rdfs:range              [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:Expression eli:Work )
                                ];
        eli:specificPropertyOf  terms:relation;
        owl:inverseOf           eli:changes;
        owl:versionInfo         "created in v1.0" , "modified in v1.4"@en;
        skos:historyNote        "v1.4 : broaden to Work or Expression\nv1.1 : improved definition"@en .

eli:published_in  rdf:type  owl:DatatypeProperty;
        rdfs:comment      "Reference to the Official Journal or other publication manifestation in which this format is published.\nThis property should be used when the value cannot be identified by a suitable URI; if a URI is available, the property \"published_in_format\" should be used."@en;
        rdfs:domain       eli:Format;
        rdfs:label        "published in"@en;
        rdfs:range        rdfs:Literal;
        rdfs:seeAlso      eli:published_in_format;
        owl:versionInfo   "modified in v1.2" , "created in v1.0";
        skos:historyNote  "v1.2 : changed range from xsd:string to rdfs:Literal"@en , "v1.1 : modified the range to xsd:string, and introduced the corresponding object property published_in_format."@en .

eli:responsibility_of_agent
        rdf:type         owl:ObjectProperty;
        rdfs:comment     "An individual, organisation or organisational unit that has some kind of responsibility for the legislation. Typically the ministry who is/was in charge of elaborating the legislation, or the adressee for potential questions about the legislation once it is published.\nThis property should be used when the value can be identified by a suitable URI; in the absence of such a URI, the property \"responsibility_of\" should be used with a string value."@en;
        rdfs:domain      eli:LegalResource;
        rdfs:label       "responsibility of agent"@en;
        rdfs:range       eli:Agent;
        rdfs:seeAlso     eli:responsibility_of;
        owl:versionInfo  "created in v1.1"@en .

eli:ComplexWork  rdf:type  owl:Class;
        rdfs:comment     "Works that have other works as members. The members of a Complex Work may constitute alternatives to or derivatives of other members of the same Complex Work. Typically the members of the complex work represent the successive temporal versions of an act, while the complex work represents the act independantly of one of its version."@en;
        rdfs:label       "Complex Work";
        rdfs:subClassOf  eli:Work;
        owl:versionInfo  "created in v1.4" .

eli:ensures_implementation_of
        rdf:type            owl:ObjectProperty;
        rdfs:comment        "Indicates that this LegalResource ensures the implementation of another LegalResource. This implies a legal meaning (contrary to eli:applies).\n\nThis can cover links from national legislation to EU legislation, or links from regional to national legislation. It can also cover links from EU implementing acts to EU legislative acts. In the case of implementation of EU legislation at national level, this covers links to EU regulations, decisions, etc. However the transpositions of EU Directives must be captured with eli:transposes.\n\nLinks between national primary and secondary legislation must be captured by eli:based_on / eli:basis_for."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                            ];
        rdfs:label          "ensures implementation of"@en;
        rdfs:range          eli:LegalResource;
        rdfs:seeAlso        eli:transposes;
        rdfs:subPropertyOf  eli:applies;
        owl:inverseOf       eli:implementation_ensured_by;
        owl:versionInfo     "created in v1.3" .

xsd:date  rdf:type  rdfs:Datatype .

eli:Agent  rdf:type       owl:Class;
        rdfs:comment      "Individual people or groups of people, like an institution with a legal recognition, who have the potential to perform intentional actions for which they can be held responsible."@en;
        rdfs:label        "Agent"@en;
        rdfs:subClassOf   crm:E39_Actor;
        owl:versionInfo   "modified in v1.4" , "created in v1.0";
        skos:historyNote  "V1.4 : subClassOf E39_ACtor instead of equivalent.\nV1.3 : added a definition."@en .

eli:has_another_publication
        rdf:type                owl:ObjectProperty;
        rdfs:comment            "Inverse of \"is_another_publication_of\"."@en;
        rdfs:domain             eli:LegalResource;
        rdfs:label              "has another publication"@en;
        rdfs:range              eli:LegalResource;
        eli:specificPropertyOf  terms:relation;
        owl:inverseOf           eli:is_another_publication_of;
        owl:versionInfo         "created in v1.1"@en .

eli:commenced_by  rdf:type  owl:ObjectProperty;
        rdfs:comment        "Inverse of \"commences\". Indicates that this legal resource was set in force by another legal resource.\nSituations where a resource enters into force because of more than one resource are explicitely allowed."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                            ];
        rdfs:label          "commenced by"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                            ];
        rdfs:subPropertyOf  eli:changed_by;
        owl:inverseOf       eli:commences;
        owl:versionInfo     "created in v1.1"@en .

eli:rightsholder  rdf:type      owl:DatatypeProperty;
        rdfs:comment            "A person or organisation owning or managing rights over the resource (definition from Dublin Core).\nThis property should be used when the value cannot be identified by a suitable URI; if a URI is available, the property \"rightsholder_agent\" should be used."@en;
        rdfs:domain             eli:Format;
        rdfs:label              "rights holder"@en;
        rdfs:range              rdfs:Literal;
        eli:specificPropertyOf  terms:rightsHolder;
        owl:versionInfo         "modified in v1.2" , "created in v1.0";
        skos:historyNote        "v1.1 : modified the range to xsd:string, and introduced the corresponding object property rightsholder_agent."@en , "v1.2 : modified the range to rdfs:Literal"@en .

eli:version  rdf:type    owl:ObjectProperty;
        rdfs:comment     "A skos concept scheme, could be locally defined? Group proposal is to start with an initial ELI scheme, that might include concepts of \"Official Journal\" \"made\" \"consolidated\" \"proposed\" \"prospective\""@en;
        rdfs:domain      [ rdf:type     owl:Class;
                           owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                         ];
        rdfs:label       "version"@en;
        rdfs:range       eli:Version;
        rdfs:seeAlso     eli:version_date;
        owl:versionInfo  "created in v1.0" .

eli:is_annex_of  rdf:type       owl:ObjectProperty;
        rdfs:comment            "Indicates this work or expression is an annex of another one."@en;
        rdfs:label              "is annex of"@en;
        eli:specificPropertyOf  terms:relation;
        skos:historyNote        "created in v1.4"@en .

eli:date_no_longer_in_force
        rdf:type            owl:FunctionalProperty , owl:DatatypeProperty;
        rdfs:comment        "The last date any part of the legislation is in force, if the date is known (can be seen as the end date of a dc:valid range for this resource)."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                            ];
        rdfs:label          "date no longer in force"@en;
        rdfs:range          xsd:date;
        rdfs:seeAlso        eli:first_date_entry_in_force;
        rdfs:subPropertyOf  owl:topDataProperty;
        owl:versionInfo     "modified in v1.2" , "created in v1.0";
        skos:historyNote    "v1.1 : improved definition so it symmetric to date_entry_into_force."@en , "v1.2 : improved definition"@en .

eli:responsibility_of
        rdf:type          owl:DatatypeProperty;
        rdfs:comment      "An individual, organisation or organisational unit that has some kind of responsibility for the legislation. Typically the ministry who is/was in charge of elaborating the legislation, or the adressee for potential questions about the legislation once it is published.\nThis property should be used when the value cannot be identified by a suitable URI; if a URI is available, the property \"responsibility_of_agent\" should be used."@en;
        rdfs:domain       eli:LegalResource;
        rdfs:label        "responsibility of"@en;
        rdfs:range        xsd:string;
        rdfs:seeAlso      eli:responsibility_of_agent;
        eli:originalName  "service"@en;
        owl:versionInfo   "modified in v1.1"@en , "created in v1.0";
        skos:historyNote  "v1.1 : the definition was made more precise, with examples. Introduced the corresponding object property responsibility_of_agent."@en .

eli:id_local  rdf:type          owl:DatatypeProperty;
        rdfs:comment            "The unique identifier used in a local reference system to maintain backwards compatibility. For examples the CELEX at EU level, or the NOR in France."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:Format eli:LegalExpression eli:LegalResource )
                                ];
        rdfs:label              "local id"@en;
        rdfs:range              [ rdf:type     rdfs:Datatype;
                                  owl:unionOf  ( xsd:anyURI xsd:string )
                                ];
        eli:specificPropertyOf  terms:identifier;
        owl:versionInfo         "created in v1.0" .

eli:legal_value  rdf:type  owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment     "The legal value associated with a specific format of a resource. A set of values is defined by ELI in the corresponding concept scheme. These values are :\n  - unofficial : no particular or special standing;\n  - official : published by an organisation with the public task of making the information available (e.g. a consolidated version of a EU directive) ;\n  - authoritative : the publisher gives some special status to the publication (e.g. \"the Queens Printer\" version of an Act of Parliament, or the OJ version of a EU Directive);\n  - definitive : the text is conclusively what the law says, (e.g. the digitally signed version of an OJ)."@en;
        rdfs:domain      eli:Format;
        rdfs:label       "legal value"@en;
        rdfs:range       eli:LegalValue;
        rdfs:seeAlso     eli:LegalValue-unofficial , eli:LegalValue-authoritative , eli:LegalValue-definitive , eli:LegalValue-official , eli:LegalValueTable;
        owl:versionInfo  "created in v1.0" .

<https://www.iana.org/assignments/media-types/application/xml>
        rdf:type         eli:FormatType , owl:NamedIndividual;
        owl:versionInfo  "created in v1.2"@en;
        skos:inScheme    eli:FormatTypeTable;
        skos:prefLabel   "application/xml" .

eli:transposed_by  rdf:type  owl:ObjectProperty;
        rdfs:comment        "Inverse of \"transposes\".\n\nNote that this property is expressed on a legal resource, not on one of its language-specific legal expression."@en;
        rdfs:domain         eli:LegalResource;
        rdfs:label          "transposed by"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                            ];
        rdfs:subPropertyOf  eli:applied_by;
        owl:inverseOf       eli:transposes;
        owl:versionInfo     "created in v1.0";
        skos:historyNote    "v1.1 : this property was made a subproperty of \"applied_by\""@en .

eli:applied_by  rdf:type        owl:ObjectProperty;
        rdfs:comment            "Inverse of \"applies\".\n\nNote that this property is expressed on a legal resource, not on one of its language-specific legal expression."@en;
        rdfs:domain             eli:LegalResource;
        rdfs:label              "applied by"@en;
        rdfs:range              [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                                ];
        rdfs:seeAlso            eli:transposed_by;
        eli:specificPropertyOf  terms:relation;
        owl:equivalentProperty  eli:implemented_by;
        owl:inverseOf           eli:applies;
        owl:versionInfo         "created in v1.1"@en .

eli:title_short  rdf:type       owl:DatatypeProperty;
        rdfs:comment            "Established short title of the expression (if any)"@en;
        rdfs:domain             eli:Expression;
        rdfs:label              "short title"@en;
        rdfs:range              rdfs:Literal;
        eli:specificPropertyOf  terms:alternative;
        owl:versionInfo         "modified in v1.3" , "created in v1.0";
        skos:historyNote        "v1.3 : broaden the domain to Expression instead of LegalExpression\nv1.2 : changed range from xsd:string to rdfs:Literal"@en .

frbroo:F10_Person  rdf:type  owl:Class .

eli:realizes  rdf:type      owl:ObjectProperty , owl:FunctionalProperty;
        rdfs:comment        "Relates an expression to a work realised through that expression. Inverse of \"is_realized_by\"."@en;
        rdfs:domain         eli:Expression;
        rdfs:label          "realizes"@en;
        rdfs:range          eli:Work;
        rdfs:subPropertyOf  frbroo:R3i_realises;
        owl:versionInfo     "created in v1.0" , "modified in v1.2";
        skos:historyNote    "v1.3 : broaden the domain to Expression instead of LegalExpression and the range to Work instead of LegalResource\nv1.2 : replaced reference of RDA with FRBRoo."@en .

<https://www.iana.org/assignments/media-types/application/akn+xml>
        rdf:type         eli:FormatType , owl:NamedIndividual;
        rdfs:seeAlso     <https://docs.oasis-open.org/legaldocml/akn-media/v1.0/csprd01/akn-media-v1.0-csprd01.pdf>;
        owl:versionInfo  "created in v1.2"@en;
        skos:inScheme    eli:FormatTypeTable;
        skos:prefLabel   "application/akn+xml" .

eli:licence  rdf:type           owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment            "A legal document giving official permission to do something with the resource (Definition from Dublin Core)"@en;
        rdfs:domain             eli:Format;
        rdfs:label              "licence"@en;
        rdfs:range              owl:Thing;
        eli:specificPropertyOf  terms:license;
        owl:versionInfo         "created in v1.0" .

eli:LegalResourceSubdivision
        rdf:type          owl:Class;
        rdfs:comment      "A component of a legal act, at an arbitrary level of precision, like a chapter, an article, an alinea, a paragraph or an list item. A subdivision can be linked with its parent and children subdivision using the properties eli:has_part / eli:is_part_of."@en;
        rdfs:label        "Legal Resource Subdivision"@en;
        rdfs:subClassOf   eli:WorkSubdivision , eli:LegalResource;
        owl:versionInfo   "created in v1.1"@en;
        skos:historyNote  "v1.4 : added WorkSubdivision as a superclass"@en .

eli:related_to  rdf:type        owl:ObjectProperty;
        rdfs:comment            "Indicates a somehow related other document, not necessarily a legal resource. Note that citation links should use the cites property."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                                ];
        rdfs:label              "related to"@en;
        rdfs:range              owl:Thing;
        eli:specificPropertyOf  terms:relation;
        owl:versionInfo         "created in v1.0" .

eli:consolidates  rdf:type      owl:ObjectProperty;
        rdfs:comment            "Indicates that this consolidated legal resource or expression (which is usually the product of an editorial process that revises the legislation) takes into account another one. This property should be used multiple times to refer to both the original version or the previous consolidated version, and to the legislations making the change."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                                ];
        rdfs:label              "consolidates"@en;
        rdfs:range              [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                                ];
        eli:specificPropertyOf  terms:relation;
        owl:versionInfo         "modified in v1.1"@en , "created in v1.0";
        skos:historyNote        "v1.1 : improved definition"@en .

eli:originalName  rdf:type  owl:AnnotationProperty .

eli:LegalExpression  rdf:type  owl:Class;
        rdfs:comment      "The intellectual realisation of a legal resource in the form of a \"sequence of signs\" (typically alpha-numeric characters in a legal context).\nFor example, any version of the legal resource whose content is specified and different from others for any reason: language, versions, etc.;\n\nNote that ELI ontology accommodates different point of view on what should be considered a new legal resource, or a new legal expression of the same resource. Typically, a consolidated version can be viewed, in the context of ELI, either as separate legal resource (linked to original version and previous consolidated version using corresponding ELI relations), or as a different legal expression of the same legal resource."@en;
        rdfs:label        "Legal Expression"@en;
        rdfs:subClassOf   eli:Expression;
        owl:versionInfo   "modified in v1.3" , "created in v1.0";
        skos:historyNote  "v1.3 : declared as a subclass of eli:Expression\nv1.2 : replaced reference of RDA with FRBRoo (for more information on FRBRoo, see https://www.ifla.org/node/10171) ."@en .

<https://www.iana.org/assignments/media-types/application/pdf;type=archival>
        rdf:type         eli:FormatType , owl:NamedIndividual;
        owl:versionInfo  "created in v1.2"@en;
        skos:prefLabel   "application/pdf;type=archival";
        skos:scopeNote   "ELI introduces this value to describe PDF files that are intended for long-term archival."@en .

eli:is_member_of  rdf:type      owl:ObjectProperty;
        rdfs:comment            "Indicates that this work is conceptually included in another one. In the case of a legislation, its successive temporal versions are conceptually members of a single « abstract » resource. For the notion of physical inclusion, use eli:is_part_of."@en;
        rdfs:domain             eli:Work;
        rdfs:label              "is member of"@en;
        rdfs:range              eli:Work;
        rdfs:subPropertyOf      frbroo:R10i_is_member_of;
        eli:specificPropertyOf  terms:isPartOf;
        owl:versionInfo         "modified in v1.3" , "created in v1.1"@en;
        skos:historyNote        "v1.3 : broaden the domain and range to Work instead of LegalResource\nv1.2 : replaced reference of RDA with FRBRoo."@en .

eli:commences  rdf:type     owl:ObjectProperty;
        rdfs:comment        "Indicates that this legal resource sets another legal resource into force.\nNote the the date of entry into force of the other resource should be modified accordingly.\nNote also that it is not possible to indicate when the entry into force should happen."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                            ];
        rdfs:label          "commences"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                            ];
        rdfs:subPropertyOf  eli:changes;
        owl:versionInfo     "created in v1.1"@en .

eli:type_document  rdf:type     owl:ObjectProperty;
        rdfs:comment            "The type of a legal resource (e.g. \"Directive\", \"Règlement grand ducal\", \"law\", \"règlement ministériel\", \"draft proposition\", \"Parliamentary act\", etc.). \n\nMember states are encouraged to make their own list of values in the corresponding concept scheme. EU Publications Office provides a list of values for EU resource types at https://op.europa.eu/en/web/eu-vocabularies/at-dataset/-/resource/dataset/resource-type"@en;
        rdfs:domain             eli:LegalResource;
        rdfs:label              "type of document"@en;
        rdfs:range              eli:ResourceType;
        rdfs:seeAlso            eli:ResourceTypeTable;
        rdfs:subPropertyOf      eli:work_type;
        eli:specificPropertyOf  terms:type;
        owl:versionInfo         "modified in v1.4" , "created in v1.0";
        skos:historyNote        "v1.4 : Moved under work_type\nv1.3 : Updated link to EU vocabularies website in the definition."@en .

eli:LegalValue-definitive
        rdf:type          skos:Concept , owl:NamedIndividual , eli:LegalValue;
        owl:versionInfo   "modified in v1.1"@en , "created in v1.0"@en;
        skos:broader      eli:LegalValue-authoritative;
        skos:definition   "Document for which the text is conclusively what the law says. (The digitally signed version of an Official Journal.)"@en;
        skos:example      "The digitally signed version of an Official Journal."@en;
        skos:historyNote  "v1.1 : improved definition"@en;
        skos:inScheme     eli:LegalValueTable;
        skos:prefLabel    "definitive"@en .

eli:Organization  rdf:type  owl:Class;
        rdfs:comment      "Institutions or groups of people that have obtained a legal recognition as a group and can act collectively as agents."@en;
        rdfs:label        "Organization"@en;
        rdfs:subClassOf   frbroo:F11_Corporate_Body , eli:Agent;
        owl:versionInfo   "modified in v1.4" , "created in v1.3";
        skos:historyNote  "v1.4 : set as subclass of F11_Corporate_Body" .

eli:corrects  rdf:type      owl:ObjectProperty;
        rdfs:comment        "Indicates that this work introduces textual modifications (like correction of spelling mistakes) with no legal change in another resource, expression or manifestation; typically corrigenda in EU legislation. For modifications that have a legal impact, use eli:amends."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:Expression eli:Work )
                            ];
        rdfs:label          "corrects"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:Expression eli:Manifestation eli:Work )
                            ];
        rdfs:subPropertyOf  owl:topObjectProperty;
        owl:versionInfo     "modified in v1.4"@en , "created in v1.1"@en;
        skos:historyNote    "v1.4 : broaden to Work or Expression"@en .

eli:number  rdf:type      owl:DatatypeProperty;
        rdfs:comment      "An identifier or other disambiguating feature for a work or expression. This can be the number of a legislation, the number of an article, or the issue number of an official journal."@en;
        rdfs:domain       [ rdf:type     owl:Class;
                            owl:unionOf  ( eli:Expression eli:Work )
                          ];
        rdfs:label        "number"@en;
        rdfs:range        xsd:string;
        owl:versionInfo   "modified in v1.5"@en , "created in v1.1"@en;
        skos:historyNote  "v1.5 : broaden the domain to Work or Expression instead of LegalResource or LegalExpression."@en .

eli:applies  rdf:type           owl:ObjectProperty;
        rdfs:comment            "Indicates that this legislation (or part of a legislation) somehow conforms with another legislation. This is an informative link, and it has no legal value. For legally-binding links of transposition, use the property transposes. This can be used for example : \n  - when a pre-existing law already conforms to a recent european directive (in that case it does not \"transposes\" it strictly speaking);\n  - when non-EU member states make sure their legislation is conformant with EU law without strictly speaking transposing it;\n  - when a legislation from a local authority conforms with a national legislation;\n\nNote that this should point to a LegalResource, not to a language-specific expression."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                                ];
        rdfs:label              "applies"@en;
        rdfs:range              eli:LegalResource;
        rdfs:seeAlso            eli:transposes;
        eli:specificPropertyOf  terms:relation;
        owl:equivalentProperty  eli:implements;
        owl:versionInfo         "created in v1.1"@en .

<http://publications.europa.eu/resource/authority/atu>
        rdf:type  skos:ConceptScheme , owl:NamedIndividual .

frbroo:F11_Corporate_Body
        rdf:type  owl:Class .

eli:title_alternative
        rdf:type                owl:DatatypeProperty;
        rdfs:comment            "An alternative title of the expression (if any).\n\nNote that, if needed, an alternative title can also be stated on a work using the Dublin Core \"alternative\" property."@en;
        rdfs:domain             eli:Expression;
        rdfs:label              "alternative title"@en;
        rdfs:range              rdfs:Literal;
        eli:specificPropertyOf  terms:alternative;
        owl:versionInfo         "modified in v1.3" , "created in v1.0";
        skos:historyNote        "v1.3 : broaden the domain to Expression instead of LegalExpression\nv1.2 : changed range from xsd:string to rdfs:Literal"@en .

eli:description  rdf:type       owl:DatatypeProperty;
        rdfs:comment            "An account of the resource (definition from Dubin Core), e.g a summary."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                                ];
        rdfs:label              "description"@en;
        rdfs:range              rdfs:Literal;
        eli:specificPropertyOf  terms:description;
        owl:versionInfo         "created in v1.0" .

<https://www.iana.org/assignments/media-types/text/html>
        rdf:type         eli:FormatType , owl:NamedIndividual;
        owl:versionInfo  "created in v1.2"@en;
        skos:inScheme    eli:FormatTypeTable;
        skos:prefLabel   "text/html" .

eli:LegalValue-unofficial
        rdf:type           skos:Concept , eli:LegalValue , owl:NamedIndividual;
        owl:versionInfo    "created in v1.0"@en;
        skos:definition    "Document has no particular or special standing."@en;
        skos:inScheme      eli:LegalValueTable;
        skos:prefLabel     "unofficial"@en;
        skos:topConceptOf  eli:LegalValueTable .

eli:based_on  rdf:type          owl:ObjectProperty;
        rdfs:comment            "Inverse of \"basis_for\". Indicates that thiswork is empowered by another one, typically a constitution, a treaty or an enabling act."@en;
        rdfs:domain             eli:Work;
        rdfs:label              "based on"@en;
        rdfs:range              [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:Expression eli:Work )
                                ];
        eli:specificPropertyOf  terms:relation;
        owl:inverseOf           eli:basis_for;
        owl:versionInfo         "created in v1.0" , "modified in v1.4"@en;
        skos:historyNote        "v1.4 : broaden to Work or Expression\nv1.1 : improved definition"@en .

<https://www.iana.org/assignments/media-types/application/xhtml+xml>
        rdf:type         eli:FormatType , owl:NamedIndividual;
        owl:versionInfo  "created in v1.2"@en;
        skos:inScheme    eli:FormatTypeTable;
        skos:prefLabel   "application/xhtml+xml" .

eli:has_translation  rdf:type  owl:ObjectProperty;
        rdfs:comment     "Inverse of \"is_translation_of\". Indicates that this expression has been translated into another derived expression. See the definition of \"is_translation_of\"."@en;
        rdfs:domain      eli:LegalExpression;
        rdfs:label       "has translation"@en;
        rdfs:range       eli:LegalExpression;
        owl:inverseOf    eli:is_translation_of;
        owl:versionInfo  "created in v1.2"@en .

frbroo:R3i_realises  rdf:type  owl:ObjectProperty .

eli:language  rdf:type          owl:ObjectProperty;
        rdfs:comment            "The language of an expression.\n\nEU Publications Office provides a list of languages at https://op.europa.eu/en/web/eu-vocabularies/at-dataset/-/resource/dataset/language. This list is large enough so that member states should not have to declare local values.\n\nNote that, if needed, a language can also be stated on a legal resource using the DublinCore \"language\" property."@en;
        rdfs:domain             eli:Expression;
        rdfs:label              "language"@en;
        rdfs:range              eli:Language;
        rdfs:seeAlso            <http://publications.europa.eu/resource/authority/language>;
        eli:specificPropertyOf  terms:language;
        owl:versionInfo         "created in v1.0" , "modified in v1.3";
        skos:historyNote        "v1.3 : broaden the domain to Expression instead of LegalExpression and updated link to EU vocabularies website"@en .

skos:narrower  rdf:type  owl:AnnotationProperty .

frbroo:R4i_comprises_carriers_of
        rdf:type  owl:ObjectProperty .

frbroo:R4_carriers_provided_by
        rdf:type  owl:ObjectProperty .

eli:cited_by_case_law_reference
        rdf:type                owl:DatatypeProperty;
        rdfs:comment            "Indicates that this LegalResource or LegalExpression is being cited in a case law that cannot be identified by a suitable URI and that is indicated by textual reference. An ECLI (European Case Law Identifier) can be used here.\nWhen the case law can be identified by a suitable URI, the property eli:cited_by_case_law should be used instead."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                                ];
        rdfs:label              "cited by case law reference"@en;
        rdfs:seeAlso            eli:cited_by_case_law;
        eli:specificPropertyOf  terms:relation;
        owl:versionInfo         "created in v1.2"@en .

eli:is_realized_by  rdf:type  owl:ObjectProperty;
        rdfs:comment        "Relates a work to an expression of this work in the form of a \"sequence of signs\" (typically alpha-numeric characters in a legal context). Inverse of \"realizes\"."@en;
        rdfs:domain         eli:Work;
        rdfs:label          "is realized by"@en;
        rdfs:range          eli:Expression;
        rdfs:subPropertyOf  frbroo:R3_is_realised_in;
        owl:inverseOf       eli:realizes;
        owl:versionInfo     "modified in v1.3" , "created in v1.0";
        skos:historyNote    "v1.3 : broaden the domain to Work instead of LegalResource and range to Expression instead of LegalExpression.\nv1.2 : replaced reference of RDA with FRBRoo."@en .

eli:cited_by_case_law
        rdf:type                owl:ObjectProperty;
        rdfs:comment            "Indicates that this LegalResource or LegalExpression is being cited in a case law, identified by a suitable URI. If the case law cannot be identified by a suitable URI, the property \"eli:cited_by_case_law_reference\" can be used with a textual reference to the case law.\n\nThe actual citation link is expressed from the case law to the legislation, but legal portals may use the link from a legislation to a case law to e.g. refer to representative case laws about a legislation."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                                ];
        rdfs:label              "cited by case law"@en;
        rdfs:range              owl:Thing;
        rdfs:seeAlso            eli:cited_by_case_law_reference;
        rdfs:subPropertyOf      eli:is_referred_to_by;
        eli:specificPropertyOf  terms:relation;
        owl:versionInfo         "modified in v1.5"@en , "created in v1.2"@en;
        skos:historyNote        "v1.5 : was made a subproperty of eli:is_referred_to_by"@en .

eli:embodies  rdf:type      owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "Relates a manifestation to the expression that it embodies. Inverse of \"is_embodied_by\"."@en;
        rdfs:domain         eli:Manifestation;
        rdfs:label          "embodies"@en;
        rdfs:range          eli:Expression;
        rdfs:subPropertyOf  frbroo:R4i_comprises_carriers_of;
        owl:inverseOf       eli:is_embodied_by;
        owl:versionInfo     "modified in 1.3" , "created in v1.0";
        skos:historyNote    "v1.3 : broaden the domain to Manifestation instead of Format and the range to Expression instead of LegalExpression.\nIn v1.1, this was declared functional (the constraint was missing in 1.0)"@en , "v1.2 : replaced reference of RDA with FRBRoo."@en .

eli:has_part  rdf:type          owl:ObjectProperty;
        rdfs:comment            "inverse of \"is_part_of\""@en;
        rdfs:domain             eli:Work;
        rdfs:label              "has part"@en;
        rdfs:range              eli:Work;
        eli:specificPropertyOf  terms:hasPart;
        owl:inverseOf           eli:is_part_of;
        owl:versionInfo         "created in v1.0" , "modified in v1.3";
        skos:historyNote        "v1.3 : broaden the domain and range to Work instead of LegalResource"@en .

eli:is_part_of  rdf:type        owl:ObjectProperty;
        rdfs:comment            "Indicates a work in which this one is physically included. Covers the case of text included in an Official Journal, or an article included in a text. For the notion of conceptual/temporal inclusion, use eli:is_member_of."@en;
        rdfs:domain             eli:Work;
        rdfs:label              "is part of"@en;
        rdfs:range              eli:Work;
        eli:originalName        "composed"@en;
        eli:specificPropertyOf  terms:isPartOf;
        owl:versionInfo         "created in v1.0" , "modified in v1.3";
        skos:historyNote        "v1.3 : broaden the domain and range to Work instead of LegalResource\nStarting with v1.1, the notion of conceptual inclusion is expressed with eli:is_member_of instead of eli:is_part_of."@en .

eli:SubdivisionType  rdf:type  owl:Class;
        rdfs:comment         "Formally defined as the set of skos:Concept in concept scheme eli:SubdivisionTypeTable"@en;
        rdfs:label           "Subdivision type"@en;
        rdfs:subClassOf      skos:Concept;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( skos:Concept
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    eli:SubdivisionTypeTable;
                                                       owl:onProperty  skos:inScheme
                                                     ]
                                                   )
                             ];
        owl:versionInfo      "created in v1.3" .

eli:is_referred_to_by
        rdf:type                owl:ObjectProperty;
        rdfs:comment            "Indicates a work or expression that refers to this entity."@en;
        rdfs:domain             owl:Thing;
        rdfs:label              "is referred to by"@en;
        rdfs:range              [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:Expression eli:Work )
                                ];
        eli:specificPropertyOf  terms:relation;
        owl:inverseOf           eli:refers_to;
        owl:versionInfo         "created in v1.5" .

eli:implemented_by  rdf:type    owl:ObjectProperty;
        rdfs:comment            "This property is deprecated. Use \"applied_by\" instead."@en;
        rdfs:label              "implemented by"@en;
        eli:specificPropertyOf  terms:relation;
        owl:deprecated          true;
        owl:versionInfo         "modified in v1.1"@en , "created in v1.0";
        skos:historyNote        "v1.1 : this property was deprecated in favor of the more generic term \"applied_by\" to avoid confusion"@en .

eli:cites  rdf:type             owl:ObjectProperty;
        rdfs:comment            "Citation in the text of the legislation. This may be at the legal resource or legal expression level, as required by the implementation context. This includes verbatim citation and citations in referrals."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                                ];
        rdfs:label              "cites"@en;
        rdfs:range              owl:Thing;
        rdfs:subPropertyOf      eli:refers_to;
        eli:specificPropertyOf  terms:relation;
        owl:versionInfo         "created in v1.0" , "modified in v1.5"@en;
        skos:historyNote        "v1.5 : was made a subproperty of eli:refers_to"@en .

eli:title  rdf:type             owl:DatatypeProperty;
        rdfs:comment            "The title, or name, of an expression. \n\nNote that, if needed, a title can also be stated on a legal resource using the Dublin Core \"title\" property."@en;
        rdfs:domain             eli:Expression;
        rdfs:label              "title"@en;
        rdfs:range              rdfs:Literal;
        rdfs:seeAlso            eli:title_short , eli:title_alternative;
        eli:specificPropertyOf  terms:title;
        owl:versionInfo         "created in v1.0" , "modified in v1.3";
        skos:historyNote        "v1.3 : broaden the domain to Expression instead of LegalExpression\nv1.2 : changed range from xsd:string to rdfs:Literal"@en .

eli:implementation_ensured_by
        rdf:type            owl:ObjectProperty;
        rdfs:comment        "Indicates that the implementation of this LegalResource is ensured by another LegalResource. This implies a legal meaning (contrary to eli:applies). See the definition of eli:ensures_implementation_of."@en;
        rdfs:domain         eli:LegalResource;
        rdfs:label          "implementation ensured by"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                            ];
        rdfs:subPropertyOf  eli:applied_by;
        owl:versionInfo     "created in v1.3" .

eli:WorkType  rdf:type       owl:Class;
        rdfs:label           "Work Type"@en , "Formally defined as the set of skos:Concept in concept scheme eli:WorkTypeTable"@en;
        rdfs:subClassOf      skos:Concept;
        owl:equivalentClass  [ rdf:type        owl:Restriction;
                               owl:hasValue    eli:WorkTypeTable;
                               owl:onProperty  skos:inScheme
                             ];
        owl:versionInfo      "created in v1.4" .

eli:LegalValue-official
        rdf:type           owl:NamedIndividual , eli:LegalValue , skos:Concept;
        owl:versionInfo    "modified in v1.1"@en , "created in v1.0"@en;
        skos:definition    "Document is published by an organisation with the public task of making the information available (A consolidated version of a EU directive published by EU Publications Office.)"@en;
        skos:example       "A consolidated version of a EU directive published by EU Publications Office."@en;
        skos:historyNote   "v1.1 : improved definition"@en;
        skos:inScheme      eli:LegalValueTable;
        skos:narrower      eli:LegalValue-authoritative;
        skos:prefLabel     "official"@en;
        skos:topConceptOf  eli:LegalValueTable .

eli:is_another_publication_of
        rdf:type                owl:ObjectProperty;
        rdfs:comment            "Indicates that this resource is a new publication, in a different official journal, of another resource already published elsewhere, and cannot be considered to be the same resource (owl:sameAs cannot be used to avoid potential duplication of certain metadata, like the date of publication, or the publisher).\n\nNote that this is different from the exceptionnal cases of \"republication\", where the same resource is actually republished in the same official journal a few days after its initial publication, in case of errors."@en;
        rdfs:domain             eli:LegalResource;
        rdfs:label              "is another publication of"@en;
        rdfs:range              eli:LegalResource;
        eli:specificPropertyOf  terms:relation;
        owl:versionInfo         "created in v1.1"@en .

eli:cited_by  rdf:type          owl:ObjectProperty;
        rdfs:comment            "Inverse of \"cites\".\nNote that the intended meaning of this link is to indicate that \"something is cited by a legislation\" and not that \"this legislation is cited by something\"."@en;
        rdfs:domain             owl:Thing;
        rdfs:label              "cited by"@en;
        rdfs:range              [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                                ];
        rdfs:subPropertyOf      eli:is_referred_to_by;
        eli:specificPropertyOf  terms:relation;
        owl:inverseOf           eli:cites;
        owl:versionInfo         "modified in v1.5" , "created in v1.0";
        skos:historyNote        "v1.5 : was made a subproperty of eli:is_referred_to_by\nv1.2 : improved definition"@en .

eli:is_about  rdf:type          owl:ObjectProperty;
        rdfs:comment            "A subject for this work. The use of Eurovoc (http://eurovoc.europa.eu) is encouraged to select values for this property. Member states are encouraged to align local values to Eurovoc."@en;
        rdfs:domain             eli:Work;
        rdfs:label              "is about"@en;
        rdfs:range              skos:Concept;
        eli:specificPropertyOf  terms:subject;
        owl:versionInfo         "modified in v1.4"@en , "created in v1.0";
        skos:historyNote        "v1.4 : broaden domain to Work"@en .

eli:AdministrativeArea
        rdf:type             owl:Class;
        rdfs:comment         "Formally defined as the set of skos:Concept either in concept scheme eli:AdministrativeAreaTable or in concept scheme https://op.europa.eu/en/web/eu-vocabularies/at-dataset/-/resource/dataset/atu (Administrative Territorial Unit table published of the EU Publications Office)."@en;
        rdfs:label           "Administrative Area"@en;
        rdfs:subClassOf      skos:Concept;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( skos:Concept
                                                     [ rdf:type     owl:Class;
                                                       owl:unionOf  ( [ rdf:type        owl:Restriction;
                                                                        owl:hasValue    eli:AdministrativeAreaTable;
                                                                        owl:onProperty  skos:inScheme
                                                                      ]
                                                                      [ rdf:type        owl:Restriction;
                                                                        owl:hasValue    <http://publications.europa.eu/resource/authority/atu>;
                                                                        owl:onProperty  skos:inScheme
                                                                      ]
                                                                    )
                                                     ]
                                                   )
                             ];
        owl:versionInfo      "modified in v1.3"@en , "created in v1.0";
        skos:historyNote     "v1.3 : Updated the link to EU vocabularies website in the definition.\nStarting from v1.1, the values for administrative areas can be taken from the Administrative Territorial Unit table published of the EU Publications Office."@en .

eli:InForce  rdf:type        owl:Class;
        rdfs:comment         "Formally defined as the set of skos:Concept in concept scheme eli:InForceTable"@en;
        rdfs:label           "In force"@en;
        rdfs:subClassOf      skos:Concept;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( skos:Concept
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    eli:InForceTable;
                                                       owl:onProperty  skos:inScheme
                                                     ]
                                                   )
                             ];
        owl:versionInfo      "created in v1.0" .

eli:Person  rdf:type      owl:Class;
        rdfs:comment      "A real person who live or has lived."@en;
        rdfs:label        "Person"@en;
        rdfs:subClassOf   frbroo:F10_Person , eli:Agent;
        owl:versionInfo   "modified in v1.4" , "created in v1.3";
        skos:historyNote  "v1.4 : set as subclass of F10_Person" .

eli:corrected_by  rdf:type  owl:ObjectProperty;
        rdfs:comment        "Inverse of \"corrects\". Indicates a resource that introduces textual modifications (like correction of spelling mistakes) with no legal change in this work, expression or manifestation; typically corrigenda in EU legislation. For modifications that have a legal impact, use eli:amended_by."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:Expression eli:Manifestation eli:Work )
                            ];
        rdfs:label          "corrected by"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:Expression eli:Work )
                            ];
        rdfs:subPropertyOf  owl:topObjectProperty;
        owl:inverseOf       eli:corrects;
        owl:versionInfo     "modified in v1.4"@en , "created in v1.1"@en;
        skos:historyNote    "v1.4 : broaden to Work or Expression"@en .

eli:LegalValueTable  rdf:type  skos:ConceptScheme , owl:NamedIndividual;
        rdfs:label          "Legal value table"@en;
        skos:definition     "A set of values for the legal value of a resource.\nELI ontology includes a set of values for this table."@en;
        skos:hasTopConcept  eli:LegalValue-unofficial , eli:LegalValue-official .

eli:repealed_by  rdf:type   owl:ObjectProperty;
        rdfs:comment        "Inverse of \"repeals\". Indicates that this legal resource or legal expression is being completely canceled, abrogated or replaced by another legal resource. If a resource is partially repealed by another, this link can be used at the corresponding subdivision level being completely repealed."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                            ];
        rdfs:label          "repealed by"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                            ];
        rdfs:subPropertyOf  eli:changed_by;
        owl:inverseOf       eli:repeals;
        owl:versionInfo     "created in v1.1"@en .

<https://www.iana.org/assignments/media-types/application/pdf;type=scanned>
        rdf:type         eli:FormatType , owl:NamedIndividual;
        owl:versionInfo  "created in v1.2"@en;
        skos:prefLabel   "application/pdf;type=scanned";
        skos:scopeNote   "ELI introduces this value to describe PDF files that are scanned copies of a paper version."@en .

eli:Expression  rdf:type  owl:Class;
        rdfs:comment     "The intellectual realisation of a Work in the form of identifiable immaterial objects, such as, but not limited to, text.\n\nThe substance of Expression is signs.\n\nAn Expression cannot exist without a physical carrier but do not depend on a specific physical carrier and can exist on one or more carriers simultaneously."@en;
        rdfs:label       "Expression"@en;
        rdfs:subClassOf  frbroo:F22_Self-Contained_Expression;
        owl:versionInfo  "created in v1.3" .

eli:relevant_for  rdf:type      owl:ObjectProperty;
        rdfs:comment            "Refers to a place or an area associated with the resource. This covers the notions of jurisdiction, sovereignty, applicability or administrative area. The place identifier can be taken from the Administrative Territorial Unit table published of the EU Publications Office at https://op.europa.eu/en/web/eu-vocabularies/at-dataset/-/resource/dataset/atu. Member States don't have to recreate their own list of values.\n\nThe group notes the limitations of what can be said with a single property; member states can refine this notion by declaring specific sub properties."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                                ];
        rdfs:label              "relevant for"@en;
        rdfs:range              eli:AdministrativeArea;
        eli:specificPropertyOf  terms:coverage;
        owl:versionInfo         "modified in v1.3" , "created in v1.0";
        skos:historyNote        "v1.3 : Updated link to EU vocabularies website in the definition.\nStarting from v1.1, the values for this property can be taken from the named authority list published by the Office of Publications instead of defining new values."@en .

vann:preferredNamespacePrefix
        rdf:type  owl:AnnotationProperty .

eli:Manifestation  rdf:type  owl:Class;
        rdfs:comment     "The physical embodiment of an Expression, either on paper or in any electronic format.\n\nThe substance of Manifestation is not only signs, but also the manner in which they are presented to be consumed by users, including the kind of media adopted."@en;
        rdfs:label       "Manifestation"@en;
        rdfs:subClassOf  frbroo:F3_Manifestation_Product_Type;
        owl:versionInfo  "created v1.3" .

frbroo:F3_Manifestation_Product_Type
        rdf:type  owl:Class .

eli:basis_for  rdf:type         owl:ObjectProperty;
        rdfs:comment            "Indicates that this work or expression empowers another . Typically primary legislation is the basis for secondary legislation."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:Expression eli:Work )
                                ];
        rdfs:label              "basis for"@en;
        rdfs:range              eli:Work;
        eli:specificPropertyOf  terms:relation;
        owl:versionInfo         "modified in v1.4"@en , "created in v1.0";
        skos:historyNote        "v1.4 : broaden to Work or Expression\nv1.1 : improved definition"@en .

eli:Language  rdf:type       owl:Class;
        rdfs:comment         "Formally defined as the set of skos:Concept in concept scheme http://publications.europa.eu/resource/authority/language"@en;
        rdfs:label           "Language"@en;
        rdfs:subClassOf      skos:Concept;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( skos:Concept
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    <http://publications.europa.eu/resource/authority/language>;
                                                       owl:onProperty  skos:inScheme
                                                     ]
                                                   )
                             ];
        owl:versionInfo      "modified in v1.2" , "created in v1.0";
        skos:historyNote     "v1.2 : fixed URI in definition"@en .

eli:print_format  rdf:type  eli:FormatType , owl:NamedIndividual;
        owl:versionInfo  "created in v1.2"@en;
        skos:inScheme    eli:FormatTypeTable;
        skos:prefLabel   "print"@en;
        skos:scopeNote   "ELI introduces this value to describe printed/paper versions of the legislation"@en .

eli:in_force  rdf:type    owl:ObjectProperty , owl:FunctionalProperty;
        rdfs:comment      "A value indicating the legal force of a legal resource or a legal expression. A set of values is defined by ELI in the corresponding concept scheme. These values are :\n  - in force\n  - partially in force\n  - not in force"@en;
        rdfs:domain       [ rdf:type     owl:Class;
                            owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                          ];
        rdfs:label        "in force"@en;
        rdfs:range        eli:InForce;
        rdfs:seeAlso      eli:InForce-inForce , eli:InForce-partiallyInForce , eli:InForceTable , eli:InForce-notInForce;
        eli:originalName  "status"@en;
        owl:versionInfo   "created in v1.0" .

eli:is_derivative_of  rdf:type  owl:ObjectProperty;
        rdfs:comment            "A Work or Expression from which this one derives"@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:Expression eli:Work )
                                ];
        rdfs:label              "is derivative of"@en;
        rdfs:range              [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:Expression eli:Work )
                                ];
        eli:specificPropertyOf  terms:relation;
        owl:versionInfo         "created in v1.4"@en .

skos:broader  rdf:type  owl:AnnotationProperty .

eli:amended_by  rdf:type    owl:ObjectProperty;
        rdfs:comment        "Inverse of \"amends\". Indicates a work that introduced legal changes in this resource. For modifications that don’t have a legal impact, use eli:corrected_by."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:Expression eli:Work )
                            ];
        rdfs:label          "amended by"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:Expression eli:Work )
                            ];
        rdfs:subPropertyOf  eli:changed_by;
        owl:inverseOf       eli:amends;
        owl:versionInfo     "created in v1.1"@en , "modified in v1.4"@en;
        skos:historyNote    "v1.4 : broaden to Work or Expression"@en .

eli:VersionTable  rdf:type  skos:ConceptScheme , owl:NamedIndividual;
        rdfs:label       "Version table"@en;
        skos:definition  "A set of values for the version of a legal resource.\nELI does not include a set of values for this table."@en .

eli:countersigned_by  rdf:type  owl:ObjectProperty;
        rdfs:comment     "A person or organization that countersigned the legislation. Depending on the legal context, a countersignature can indicate that the signed authority undertakes to assume responsibility for texts emanating from a person who is inviolable and irresponsible, (for example a King, Grand Duc or President), or that the authority is in charge of the implementation of the text."@en;
        rdfs:domain      eli:LegalResource;
        rdfs:label       "countersigned by"@en;
        rdfs:range       eli:Agent;
        owl:versionInfo  "created in v1.3" .

eli:date_publication  rdf:type  owl:DatatypeProperty , owl:FunctionalProperty;
        rdfs:comment            "Date of publication of the official version of the legislation, in hard copy or online, depending on what the official publication is, and when it was published. Publication dates at the level of legal expressions can be separately asserted, using standard Dublin Core properties."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                                ];
        rdfs:label              "date of publication"@en;
        rdfs:range              xsd:date;
        eli:specificPropertyOf  terms:issued;
        owl:versionInfo         "created in v1.0" , "modified in v1.1"@en;
        skos:historyNote        "In v1.1, the domain was broaden to add LegalExpression."@en .

eli:SubdivisionTypeTable
        rdf:type      skos:ConceptScheme , owl:NamedIndividual;
        rdfs:comment  "A set of types for a legal resource subdivision.\nELI does not include a set of values for this table."@en;
        rdfs:label    "Subdivision type table"@en .

eli:    rdf:type                       owl:Ontology;
        rdfs:comment                   "An ontology to describe legislation, based on the FRBR model, that encodes the ELI metadata fields.\nSee the classes \"LegalResource\", \"LegalExpression\" and \"Format\" as entry points.\nInterested readers can find more information about ELI on the ELI register at http://eurlex.europa.eu/eli and on the Office of Publications vocabularies website at https://op.europa.eu/en/web/eu-vocabularies/eli."@en;
        rdfs:label                     "ELI Metadata Ontology"@en;
        rdfs:seeAlso                   <http://eurlex.europa.eu/eli> , <https://op.europa.eu/en/web/eu-vocabularies/eli> , eli:LegalResource , eli:Work;
        vann:preferredNamespacePrefix  "eli";
        owl:imports                    <http://www.w3.org/2004/02/skos/core>;
        owl:versionInfo                "1.5";
        skos:editorialNote             "- The ELI ontology reuses the property names from the Metalex ontology (http://www.metalex.eu/) to express the FRBR skeleton hierarchy : is_realized_by/realizes, is_embodied_by/embodies, is_exemplified_by. This wording is also the one used in the original FRBR specifications. However, the decision has been made _not_ to align to the Metalex class names (BibliographicWork, BibliographicExpression, BibliographicManifestation), because ELI is specifically about publishing legal metadata on the web, and not structuring legal content in any document.\n\n- first_date_entry_in_force and date_no_longer_in_force could be aligned with dcterms:date\n\n- a class could be introduced for URI schemas to implement the URI schema registry\n\n- ELI does not use rdfs:subPropertyOf to relate its properties with DublinCore Terms, but instead a custom annotation properties \"eli:isSpecificPropertyOf\". ELI 1.1 chose to have 2 separate properties in certain situations to accomodate with cases where the value can be either a String or a reference to an identified object; this is the case for eli:publisher / eli:publisher_agent, or eli:rightsholder and eli:rightsholder_agent. This entails that this pair of properties cannot be both aligned with their respective DCTerms equivalent (dcterms:publisher and dcterms:rightsholder), since relating a property using rdfs:subPropertyOf necessary implies to declare the DCterms property as either a datatype property _or_ an objectProperty, but not both."@en;
        skos:historyNote               "## 1.5\n\n### Semantic changes\n\n- Introduced eli:refers_to / eli:is_referred_to_by on Work or Expression.\n- Made eli:cites / eli:cited_by subproperties of eli:refers_to / eli:is_referred_to_by\n- Made eli:cited_by_case_law a subproperty of eli:is_referred_to_by\n- broaden eli:number on eli:Work or eli:Expression\n\n### Non-semantic changes\n\n_none_\n\n## 1.4\n\n### Semantic changes\n\n- Introduced generic eli:ComplexWork class\n- Introduced generic eli:WorkSubdivision class\n- introducted generic eli:work_type property on eli:Work (and made eli:type_document a subproperty of this)\n- introduced eli:is_derivative_of / eli:has_derivative on Work or Expression\n- introduced eli:has_annex / eli:is_annex_of on Work or Expression\n- broaden eli:date_document on eli:Work\n- broaden eli:is_about on eli:Work\n- broaden eli:changes / changed_by , eli:basis_for / based_on, eli:corrects / corrected_by, eli:amends / amended_by to eli:Work or eli:Expression\n\n### Non-semantic changes\n\n- adjusted the subclassOf relationship of eli:Organization, eli:Agent, eli:Person, eli:Manifestation to proper FRBRoo classes\n\n\n## 1.3\n\n### Semantic changes\n\n  - Introduced High-Level FRBR classes Work, Expression and Manifestation, to be shared in ELI-DL;\n  - Broaden the domain and range of structural FRBR properties to Work, Expression or Manifestation, so that they can be shared in ELI-DL :\n    - eli:is_member_of/eli:has_member\n    - eli:is_part_of/eli:has_part\n    - eli:is_realized_in/eli:realizes\n    - eli:is_embodied_by/eli:embodies\n    - eli:exemplified_by\n  - broaden the domain of eli:title, eli:title_short, eli:title_alternative, eli:language to:eli:Expression so that they can be shared in ELI-DL;\n  - introduced eli:type_subdivision to express the type of a LegalResourceSubdivision\n  - introduced eli:countersigned_by to capture countersignatures of legislation\n  - introduced eli:ensures_implementation_of / eli:implementation_ensured_by to capture the fact that some legislation are modified to remain \"compatible\" with other EU-level or national-level regulations; this implies a legal meaning;\n\n### Non-semantic changes\n\n  - fixed the definition of the modified properties to match their new domain/range\n  - updated the links to MDR to the EU vocabularies website\n  - made eli:Manifestation a subclass of frbroo:F3_Manifestation to follow new LRM conceptual model;\n\n\n## 1.2\n\n### Semantic changes\n\n  - Modification of eli:format and introduction of eli:media_type :\n    - Modified the semantic of eli:format so that it now corresponds to a business / application format, and not a technical format (the technical format will be captured in eli:media_type). This is intended to distinguish e.g. authentic PDF from scanned PDF from generated-on-the-fly PDF; or e.g. XML in a standard (AkomaNtoso) format vs. XML in a proprietary format.\n      - It is now possible to use the custom URIs \"application/pdf;type=signed\", \"application/pdf;type=generated\", \"application/pdf;type=archival\", \"application/pdf;type=scanned\" as values of eli:format to indicate respectively electronically signed PDFs, generated-on-the-fly PDFs, PDF for archival, or scanned PDFs;\n      - It is now possible to use the custom URI \"eli:print_format\" as a value of eli:format to indicate a printed/paper version of the legislation;\n      - It is now possible to use the URI \"application/akn+xml\" as a value of eli:format to indicate an AkomaNtoso format;\n    - Added a new property \"eli:media_type\" to capture the technical file format of the file; this is intended to serve as a basis for content negociation; IANA identifiers MUST be used in eli:media_type;\n\n    - Existing ELI implementations using eli:format with IANA URIs remain valid; the eli:format property remains mandatory. ELI providers are however encouraged to add the \"eli:media_type\" property to their ELI metadata; in some situations the value of both properties might be the same (\"eli:format = application/xml\" and \"eli:media_type = application/xml\"). It is expected that in the future the \"eli:media_type\" property will become mandatory.\n\n  - Added a couple of optional properties \"has_translation\" / \"is_translation_of\" to indicate that a LegalExpression is translated from another one;\n  - Added the property \"cited_by_case_law\" and the corresponding literal property \"cited_by_case_law_reference\" :\n    - Cited_by_case_law : Indicates that this LegalResource or LegalExpression is being cited in a case law, identified by a suitable URI. If the case law cannot be identified by a suitable URI, the property \"eli:cited_by_case_law_reference\" can be used with a textual reference to the case law. The actual citation link is expressed from the case law to the legislation, but legal portals may use the link from a legislation to a case law to e.g. refer to representative case laws about a legislation.\n    - Cited_by_case_law_reference : Indicates that this LegalResource or LegalExpression is being cited in a case law that cannot be identified by a suitable URI and that is indicated by textual reference. An ECLI (European Case Law Identifier) can be used here. When the case law can be identified by a suitable URI, the property eli:cited_by_case_law should be used instead.\n\n### Non-semantic changes\n\n  - Referred to FRBRoo URIs instead of RDA URIs to extend the LegalResource, LegalExpression and Format classes, along with the FRBR backbone properties. This properly connects ELI with FRBRoo;\n  - Added equivalence declarations between ELI and the schema.org legal extension; this is provided as a separate Excel and Turtle file;\n  - Removed xsd:string range declaration on eli:description, title, title_short, title_alternative, rightsholder, rights, publisher, published_in so that can be declared with either a datatype or a language tag;\n  - Fixed documentation of some properties;\n  - Added link to Eur-Lex website in ontology documentation;\n\n## 1.1\n\n  - added the following properties :\n    - is_member_of / has_member\n    - number\n    - jurisdiction\n    - date_applicability\n    - applies / applied_by\n    - commences / commenced_by\n    - repeals / repealed_by\n    - corrects / corrected_by\n    - amends / amended_by\n    - is_another_publication_of / has_another_publication\n\n  - additionnal properties were also added to accomodate with situations where a property value can be either a literal or a URI :\n    - responsibility_of_agent vs. responsibility_of\n    - published_in_format vs. published_in\n    - publisher_agent vs. publisher\n    - rightsholder_agent vs. rightsholder\n\n  - the relations with DublinCore properties is now declared with a custom annotation property \"eli:isSpecificPropertyOf\" instead of rdfs:subPropertyOf to be able to relate both eli:publisher/eli:publisher_agent to dcterms:publisher, and eli:rightsholder/eli:rightsholder_agent to dcterms:rightsholder.\n\n  - added the class LegalResourceSubdivision\n\n  - the propery implements / implemented_by was deprecated in favor of applies / applied_by\n\n  - numerous definitions were improved and clarified\n\n  - all ontology items are documented with :\n    - their version of creation;\n    - their version of latest modification;\n    - an history note documenting the changes on the item;\n\nV1.1 is backward compatible with v1.0, with 1 following exception :\n  - starting from v1.1, is_member_of / has_member should be used instead of is_part_of / has_part for conceptual inclusions;\n\nAdditionnally, ELI implementers are strongly encouraged to use applies / applied_by instead of implements / implemented_by; note however that implements/implemented_by currently remain in the ontology so publishers can take the time to transition smoothly.\n\n## 1.0\n\n  - added a set of values for the InForce table\n  - added definitions to tables\n  - minor fixes in definitions\n  - added rdfs:seeAlso from properties to corresponding tables\n  - cleaned the \"whyThisIsNeeded\" annotation\n\n## 0.6.1\n\n  - fixed typos in definitions\n\n## 0.6\n\n  - imported skos rather than redeclaring skos classes and properties\n  - changed domain of in_force, first_date_entry_into_force, date_no_longer_in_force to [LegalResource or LegalExpression] instead of LegalResource\n  - changed domain of language, title, title_short, title_alternative to LegalExpression instead of [LegalResource or LegalExpression]\n  - reworked the tables : don't use country and resource type tables from MDR, but declare local tables.\n  - integrated new definitions for all classes and properties\n\n## 0.5\n\n  - Renamed \"Interpretation\" into \"LegalExpression\" (and modified comments accordingly)\n  - Renamed the structural FRBR relations in accordance with Metalex ontology :\n    - is_legal_resource_of becomes \"is_realized_by\"\n    - has_legalresource becomes \"realizes\"\n    - is_interpretation_of becomes \"is_embodied_by\"\n    - has_interpretation becomes \"embodies\"\n    - file becomes \"is_exemplified_by\"\n  - file has been made a subproperty of \"has exemplar of manifestation\" instead of \"dc:hasPart\"\n  - relevant_for is no more considered mandatory. Deleted comment that stated \"we are seeking a way to express that relevant_for must have at least one value for LegalResource or one of its LegalInterpretation\".\n\n## 0.4.1\n\n  - Added \"publishes\" property\n  - Enriched the note on \"transposes\" and \"transposed by\" to indicate they must point to / be expressed on LegalResource"@en .

crm:E39_Actor  rdf:type  owl:Class .

skos:hasTopConcept  rdf:type  owl:AnnotationProperty .

eli:implements  rdf:type        owl:ObjectProperty;
        rdfs:comment            "This property is deprecated. Use \"applies\" instead."@en;
        rdfs:label              "implements"@en;
        eli:specificPropertyOf  terms:relation;
        owl:deprecated          true;
        owl:versionInfo         "modified in v1.1"@en , "created in v1.0";
        skos:historyNote        "v1.1 : this property was deprecated in favor of the more generic term \"applies\" to avoid confusion."@en .

<http://publications.europa.eu/resource/authority/language>
        rdf:type         skos:ConceptScheme , owl:NamedIndividual;
        skos:definition  "A set of values for languages.\nELI does not include a set of values for this table."@en .

eli:transposes  rdf:type    owl:ObjectProperty;
        rdfs:comment        "Indicates that this legislation (or part of legislation) fulfills the objectives set by another legislation, by passing appropriate implementation measures. Typically, some legislations of European Union's member states or regions transpose European Directives. This indicates a legally binding link between the 2 legislations, at act or article level, from the original version of a national implementing measure to the legal resource Directive as published in the EU Official Journal. Can be used for transposition tables, once EU Publication Office has introduced ELI support down to the article level.\n\nThe implementation of EU legislation at national level, involving links to EU regulations, decisions, etc. must be captured with eli:ensures_implementation_of.\n\nNote that this should point to the legal resource of the Directive itself, not to one of its language-specific legal expression."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                            ];
        rdfs:label          "transposes"@en;
        rdfs:range          eli:LegalResource;
        rdfs:seeAlso        eli:ensures_implementation_of;
        rdfs:subPropertyOf  eli:applies;
        owl:versionInfo     "created in v1.0";
        skos:historyNote    "v1.1 : this property was made a subproperty of \"applies\", and the definition was improved."@en .

frbroo:F1_Work  rdf:type  owl:Class .

eli:version_date  rdf:type      owl:FunctionalProperty , owl:DatatypeProperty;
        rdfs:comment            "The point-in-time at which the provided description of the legislation is valid."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:LegalExpression eli:LegalResource )
                                ];
        rdfs:label              "version date"@en;
        rdfs:range              xsd:date;
        eli:specificPropertyOf  terms:date;
        owl:versionInfo         "created in v1.0" , "modified in v1.1"@en;
        skos:historyNote        "v1.1 : improved definition"@en .

eli:ResourceTypeTable
        rdf:type         skos:ConceptScheme , owl:NamedIndividual;
        rdfs:label       "Resource type table"@en;
        skos:definition  "A set of types for a legal resource.\nELI does not include a set of values for this table."@en .

eli:is_translation_of
        rdf:type         owl:ObjectProperty;
        rdfs:comment     "Indicates that this expression has been translated from another original expression; this can be used to distinguish original from derived expressions.\n\nNote that asserting this link does not have any implication on the legal value of the original and translated expressions : depending on the context, a translation can be as legally binding as the original version, or can be published for informative purposes only (e.g. a country translating some legal acts in English).\n\nThe expressions linked with this property can be realisations of the same LegalResource, or different LegalResources. Multilingual legislations that do not need to distinguish between original and derived expressions of the same LegalResource (e.g. european legislation) will not use this property."@en;
        rdfs:domain      eli:LegalExpression;
        rdfs:label       "is translation of"@en;
        rdfs:range       eli:LegalExpression;
        owl:versionInfo  "created in v1.2"@en .

<https://www.iana.org/assignments/media-types/application/pdf;type=generated>
        rdf:type         eli:FormatType , owl:NamedIndividual;
        owl:versionInfo  "created in v1.2"@en;
        skos:prefLabel   "application/pdf;type=generated";
        skos:scopeNote   "ELI introduces this value to describe PDF files that are generated on-the-fly from base XML formats."@en .

eli:InForce-notInForce
        rdf:type           skos:Concept , eli:InForce , owl:NamedIndividual;
        owl:versionInfo    "modified in v1.1"@en , "created in v1.0"@en;
        skos:definition    "Indicates that a legal resource is currently not in force."@en;
        skos:historyNote   "v1.1 : improved definition"@en;
        skos:inScheme      eli:InForceTable;
        skos:prefLabel     "not in force"@en;
        skos:topConceptOf  eli:InForceTable .

eli:work_type  rdf:type  owl:ObjectProperty;
        rdfs:comment  "The type of a work, taken from a controlled vocabulary.\n\nMember States need to define their own work type values."@en;
        rdfs:domain   eli:Work;
        rdfs:label    "work type"@en;
        rdfs:range    eli:WorkType .

eli:amends  rdf:type        owl:ObjectProperty;
        rdfs:comment        "Indicates that this work introduces legal changes in another resource. For modifications that don’t have a legal impact, use eli:corrects."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:Expression eli:Work )
                            ];
        rdfs:label          "amends"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( eli:Expression eli:Work )
                            ];
        rdfs:subPropertyOf  eli:changes;
        owl:versionInfo     "modfiied in v1.4"@en , "created in v1.1"@en;
        skos:historyNote    "v1.4 : broaden to Work or Expression"@en .

eli:has_annex  rdf:type         owl:ObjectProperty;
        rdfs:comment            "Indicates an annex to this this work or expression ."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:Expression eli:Work )
                                ];
        rdfs:label              "has annex"@en;
        rdfs:range              [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:Expression eli:Work )
                                ];
        eli:specificPropertyOf  terms:relation;
        owl:inverseOf           eli:is_annex_of;
        skos:historyNote        "created in v1.4"@en .

eli:publisher_agent  rdf:type   owl:ObjectProperty;
        rdfs:comment            "An entity responsible for making the resource available (definition from Dublin Core).\nThis property should be used when the value can be identified by a suitable URI; in the absence of such a URI, the property \"publisher\" should be used with a string value."@en;
        rdfs:domain             [ rdf:type     owl:Class;
                                  owl:unionOf  ( eli:Format eli:LegalExpression )
                                ];
        rdfs:label              "publisher agent"@en;
        rdfs:range              eli:Agent;
        rdfs:seeAlso            eli:publisher;
        eli:specificPropertyOf  terms:publisher;
        owl:versionInfo         "created in v1.1"@en .

eli:type_subdivision  rdf:type  owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment      "The type of a document subdivision (e.g. \"Article\", \"Paragraph\", \"Section\", etc.).\nA subdivision can have only one type.\n\nELI does not specify a list of possible values. Member states are encouraged to make their own list of values in the corresponding concept scheme. EU Publication Office provies a list of values for EU resource types at https://op.europa.eu/en/web/eu-vocabularies/at-dataset/-/resource/dataset/subdivision"@en;
        rdfs:domain       eli:WorkSubdivision;
        rdfs:label        "type of subdivision"@en;
        rdfs:range        eli:SubdivisionType;
        owl:versionInfo   "created in v1.3";
        skos:historyNote  "v1.4 : Broaden range to WorkSubdivision"@en .

eli:InForce-partiallyInForce
        rdf:type           skos:Concept , eli:InForce , owl:NamedIndividual;
        owl:versionInfo    "created in v1.0"@en , "modified in v1.1"@en;
        skos:definition    "Indicates that parts of the legal resource are in force, and parts are not."@en;
        skos:historyNote   "v1.1 : improved definition"@en;
        skos:inScheme      eli:InForceTable;
        skos:prefLabel     "partially in force"@en;
        skos:topConceptOf  eli:InForceTable .
